#!/bin/bash
# ==========================================================
# nginx-pool : Manage users and virtual hosts for ${MASTER}|localhost
# ----------------------------------------------------------
# Usage:
#   nginx-pool add <user> <domain> [--master <cert>] [--extend-cert] [--dedicated]
#   nginx-pool cert <domain> [--master <cert_family>]
#   nginx-pool list [--local] [--backend]
#   nginx-pool certs [<user>]
#   nginx-pool renew
#   nginx-pool ssl-map
#   nginx-pool rev add|remove|show|list|apply  (alias: reverse)
#   nginx-pool reverses [<filter>]             (shortcut for: rev list)
#   nginx-pool lock <user> <domain>
#   nginx-pool unlock <user> <domain>
#   nginx-pool remove <user> [domain]
#   nginx-pool acl <user> [domain]
#   nginx-pool users
#   nginx-pool domains
#   nginx-pool symlinks
#   nginx-pool logs
#   nginx-pool ports [--clear-ports]
#
# Notes:
# - Each virtual host maps to:
#       /home/<user>/www/<domain>/
# - A ".lock" file prevents distribution of that host.
# - Removing the lock file re-enables the VH.
# - Use 'cert' for existing domains, 'add' for new domains
# - Certificates are opt-in with --extend-cert flag
#
# Smart fallback chain in NGINX (in order):
#   (1)  <user>/<domain>.sock     ← main dynamic backend
#   (2)  <user>/<domain>/(public/|current/)?index.php or index.html
#   (3)  /home/nginx/www/localhost.sock (global PHP pool)
#   (4)  /home/nginx/www/localhost/(public/|current/)?index.php|html
#   (5)  /usr/share/nginx/html/index.html (final fallback)
# ==========================================================

set -euo pipefail
export LC_ALL=C
export LANG=C

# USER may not exist in cron
if [ -z "${USER:-}" ]; then
    USER="$(id -un 2>/dev/null || echo root)"
    export USER
fi

# ---------- Sudo context ----------
if [[ -n "${SUDO_USER:-}" ]]; then
    RUN_AS="root (via sudo by $SUDO_USER)"
    IS_SUDO=1
else
    RUN_AS="$USER"
    IS_SUDO=0
fi

# ---------- Pool Domains & Port ----------
PORT=$(awk '/listen/ && /ssl/ {for(i=1;i<=NF;i++) if ($i ~ /^[0-9]+$/) print $i}' /etc/nginx/conf.d/pool.conf)

# Default pool domain
MASTER="localhost"
SHOW_LOCALS=false
SHOW_BACKEND=false
CLEAR_PORTS=false
IS_DEDICATED=false
EXTEND_CERT=false
BARE_CERT=false

# Reverse proxy flags
REVERSE_CERT=""
REVERSE_NO_SSL_VERIFY=0
REVERSE_NOINDEX=1
REVERSE_NO_APPLY=false
REVERSE_WS=1

# Reverse proxy paths
REVERSE_DIR="/var/www/nginx/reverses"
REVERSE_CONF_SRC="/var/www/nginx/conf.d/reverses.conf"
REVERSE_CONF_DST="/etc/nginx/conf.d/reverses.conf"

# ---------- Parse flags ----------
ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --master)
            MASTER="${2:-localhost}"
            shift 2
            ;;
        --local)
            SHOW_LOCALS=true
            shift
            ;;
        --backend)
            SHOW_BACKEND=true
            shift
            ;;
        --clear-ports)
            CLEAR_PORTS=true
            shift
            ;;
        --dedicated)
            IS_DEDICATED=true
            shift
            ;;
        --bare)
            BARE_CERT=true
            shift
            ;;
        --extend-cert)
            EXTEND_CERT=true
            shift
            ;;
        --wildcard)
            IS_WILDCARD=true
            shift
            ;;
        --cert)
            REVERSE_CERT="${2:-}"
            shift 2
            ;;
        --no-ssl-verify)
            REVERSE_NO_SSL_VERIFY=1
            shift
            ;;
        --noindex|--no-index)
            REVERSE_NOINDEX=1
            shift
            ;;
        --index)
            REVERSE_NOINDEX=0
            shift
            ;;
        --no-apply)
            # kept for backward compat — apply now always runs
            shift
            ;;
        --ws)
            REVERSE_WS=1
            shift
            ;;
        --no-ws)
            REVERSE_WS=0
            shift
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done
set -- "${ARGS[@]:-}"

# Regex-safe version (for internal use)
IFS=',' read -r -a MASTER_DOMAINS <<< "$MASTER"
MASTER_REGEX=$(printf '%s\n' "${MASTER_DOMAINS[@]}" | sed 's/\./\\./g' | paste -sd'|' -)

# ---------- Colors ----------
RED='\033[0;31m'
GREEN='\033[0;32m'
GREEN_BOLD='\033[1;32m'
YELLOW_BOLD='\033[1;33m'
BLUE_BOLD='\033[1;34m'
CYAN='\033[0;36m'
GRAY='\033[0;37m'
NC='\033[0m' # No Color / Reset

# ---------- Helpers ----------
usage() {
    local me; me=$(basename "$0")
    echo -e "${YELLOW_BOLD}Usage:${NC}"
    echo -e "  ${GREEN}Domain Management:${NC}"
    echo -e "    $me add <user> <domain> [--master <cert>] [--extend-cert] [--dedicated]"
    echo -e "    $me remove <user> [domain]"
    echo -e "    $me lock <user> <domain>"
    echo -e "    $me unlock <user> <domain>"
    echo -e "    $me list [--local] [--backend]"
    echo
    echo -e "  ${GREEN}SSL Certificate Management:${NC}"
    echo -e "    $me cert <domain> [--master <cert_family>] [--bare]   # Create/extend cert (--bare: no vhost needed)"
    echo -e "    $me certs [<user>]                                    # View certs (all, or scoped to user)"
    echo -e "    $me renew                                             # Renew all certs (cron-safe)"
    echo -e "    $me ssl-map                                           # Rebuild ssl_cert.map"
    echo -e "    $me ssl-anon                                          # Create the anonymous fallback cert (_anon)"
    echo -e "    $me watchdog                                          # Restart nginx if its unit has failed (cron)"
    echo
    echo -e "  ${GREEN}Dynamic DNS:${NC} ${GRAY}(ddclient / Gandi LiveDNS)${NC}"
    echo -e "    $me ddns list                                         # Show configured DDNS hosts"
    echo -e "    $me ddns status                                       # Per-host health (state, IP, last update)"
    echo -e "    $me ddns check                                        # Quiet form for cron; non-zero if stale"
    echo -e "    $me ddns add <domain> [zone]                          # Add a host (apex handled automatically)"
    echo -e "    $me ddns remove <domain> [zone]                       # Remove a host"
    echo
    echo -e "  ${GREEN}Reverse Proxy Management:${NC} ${GRAY}('rev' is a shorthand for 'reverse')${NC}"
    echo -e "    $me reverses [<filter>]                               # List all reverse proxies (quick shortcut)"
    echo -e "    $me rev add <domain> <backend> [opts]                 # Add / update a reverse proxy"
    echo -e "        --cert <name>       override cert (auto-detected otherwise)"
    echo -e "        --no-ssl-verify     skip TLS verification to backend (self-signed)"
    echo -e "        --index             allow indexing (default: noindex)"
    echo -e "        --no-ws             disable WebSocket upgrade headers (default: on)"
    echo -e "        --no-apply          ${GRAY}(add: no-op, kept for compat — apply always runs; remove: skips it)${NC}"
    echo -e "    $me rev show <domain>                                 # Show entry details"
    echo -e "    $me rev remove <domain>                               # Remove a reverse proxy"
    echo -e "    $me rev apply                                         # Rebuild reverses.conf + reload nginx"
    echo
    echo -e "  ${GREEN}System Management:${NC}"
    echo -e "    $me users                                    # Rebuild user.map"
    echo -e "    $me domains                                  # Rebuild domain.map"
    echo -e "    $me symlinks                                 # Update symlinks in /var/www/pool"
    echo -e "    $me logs                                     # Rebuild /etc/logrotate.d/pool-apps"
    echo -e "    $me ports [--clear-ports]                    # Rebuild port maps for Docker backends"
    echo -e "    $me acl <user> [domain]                      # Fix ACL permissions"
    echo
    echo -e "${BLUE_BOLD}Examples:${NC}"
    echo
    echo -e "  ${GRAY}# Manage certificates:${NC}"
    echo -e "  $me cert m.apfelschorlette.fr --master apfelschorlette.fr"
    echo -e "  $me certs                                     ${GRAY}# all certs${NC}"
    echo -e "  $me certs apfelschorlette                     ${GRAY}# certs covering apfelschorlette's domains${NC}"
    echo
    echo -e "  ${GRAY}# New pool vhost with cert:${NC}"
    echo -e "  $me add alice newdomain.com --extend-cert"
    echo -e "  $me add alice newdomain.com --master example.com --extend-cert"
    echo -e "  $me add georges myapp --master pool.glitchr.dev  ${GRAY}# → https://georges.pool.glitchr.dev/myapp/${NC}"
    echo
    echo -e "  ${GRAY}# Reverse proxies:${NC}"
    echo -e "  $me reverses                                   ${GRAY}# list all${NC}"
    echo -e "  $me reverses carl                              ${GRAY}# filter by 'carl'${NC}"
    echo -e "  $me rev add carl.glitchr.dev https://192.168.92.3 --no-ssl-verify --cert carl.glitchr.dev"
    echo -e "  $me rev add nas.glitchr.dev  https://192.168.92.3:5001 --no-ssl-verify"
    echo -e "  $me rev add chat.glitchr.dev http://127.0.0.1:3000        ${GRAY}# ws is on by default${NC}"
    echo -e "  $me rev add legacy.glitchr.dev http://127.0.0.1:8080 --no-ws"
    echo -e "  $me rev apply                                  ${GRAY}# rebuild conf + reload nginx${NC}"
    echo
    echo -e "${BLUE_BOLD}Notes:${NC}"
    echo -e "  ${GRAY}• Use 'cert' for existing domains, 'add' for new ones${NC}"
    echo -e "  ${GRAY}• --extend-cert is opt-in; preserves all existing SANs before adding new domain${NC}"
    echo -e "  ${GRAY}• --master groups domains under one certificate family${NC}"
    echo -e "  ${GRAY}• --dedicated forces a standalone cert even for a *.\$MASTER subdomain${NC}"
    echo -e "  ${GRAY}• reverse entries are stored in $REVERSE_DIR/ (reversed domain names, no extension)${NC}"
    echo -e "  ${GRAY}• reverse apply writes $REVERSE_CONF_DST and reloads nginx${NC}"
    echo -e "  ${GRAY}• app logs (var/log, logs) under every vhost are rotated via /etc/logrotate.d/pool-apps (rebuilt by 'logs')${NC}"
    echo
    exit 1
}

# Reload nginx — but start it instead when the daemon is down.
# systemd's ExecReload is a bare "kill -HUP" on a forking unit, so it exits 0
# whether or not the master accepted the new config, and it does nothing at all
# when the unit is dead. Callers here have already validated the config, so the
# daemon being down is a state to repair, not a reason to give up silently.
nginx_reload_or_start() {
    if systemctl is-active --quiet nginx; then
        echo -e "${YELLOW_BOLD}Reloading nginx…${NC}"
        systemctl reload nginx
        return 0
    fi

    echo -e "${YELLOW_BOLD}[!] nginx is not running — starting it…${NC}"
    if ! nginx -t >/dev/null 2>&1; then
        echo -e "${RED}[✗] Refusing to start: the config does not pass nginx -t:${NC}"
        nginx -t 2>&1 | sed 's/^/      /' || true
        return 1
    fi
    systemctl start nginx
}

# Cron entry point: bring nginx back only when the unit has actually FAILED.
# A plain "systemctl stop" leaves the unit inactive, which is a deliberate
# maintenance state and must not be fought. Silent when nginx is healthy, so
# it can run every couple of minutes without filling syslog.
nginx_watchdog() {
    require_root

    local state
    state=$(systemctl is-failed nginx 2>/dev/null || true)
    [[ "$state" == "failed" ]] || return 0

    echo -e "${YELLOW_BOLD}[!] nginx unit is in 'failed' state — attempting recovery…${NC}"
    if nginx_reload_or_start; then
        echo -e "${GREEN}[✓] nginx recovered by watchdog.${NC}"
    else
        echo -e "${RED}[✗] Watchdog could not recover nginx — manual action required.${NC}"
        return 1
    fi
}

fs_domain() {
    IFS='.' read -ra parts <<< "$1"
    printf "%s\n" "${parts[@]}" | tac | paste -sd'.' -
}

require_root() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}[!] Must be run as root.${NC}"
        exit 1
    fi
}

vhost_path() {
    local user="$1"
    local domain="$2"     # remains www.domain.com
    local fs
    fs=$(fs_domain "$domain")
    echo "/home/$user/www/$fs"
}

vhost_lock_path() {
    local user="$1"
    local domain="$2"
    local fs
    fs=$(fs_domain "$domain")
    echo "/home/$user/www/$fs.lock"
}

confirm() {
    local msg="$1"
    read -rp "$(echo -e ${YELLOW_BOLD}$msg${NC}) [y/N]: " yn
    [[ "$yn" =~ ^[Yy]$ ]]
}

create_user_if_missing() {
    local user="$1"
    if ! id "$user" &>/dev/null; then
        echo -e "${BLUE_BOLD}[+] Creating system user '${CYAN}$user${BLUE_BOLD}'...${NC}"
        useradd -m -s /bin/bash -G www-data "$user"
        echo -e "${GREEN}[✓] Added to group www-data.${NC}"
    else
        if ! id -nG "$user" | grep -qw www-data; then
            usermod -aG www-data "$user"
            echo -e "${GREEN}[✓] Added existing user '${CYAN}$user${GREEN}' to group www-data.${NC}"
        fi
    fi
}

fix_acl() {
    local user="$1"
    local domain="${2:-}"

    # Handle global wildcard
    if [[ "$user" == "*" ]]; then
        echo -e "${BLUE_BOLD}[i] Applying ACL fix for ALL www-data users...${NC}"
        while IFS=: read -r name _; do
            if id -nG "$name" 2>/dev/null | grep -qw www-data; then
                echo -e "${CYAN}→ $name${NC}"
                fix_acl "$name" "${domain:-}"
            fi
        done < <(getent passwd)
        return
    fi

    # Handle per-user wildcard
    if [[ "$domain" == "*" ]]; then
        echo -e "${BLUE_BOLD}[i] Applying ACL fix for all vhosts of ${CYAN}$user${BLUE_BOLD}...${NC}"
        local www="/home/$user/www"
        if [[ -d "$www" ]]; then
            find "$www" -mindepth 1 -maxdepth 1 -type d | while read -r dir; do
                fix_acl "$user" "$(basename "$dir")"
            done
        else
            echo -e "${RED}[!] No www directory for $user${NC}"
        fi
        return
    fi

    local base="/home/$user/www"
    [[ -n "$domain" ]] && base="$base/$domain"

    [[ -d "$base" ]] || { echo -e "${RED}[!] No such vhost path: $base${NC}"; return; }

    echo -e "${BLUE_BOLD}[i] Fixing ACL for ${CYAN}$base${BLUE_BOLD}...${NC}"
    chmod 700 "/home/$user"
    chmod 700 "$base" 2>/dev/null || true
    chown -R "$user:www-data" "/home/$user"
    setfacl -m u:www-data:--x "/home/$user"
    setfacl -R -m u:www-data:rwx "$base"
    setfacl -R -d -m u:www-data:rwx "$base"

    echo -e "${GREEN}[✓] ACL permissions updated for ${CYAN}$user${GREEN}${domain:+/$domain}.${NC}"
}

# Name of the fallback certificate served for any host the pool does not know.
# The leading underscore keeps it out of the way of real lineages (no domain
# can start with one) and marks it as not-a-tenant everywhere it shows up.
ANON_CERT_NAME="_anon"
ANON_CERT_DIR="/etc/letsencrypt/live/$ANON_CERT_NAME"

# Is there a usable certificate under this lineage name?
#
# `update_ssl_map` used to emit "$MASTER" whenever a domain had no certificate
# of its own, without ever checking that $MASTER existed. MASTER defaults to
# "localhost", and `cert_renew` - which runs hourly from cron - calls
# update_ssl_map with no --master flag, so every such domain was mapped to a
# /etc/letsencrypt/live/localhost that has never existed. nginx cannot answer
# a handshake with a missing file, so those names failed to negotiate TLS at
# all. Nothing pointed at them was live, which is the only reason it went
# unnoticed. Every cert_name is now checked before it is written.
cert_lineage_exists() {
    local name="$1"
    [[ -n "$name" ]] || return 1
    [[ -s "/etc/letsencrypt/live/$name/fullchain.pem" ]] &&
    [[ -s "/etc/letsencrypt/live/$name/privkey.pem" ]]
}

# Does this lineage actually carry a name that covers $domain?
#
# Existing is not the same as applicable. The parent-certificate walk used to
# stop at the first lineage it found above a domain and serve it, assuming a
# parent must cover its children - which is only true when the parent cert was
# issued with those SANs. chapaland.com holds a single-name certificate, so
# www.chapaland.com resolved to it and was served a certificate that does not
# mention www at all: a warning for a domain whose own fallback would have been
# fine. The SAN list is the only authority on this, so it is read rather than
# inferred. Wildcards are honoured for one label, as TLS defines them.
cert_covers_domain() {
    local name="$1" domain="$2"
    cert_lineage_exists "$name" || return 1

    local sans
    # Strip whitespace per line with sed, never with a trailing `tr -d`:
    # tr deletes newlines too, which collapses a multi-SAN certificate into a
    # single run-together token that matches nothing. Single-SAN certs still
    # appeared to work, which made the breakage look domain-specific.
    sans=$(openssl x509 -in "/etc/letsencrypt/live/$name/fullchain.pem" \
               -noout -ext subjectAltName 2>/dev/null |
           tr ',' '\n' | sed -n 's/.*DNS://p' | sed 's/[[:space:]]//g')
    [[ -n "$sans" ]] || return 1

    local san
    while IFS= read -r san; do
        [[ -z "$san" ]] && continue
        [[ "$san" == "$domain" ]] && return 0
        # *.example.com matches one label: a.example.com, never a.b.example.com
        if [[ "$san" == '*.'* && "$domain" == *.* ]]; then
            [[ "${domain#*.}" == "${san#\*.}" ]] && return 0
        fi
    done <<< "$sans"

    return 1
}

# Create the anonymous fallback certificate if it is missing.
#
# Self-signed on purpose: this certificate is never meant to validate. Its job
# is to let the handshake complete while telling the client nothing, so that an
# unknown host gets a warning page containing no hostname, no organisation and
# no e-mail address rather than a trusted certificate naming real tenants.
# Subject is CN=invalid (RFC 6761 reserves .invalid and it can never be a real
# name) with no SAN, no O and no OU. 10-year lifetime so it never needs renewal
# and never appears in Certificate Transparency logs.
ensure_anon_cert() {
    require_root

    if cert_lineage_exists "$ANON_CERT_NAME"; then
        return 0
    fi

    echo -e "${BLUE_BOLD}[*] Creating anonymous fallback certificate (${CYAN}$ANON_CERT_NAME${BLUE_BOLD})...${NC}"
    mkdir -p "$ANON_CERT_DIR"

    # -nodes: nginx must read the key unattended at startup.
    if ! openssl req -x509 -newkey rsa:2048 -nodes \
            -keyout "$ANON_CERT_DIR/privkey.pem" \
            -out    "$ANON_CERT_DIR/fullchain.pem" \
            -days 3650 -subj "/CN=invalid" 2>/dev/null; then
        echo -e "${RED}[✗] Could not create the anonymous certificate.${NC}"
        return 1
    fi

    chmod 600 "$ANON_CERT_DIR/privkey.pem"
    chmod 644 "$ANON_CERT_DIR/fullchain.pem"

    # chmod must come before this, never after: /etc/letsencrypt/live carries a
    # default ACL granting www-data read, and chmod on an ACL-bearing file
    # rewrites the mask from the group bits - which is 000 here, masking the
    # www-data entry off again. nginx workers then cannot read the key and every
    # handshake that lands on the fallback fails outright. Re-applying the ACL
    # afterwards restores the mask.
    fix_letsencrypt_permissions

    echo -e "${GREEN}[✓] Anonymous fallback certificate created.${NC}"
}

add_cert_to_ssl_map() {
    require_root

    local domain="$1"
    local cert_name="${2:-$1}"
    local ssl_map_file="/var/www/nginx/ssl_cert.map"
    local nginx_ssl_map="/etc/nginx/ssl_cert.map"

    # Create map file if it doesn't exist
    if [[ ! -f "$ssl_map_file" ]]; then
        {
            echo "# Auto-generated SSL certificate mapping"
            echo "# Maps domain to certificate directory name in /etc/letsencrypt/live/"
            echo "# Format:"
            echo "#   <domain> <cert_directory_name>;"
            echo
        } > "$ssl_map_file"
    fi

    # Check if domain already in map
    if grep -q "^$domain " "$ssl_map_file" 2>/dev/null; then
        echo -e "${YELLOW_BOLD}[i] Domain ${CYAN}$domain${YELLOW_BOLD} already in ssl_cert.map, updating...${NC}"
        sed -i "/^$domain /d" "$ssl_map_file"
    fi

    # Add to map
    printf "%-40s %s;\n" "$domain" "$cert_name" >> "$ssl_map_file"
    echo -e "${GREEN}[✓] Added ${CYAN}$domain${GREEN} → ${CYAN}$cert_name${GREEN} to ssl_cert.map${NC}"

    # Sync to nginx directory
    cp "$ssl_map_file" "$nginx_ssl_map"
}

update_ssl_map() {
    require_root

    local ssl_map_file="/var/www/nginx/ssl_cert.map"
    local nginx_ssl_map="/etc/nginx/ssl_cert.map"
    local tmp_file="${ssl_map_file}.tmp"

    echo -e "${BLUE_BOLD}[*] Rebuilding SSL certificate map...${NC}"

    # The map's `default` in pool.conf points at this, and entries below fall
    # back to it, so it has to exist before the map is written.
    ensure_anon_cert

    # Header
    {
        echo "# Auto-generated SSL certificate mapping"
        echo "# Maps domain to certificate directory name in /etc/letsencrypt/live/"
        echo "# Format:"
        echo "#   <domain> <cert_directory_name>;"
        echo "#"
        echo "# Pool domains use the MASTER certificate ($MASTER)"
        echo "# Dedicated domains have their own certificates"
        echo
    } > "$tmp_file"

    declare -A cert_map=()
    local total=0

    # Scan all www-data users for domains
    while IFS=: read -r user _; do
        if id -nG "$user" 2>/dev/null | grep -qw www-data; then
            local root="/home/$user/www"
            [[ -d "$root" ]] || continue

            for d in "$root"/*; do
                [[ -d "$d" ]] || continue

                local fsname domain
                fsname=$(basename "$d")
                domain=$(fs_domain "$fsname")

                [[ "$domain" =~ \.lock$ ]] && continue
                [[ -n "${cert_map[$domain]:-}" ]] && continue

                # Determine certificate to use
                local cert_name

                # Check if it's a pool domain (subdomain of MASTER)
                if [[ "$domain" =~ \.$MASTER$ ]] && cert_lineage_exists "$MASTER"; then
                    # Pool domain → use MASTER certificate
                    cert_name="$MASTER"
                    echo -e "${CYAN}→ ${domain}${GRAY} (pool)${NC} → ${GREEN}$cert_name${NC}"
                else
                    # Dedicated domain → check if certificate exists.
                    #
                    # Tests the certificate files, not just the directory. A
                    # lineage can outlive its contents: certbot leaves
                    # live/<name>/ in place with fullchain.pem and privkey.pem
                    # still symlinked into archive/<name>/, and if those
                    # archive files go the symlinks are left dangling. The
                    # directory still exists, so a -d test calls the cert
                    # present and maps the domain to it - and every handshake
                    # for that name then fails, because nginx has nothing to
                    # send. georges.glitchr.dev and georges.mx.glitchr.dev were
                    # both in exactly that state.
                    if cert_covers_domain "$domain" "$domain"; then
                        cert_name="$domain"
                        echo -e "${CYAN}→ ${domain}${GRAY} (dedicated)${NC} → ${GREEN}$cert_name${NC}"
                    else
                        # Check for a parent domain certificate, walking up one
                        # label at a time (www.example.com → example.com).
                        #
                        # The walk continues past the first parent rather than
                        # testing only one level: georges.mx.glitchr.dev has no
                        # mx.glitchr.dev lineage, but the glitchr.dev one above
                        # it lists the name in its SANs and is the right
                        # certificate to serve. Stopping at one level sent it to
                        # the anonymous fallback and produced a warning for a
                        # host that has a perfectly good certificate. Stops at
                        # two labels, since a single label is a public suffix.
                        local parent_domain="$domain"
                        while [[ "$parent_domain" == *.*.* ]]; do
                            parent_domain="${parent_domain#*.}"
                            cert_covers_domain "$parent_domain" "$domain" && break
                        done

                        if cert_covers_domain "$parent_domain" "$domain"; then
                            cert_name="$parent_domain"
                            echo -e "${CYAN}→ ${domain}${GRAY} (parent cert)${NC} → ${GREEN}$cert_name${NC}"
                        elif cert_lineage_exists "$MASTER"; then
                            # Fallback to MASTER, but only if it really exists
                            cert_name="$MASTER"
                            echo -e "${YELLOW_BOLD}→ ${domain}${YELLOW_BOLD} (no cert, using fallback)${NC} → ${GREEN}$cert_name${NC}"
                        else
                            # No certificate anywhere for this name. Mapping it
                            # to a lineage that does not exist breaks the
                            # handshake outright; the anonymous cert at least
                            # negotiates, and leaks nothing while doing so.
                            cert_name="$ANON_CERT_NAME"
                            echo -e "${YELLOW_BOLD}→ ${domain}${YELLOW_BOLD} (no cert, anonymous fallback)${NC} → ${GREEN}$cert_name${NC}"
                        fi
                    fi
                fi

                cert_map["$domain"]="$cert_name"
                printf "%-40s %s;\n" "$domain" "$cert_name" >> "$tmp_file"
                total=$((total + 1))
            done
        fi
    done < <(getent passwd)

    # Bare certificates: a name we hold a certificate for that has no vhost.
    #
    # The scan above walks user directories, so a domain deliberately pointed
    # here without being served - a parked name, or one left to the 418 default
    # like chapaland.com - contributes no entry and drops to the anonymous
    # fallback on the next rebuild, silently undoing `nginx-pool cert --bare`
    # within the hour. Any lineage that genuinely covers its own name is
    # therefore re-asserted here. Lineages that do not (certbot's -0001
    # duplicates, or a name whose SANs have moved on) fail the coverage test
    # and are skipped, so this cannot resurrect a stale mapping.
    local live_name
    for live_name in /etc/letsencrypt/live/*; do
        [[ -d "$live_name" ]] || continue
        live_name=$(basename "$live_name")
        [[ "$live_name" == "$ANON_CERT_NAME" ]] && continue
        [[ -n "${cert_map[$live_name]:-}" ]] && continue
        cert_covers_domain "$live_name" "$live_name" || continue

        cert_map["$live_name"]="$live_name"
        printf "%-40s %s;\n" "$live_name" "$live_name" >> "$tmp_file"
        total=$((total + 1))
        echo -e "${CYAN}→ ${live_name}${GRAY} (bare cert, no vhost)${NC} → ${GREEN}$live_name${NC}"
    done

    # Wildcard patterns (add at end)
    echo >> "$tmp_file"
    echo "# Wildcard fallbacks (uncomment if you create wildcard certs)" >> "$tmp_file"
    echo "# ~*\\.${MASTER}\$         $MASTER;" >> "$tmp_file"

    # Atomic update
    if ! cmp -s "$tmp_file" "$ssl_map_file"; then
        mv "$tmp_file" "$ssl_map_file"
        cp "$ssl_map_file" "$nginx_ssl_map"

        echo
        echo -e "${GREEN}[✓] SSL certificate map updated (${total} domains).${NC}"
        echo -e "${YELLOW_BOLD}Testing nginx configuration...${NC}"

        if nginx -t 2>&1 | grep -q "successful"; then
            echo -e "${GREEN}[✓] NGINX configuration valid.${NC}"
            echo -e "${YELLOW_BOLD}Reloading nginx...${NC}"
            nginx_reload_or_start
            echo -e "${GREEN}[✓] NGINX reloaded.${NC}"
        else
            echo -e "${RED}[✗] NGINX configuration test failed!${NC}"
            exit 1
        fi
    else
        rm -f "$tmp_file"
        echo
        echo -e "${CYAN}[i] No changes detected.${NC}"
    fi
}

fix_letsencrypt_permissions() {
    echo -e "${BLUE_BOLD}[*] Setting ACL permissions for NGINX to read certificates...${NC}"

    # Grant www-data read access to Let's Encrypt directories
    setfacl -R -m u:www-data:r-x /etc/letsencrypt/live 2>/dev/null
    setfacl -R -m u:www-data:r-x /etc/letsencrypt/archive 2>/dev/null

    # Set default ACL for future files
    setfacl -R -d -m u:www-data:r-x /etc/letsencrypt/live 2>/dev/null
    setfacl -R -d -m u:www-data:r-x /etc/letsencrypt/archive 2>/dev/null

    echo -e "${GREEN}[✓] ACL permissions set${NC}"
}

# Read the SAN list for an existing certificate.
# Uses openssl (most reliable) → renewal [[webroot_map]] → certbot output, in that order.
# Prints one domain per line. Returns 1 with a message if cert exists but SANs can't be read.
read_cert_sans() {
    local cert_name="$1"
    local live_dir="/etc/letsencrypt/live/$cert_name"

    [[ -d "$live_dir" ]] || return 0   # cert doesn't exist yet — not an error

    local cert_pem="$live_dir/cert.pem"

    # Method 1: openssl directly from the cert file (fastest, version-agnostic)
    if [[ -f "$cert_pem" ]]; then
        local sans
        sans=$(openssl x509 -noout -text -in "$cert_pem" 2>/dev/null \
               | awk '/Subject Alternative Name/{getline; gsub(/DNS:|[[:space:]]/,""); gsub(/,/,"\n"); print}' \
               | grep -v '^$')
        if [[ -n "$sans" ]]; then echo "$sans"; return 0; fi
    fi

    # Method 2: [[webroot_map]] section in renewal config (certbot webroot certs)
    local renewal_conf="/etc/letsencrypt/renewal/${cert_name}.conf"
    if [[ -f "$renewal_conf" ]] && grep -q '^\[\[webroot_map\]\]' "$renewal_conf" 2>/dev/null; then
        local doms
        doms=$(sed -n '/^\[\[webroot_map\]\]/,/^\[/p' "$renewal_conf" \
               | grep ' = ' | sed 's/[[:space:]]*=.*//' | sed 's/^[[:space:]]*//' | grep -v '^$')
        if [[ -n "$doms" ]]; then echo "$doms"; return 0; fi
    fi

    # Method 3: certbot certificates output (handles all authenticators)
    local san_line
    san_line=$(certbot certificates --cert-name "$cert_name" 2>/dev/null \
               | awk '/^[[:space:]]+Domains:/ {
                   sub(/^[[:space:]]+Domains:[[:space:]]*/,""); line=$0
                   while ((getline l) > 0 && l ~ /^[[:space:]]+[a-zA-Z0-9]/) {
                       sub(/^[[:space:]]*/,"",l); line=line" "l
                   }
                   print line; exit
               }')
    if [[ -n "$san_line" ]]; then
        echo "$san_line" | tr ' ' '\n' | grep -v '^$'
        return 0
    fi

    echo -e "${RED}[!] Cannot read SANs for cert '${cert_name}'.${NC}" >&2
    echo -e "${YELLOW_BOLD}    Verify manually: certbot certificates --cert-name $cert_name${NC}" >&2
    return 1
}

manage_cert_for_existing_domain() {
    require_root

    local domain="$1"
    local cert_family="${2:-$1}"

    # Find domain in filesystem (reversed format)
    local fs_domain
    fs_domain=$(fs_domain "$domain")

    # Search for domain in all user directories
    local found_path=""
    local found_user=""

    for user_dir in /home/*; do
        [[ ! -d "$user_dir" ]] && continue
        local user=$(basename "$user_dir")
        [[ "$user" == "nginx" ]] && continue

        local domain_path="$user_dir/www/$fs_domain"
        if [[ -d "$domain_path" ]]; then
            found_path="$domain_path"
            found_user="$user"
            break
        fi
    done

    if [[ -z "$found_path" ]]; then
        # A certificate does not actually require a vhost. A domain can point
        # here deliberately without serving anything - chapaland.com resolves to
        # this host on purpose and answers 418 from the default server - and
        # such a domain still wants its own certificate, otherwise it falls back
        # to _anon and every visitor gets a warning. Refusing outright forced
        # the only documented way forward to be `nginx-pool add`, which creates
        # a vhost and so stops the domain being an unknown host at all.
        #
        # Still gated behind --bare rather than assumed: with no vhost there is
        # nothing to confirm the name was spelled correctly, and a typo here
        # spends a real Let's Encrypt attempt against their rate limit.
        if [[ "$BARE_CERT" != "true" ]]; then
            echo -e "${RED}[!] Domain ${CYAN}$domain${RED} not found in any user directory.${NC}"
            echo -e "${YELLOW_BOLD}[i] Searched for: ${CYAN}*/www/$fs_domain${NC}"
            echo
            echo -e "${YELLOW_BOLD}[i] To serve this domain, create the vhost:${NC}"
            echo -e "    ${CYAN}nginx-pool add <user> $domain --master $cert_family --extend-cert${NC}"
            echo -e "${YELLOW_BOLD}[i] To certificate it without serving anything (parked / 418 teapot):${NC}"
            echo -e "    ${CYAN}nginx-pool cert $domain --bare${NC}"
            return 1
        fi

        echo -e "${YELLOW_BOLD}[i] No vhost for ${CYAN}$domain${YELLOW_BOLD} — issuing a bare certificate.${NC}"
        echo -e "${GRAY}    The domain keeps whatever the default server answers (418), but${NC}"
        echo -e "${GRAY}    presents its own certificate instead of the anonymous fallback.${NC}"
        echo -e "${GRAY}    ACME HTTP-01 still works: the acme-challenge location is matched${NC}"
        echo -e "${GRAY}    ahead of the dispatcher, so it is reachable for unknown hosts.${NC}"
        echo
    else
        echo -e "${GREEN}[✓] Found domain ${CYAN}$domain${GREEN} in ${CYAN}$found_path${NC}"
        echo -e "${GRAY}    Owner: ${CYAN}$found_user${NC}"
        echo
    fi

    # The ssl_cert.map entry is deliberately NOT written here. Both branches
    # below add it themselves, and only once their certificate actually
    # exists. Writing it up front pointed the domain at a lineage that had not
    # been created yet, so a failed issuance left the map naming a missing
    # certificate - which is the one state guaranteed to break the handshake
    # outright rather than fall back to something serviceable.

    # Check if certificate exists
    if [[ ! -d "/etc/letsencrypt/live/$cert_family" ]]; then
        # Certificate doesn't exist - create it
        echo -e "${BLUE_BOLD}[*] Creating new certificate ${CYAN}$cert_family${BLUE_BOLD}...${NC}"
        create_ssl_cert "$domain" "$cert_family"
    else
        # Certificate exists - extend it
        echo -e "${BLUE_BOLD}[*] Extending certificate ${CYAN}$cert_family${BLUE_BOLD} to include ${CYAN}$domain${BLUE_BOLD}...${NC}"
        extend_domain_to_family_cert "$domain" "$cert_family"
    fi

    echo
    echo -e "${GREEN}[✓] Certificate management complete for ${CYAN}$domain${NC}"
    echo -e "${BLUE_BOLD}[*] Next steps:${NC}"
    echo -e "  ${GREEN}1.${NC} Reload NGINX: ${CYAN}nginx -s reload${NC}"
    echo -e "  ${GREEN}2.${NC} Test HTTPS: ${CYAN}https://$domain/${NC}"
}

create_ssl_cert() {
    require_root

    local domain="$1"
    local cert_name="${2:-$1}"
    local webroot="/var/www/letsencrypt"

    mkdir -p "$webroot"
    chown www-data:www-data "$webroot"

    echo -e "${BLUE_BOLD}[*] Creating SSL certificate for ${CYAN}$domain${BLUE_BOLD}...${NC}"
    echo

    # Check if certificate already exists
    if [[ -d "/etc/letsencrypt/live/$cert_name" ]]; then
        echo -e "${YELLOW_BOLD}[i] Certificate ${CYAN}$cert_name${YELLOW_BOLD} already exists.${NC}"
        echo
        certbot certificates --cert-name "$cert_name"
        echo
        read -rp "$(echo -e ${YELLOW_BOLD}Extend this certificate to include $domain?${NC}) [y/N]: " yn
        if [[ "$yn" =~ ^[Yy]$ ]]; then
            local domains=()
            while IFS= read -r _d; do domains+=("$_d"); done < <(read_cert_sans "$cert_name") || return 1
            if [[ ${#domains[@]} -eq 0 && -d "/etc/letsencrypt/live/$cert_name" ]]; then
                echo -e "${RED}[!] Cannot extend — SANs unreadable. Aborting.${NC}"; return 1
            fi

            # Add new domain if not present
            local found=0
            for d in "${domains[@]}"; do
                [[ "$d" == "$domain" ]] && found=1
            done

            if [[ $found -eq 0 ]]; then
                domains+=("$domain")

                certbot certonly \
                    --webroot -w "$webroot" \
                    --expand \
                    --cert-name "$cert_name" \
                    $(printf ' -d %s' "${domains[@]}")

                if [[ $? -eq 0 ]]; then
                    echo -e "${GREEN}[✓] Certificate extended.${NC}"
                    fix_letsencrypt_permissions
                fi
            else
                echo -e "${GREEN}[✓] Domain already in certificate.${NC}"
            fi
        fi
    else
        # Create new certificate
        echo -e "${BLUE_BOLD}[*] Creating new certificate: ${CYAN}$cert_name${NC}"

        # Check if Certbot account already exists
        local has_account=0
        if [[ -d "/etc/letsencrypt/accounts" ]] && [[ -n "$(ls -A /etc/letsencrypt/accounts 2>/dev/null)" ]]; then
            has_account=1
        fi

        # Only prompt when there is a terminal to answer with, and never let
        # the prompt itself be fatal. The script runs under `set -e`, and a
        # `read` at EOF - no TTY, stdin redirected, called from cron or a
        # script - returns non-zero, which aborted the whole run silently at
        # this exact line, after announcing that it was creating the
        # certificate and before certbot was ever invoked. The failure looked
        # like certbot dying, but nothing had run at all.
        local email=""
        if [[ -t 0 ]]; then
            read -rp "Email address for Let's Encrypt (optional): " email || email=""
        else
            echo -e "${GRAY}    (non-interactive: no e-mail prompt)${NC}"
        fi

        # Prepare email flags
        local email_flag=""
        if [[ -n "$email" ]]; then
            email_flag="--email $email --agree-tos"
        elif [[ $has_account -eq 0 ]]; then
            echo -e "${YELLOW_BOLD}[!] No email provided and no existing Certbot account.${NC}"
            echo -e "${YELLOW_BOLD}[!] Using --register-unsafely-without-email${NC}"
            email_flag="--register-unsafely-without-email --agree-tos"
        else
            email_flag="--agree-tos"
        fi

        certbot certonly \
            --webroot -w "$webroot" \
            --cert-name "$cert_name" \
            -d "$domain" \
            $email_flag \
            --non-interactive

        if [[ $? -eq 0 ]]; then
            echo -e "${GREEN}[✓] Certificate created successfully.${NC}"
            fix_letsencrypt_permissions
        else
            echo -e "${RED}[✗] Certificate creation failed.${NC}"
            exit 1
        fi
    fi

    # Add to ssl_cert.map
    add_cert_to_ssl_map "$domain" "$cert_name"

    # Reload nginx
    echo -e "${YELLOW_BOLD}[*] Reloading nginx...${NC}"
    if nginx -t 2>&1 | grep -q "successful"; then
        nginx_reload_or_start
        echo -e "${GREEN}[✓] NGINX reloaded.${NC}"
    else
        echo -e "${RED}[✗] NGINX configuration test failed!${NC}"
    fi
}

detect_cert_family() {
    local domain="$1"

    # Extract base domain (e.g., apfelschorlette.fr from m.apfelschorlette.fr)
    # Handle multi-level domains: beta.m.apfelschorlette.fr → apfelschorlette.fr
    local parts=()
    IFS='.' read -ra parts <<< "$domain"

    # If 3+ parts, base domain is last 2 parts (domain.tld)
    if [[ ${#parts[@]} -ge 2 ]]; then
        local base_domain="${parts[-2]}.${parts[-1]}"

        # Check if a certificate exists for base domain or any subdomain
        if [[ -d "/etc/letsencrypt/live/$base_domain" ]]; then
            echo "$base_domain"
            return 0
        fi

        # Check for www.domain certificate
        if [[ -d "/etc/letsencrypt/live/www.$base_domain" ]]; then
            echo "www.$base_domain"
            return 0
        fi
    fi

    # No family cert found
    echo ""
}

extend_domain_to_family_cert() {
    require_root

    local domain="$1"
    local family_cert="$2"
    local webroot="/var/www/letsencrypt"

    echo -e "${BLUE_BOLD}[*] Extending certificate ${CYAN}$family_cert${BLUE_BOLD} to include ${CYAN}$domain${BLUE_BOLD}...${NC}"

    local domains=()
    while IFS= read -r _d; do domains+=("$_d"); done < <(read_cert_sans "$family_cert") || return 1
    if [[ ${#domains[@]} -eq 0 && -d "/etc/letsencrypt/live/$family_cert" ]]; then
        echo -e "${RED}[!] Cannot extend '${family_cert}' — SANs unreadable. Aborting to avoid overwriting.${NC}"
        return 1
    fi

    # Check if domain already in certificate
    local found=0
    for d in "${domains[@]}"; do
        [[ "$d" == "$domain" ]] && found=1
    done

    if [[ $found -eq 1 ]]; then
        echo -e "${GREEN}[✓] Domain ${CYAN}$domain${GREEN} already in certificate ${CYAN}$family_cert${NC}"
        return 0
    fi

    # Add new domain
    domains+=("$domain")

    echo -e "${CYAN}→ Extending certificate to cover:${NC}"
    for d in "${domains[@]}"; do
        echo -e "  • ${GREEN}$d${NC}"
    done
    echo

    # Extend certificate
    certbot certonly \
        --webroot -w "$webroot" \
        --expand \
        --cert-name "$family_cert" \
        --non-interactive \
        $(printf ' -d %s' "${domains[@]}")

    if [[ $? -eq 0 ]]; then
        echo -e "${GREEN}[✓] Certificate ${CYAN}$family_cert${GREEN} extended to include ${CYAN}$domain${NC}"
        fix_letsencrypt_permissions
        return 0
    else
        echo -e "${RED}[✗] Failed to extend certificate${NC}"
        return 1
    fi
}

list_ssl_certs() {
    require_root

    echo -e "${BLUE_BOLD}[*] SSL Certificate Mapping:${NC}"
    echo -e "----------------------------------------------------------------------------------------------------------------"
    printf "%-40s %-40s %-20s\n" "DOMAIN" "CERTIFICATE" "STATUS"
    echo -e "----------------------------------------------------------------------------------------------------------------"

    if [[ -f "/etc/nginx/ssl_cert.map" ]]; then
        while read -r domain cert rest; do
            [[ -z "$domain" || "$domain" =~ ^# ]] && continue

            cert="${cert%;}"  # Remove trailing semicolon

            # Check certificate status
            if [[ -d "/etc/letsencrypt/live/$cert" ]]; then
                status="${GREEN}EXISTS${NC}"
            else
                status="${RED}MISSING${NC}"
            fi

            printf "%-40s %-40s %-20b\n" "$domain" "$cert" "$status"
        done < "/etc/nginx/ssl_cert.map"
    else
        echo -e "${YELLOW_BOLD}[!] No ssl_cert.map found. Run: $0 ssl-map${NC}"
    fi

    echo -e "----------------------------------------------------------------------------------------------------------------"
    echo
    echo -e "${BLUE_BOLD}[*] Installed Certificates:${NC}"
    echo
    certbot certificates 2>/dev/null | grep -E "Certificate Name:|Domains:|Expiry Date:" | head -30
}

extend_cert() {
    require_root

    local cert_name="$MASTER"
    local webroot="/var/www/letsencrypt"

    mkdir -p "$webroot"
    chown www-data:www-data "$webroot"

    local filters=("$@")
    if [[ ${#filters[@]} -eq 0 ]]; then
        echo -e "${RED}[!] Missing filter (ex: '*.apfelschorlette.fr')${NC}"
        exit 1
    fi

    # ============================================================
    # 1. Load existing SAN list for this certificate
    # ============================================================
    local current_san=()
    while IFS= read -r _d; do current_san+=("$_d"); done < <(read_cert_sans "$cert_name") || exit 1
    if [[ ${#current_san[@]} -eq 0 && -d "/etc/letsencrypt/live/$cert_name" ]]; then
        echo -e "${RED}[!] Cannot extend '${cert_name}' — SANs unreadable. Aborting to avoid overwriting.${NC}"
        exit 1
    fi
    declare -A present=()
    for d in "${current_san[@]}"; do
        present["$d"]=1
    done

    # ============================================================
    # 2. Discover candidate domains from /home/<user>/www/<domain>
    # ============================================================
    echo -e "${BLUE_BOLD}[*] Discovering candidate domains...${NC}"
    declare -A seen=()
    local candidates=()

    while IFS=: read -r user _; do
        if id -nG "$user" 2>/dev/null | grep -qw www-data; then
            local root="/home/$user/www"
            [[ -d "$root" ]] || continue

            for d in "$root"/*; do
                [[ -d "$d" ]] || continue
                local dom
                dom=$(basename "$d")
                dom=$(fs_domain "$dom")

                [[ "$dom" =~ \.lock$ ]] && continue

                if [[ -z "${seen[$dom]:-}" ]]; then
                    seen["$dom"]=1
                    candidates+=("$dom")
                fi
            done
        fi
    done < <(getent passwd)

    echo -e "${CYAN}→ Found ${#candidates[@]} candidate domains.${NC}"
  
    # ============================================================
    # 3. Apply wildcard / literal filters
    #    "*.apfelschorlette.fr" → match any domain ending in ".apfelschorlette.fr"
    # ============================================================
    local selected=()
    local flat_filters=()

    # flatten comma-separated filters
    for f in "${filters[@]}"; do
        IFS=',' read -ra parts <<< "$f"
        for p in "${parts[@]}"; do
            [[ -n "$p" ]] && flat_filters+=("$p")
        done
    done

    for dom in "${candidates[@]}"; do

        local match=0
        for f in "${flat_filters[@]}"; do
            if [[ "$f" == "*" ]]; then
                match=1 && break
            elif [[ "$f" == \*.* ]]; then
                local base="${f#*.}"    # "*.apfelschorlette.fr" → "apfelschorlette.fr"
                [[ "$dom" == *".$base" ]] && match=1 && break
            else
                [[ "$dom" == "$f" ]] && match=1 && break
            fi
        done
        (( match == 1 )) && selected+=("$dom")
    done

    if [[ ${#selected[@]} -eq 0 ]]; then
        echo -e "${RED}[!] No domains matched the filters.${NC}"
        exit 1
    fi

    echo -e "${BLUE_BOLD}[*] Selected domains (after filtering):${NC}"
    for d in "${selected[@]}"; do
        echo -e "  • ${GREEN}$d${NC}"
    done
    echo

    # ============================================================
    # 4. Merge existing SAN + selected → final SAN list
    #    (keep everything that already exists, add new)
    # ============================================================
    declare -A merged=()
    local final_san=()

    # keep existing SANs
    for d in "${current_san[@]}"; do
        if [[ -z "${merged[$d]:-}" ]]; then
            merged["$d"]=1
            final_san+=("$d")
        fi
    done

    # add selected domains (only if not already present)
    local new_domains=()
    for d in "${selected[@]}"; do
        if [[ -z "${merged[$d]:-}" ]]; then
            merged["$d"]=1
            final_san+=("$d")
            new_domains+=("$d")
        fi
    done

    if [[ ${#new_domains[@]} -eq 0 ]]; then
        echo -e "${GREEN}[✓] All matching domains are already present in certificate ${CYAN}$cert_name${GREEN}.${NC}"
        return 0
    fi

    echo -e "${BLUE_BOLD}[*] New domains to be added to ${CYAN}$cert_name${BLUE_BOLD}:${NC}"
    for d in "${new_domains[@]}"; do
        echo -e "  + ${GREEN}$d${NC}"
    done
    echo

    # ============================================================
    # 5. Call certbot with FULL SAN LIST (to avoid removals)
    # ============================================================
    echo -e "${BLUE_BOLD}[*] Calling Certbot (--expand) with merged SAN list...${NC}"

    certbot certonly \
        --webroot -w "$webroot" \
        --expand \
        --cert-name "$cert_name" \
        $(printf ' -d %s' "${final_san[@]}")

    if [[ $? -ne 0 ]]; then
        echo -e "${RED}[✗] Certbot failed.${NC}"
        exit 1
    fi

    echo -e "${GREEN}[✓] Certificate ${CYAN}$cert_name${GREEN} extended successfully.${NC}"
    nginx_reload_or_start
}

show_certs() {
    require_root

    echo -e "${BLUE_BOLD}[*] Listing all certificates managed by Certbot...${NC}"
    echo

    local current_name=""
    local in_block=0

    certbot certificates 2>/dev/null | while IFS= read -r line; do

        # Detect start of a certificate block
        if [[ "$line" =~ ^Certificate\ Name:\ (.*)$ ]]; then
            current_name="${BASH_REMATCH[1]}"
            in_block=1
            echo -e "${CYAN}Certificate Name:${NC}  ${GREEN}$current_name${NC}"
            continue
        fi

        # Parse inside block
        if [[ $in_block -eq 1 ]]; then
            # Domains
            if [[ "$line" =~ ^\ \ Domains:\ (.*)$ ]]; then
                echo -e "${GRAY}Domains:${NC}        ${YELLOW_BOLD}${BASH_REMATCH[1]}${NC}"
            fi

            # Expiry
            if [[ "$line" =~ ^\ \ Expiry\ Date:\ (.*)$ ]]; then
                local expiry="${BASH_REMATCH[1]}"
                echo -e "${GRAY}Expiry Date:${NC}    ${expiry}"

                # Warn about soon-expiring certs
                if [[ "$expiry" =~ "VALID" ]]; then
                    : # OK
                else
                    echo -e "               ${RED}[!] Certificate may be expired${NC}"
                fi
            fi

            # Certificate path
            if [[ "$line" =~ ^\ \ Certificate\ Path:\ (.*)$ ]]; then
                echo -e "${GRAY}Certificate:${NC}    ${BASH_REMATCH[1]}"
            fi

            # Private key path
            if [[ "$line" =~ ^\ \ Private\ Key\ Path:\ (.*)$ ]]; then
                echo -e "${GRAY}Private Key:${NC}    ${BASH_REMATCH[1]}"
                echo -e "------------------------------------------------------------"
                in_block=0
            fi
        fi

    done

    echo
    echo -e "${GREEN}[✓] Done.${NC}"
}

cert_renew() {
    require_root

    echo -e "${BLUE_BOLD}[*] Running certificate renewal with Certbot...${NC}"
    echo

    # Run certbot renew and capture output for analysis (using tee for real-time display)
    local tmpfile=$(mktemp)
    certbot renew --non-interactive 2>&1 | tee "$tmpfile" || true  # Don't fail on exit code
    local output=$(cat "$tmpfile")
    rm -f "$tmpfile"

    # Parse renewal and parse failures
    local renewal_failures=$(echo "$output" | grep -oP '^\d+(?= renew failure)' | head -1)
    local parse_failures=$(echo "$output" | grep -oP '\d+(?= parse failure)' | tail -1)

    # Only fail if there were actual renewal failures
    if [[ -n "$renewal_failures" && "$renewal_failures" -gt 0 ]]; then
        echo
        echo -e "${RED}[✗] Certificate renewal failed!${NC}"
        echo -e "${YELLOW_BOLD}[!] Check logs:${NC} /var/log/letsencrypt/letsencrypt.log"
        exit 1
    fi

    # Show status
    echo
    if echo "$output" | grep -q "No renewals were attempted"; then
        echo -e "${CYAN}[i] No certificates needed renewal (all are up to date)${NC}"
    else
        echo -e "${GREEN}[✓] Certificates renewed successfully${NC}"
    fi

    # Warn about parse failures if present
    if [[ -n "$parse_failures" && "$parse_failures" -gt 0 ]]; then
        echo -e "${YELLOW_BOLD}[!] Found $parse_failures broken renewal config(s) (harmless, can be cleaned up)${NC}"
        echo -e "${GRAY}    To clean: sudo rm -f /etc/letsencrypt/renewal/*-0001.conf /etc/letsencrypt/renewal/*-0002.conf${NC}"
    fi

    # Fix permissions after renewal
    echo
    fix_letsencrypt_permissions

    # Rebuild SSL cert map so any new/changed certs are picked up
    echo
    echo -e "${BLUE_BOLD}[*] Rebuilding SSL certificate map...${NC}"
    update_ssl_map

    # Reload NGINX
    echo
    echo -e "${BLUE_BOLD}[*] Reloading NGINX...${NC}"
    nginx_reload_or_start

    if [[ $? -eq 0 ]]; then
        echo -e "${GREEN}[✓] NGINX reloaded successfully${NC}"
    else
        echo -e "${RED}[✗] Failed to reload NGINX - please check configuration!${NC}"
        exit 1
    fi

    echo
    echo -e "${GREEN_BOLD}[✓] Certificate renewal process completed!${NC}"
    echo
}

add_vhost() {
    require_root
    local user="$1" domain="$2"
    local base site sock
    base=$(vhost_path "$user" "$domain")
    site="$base/public"
    sock="$base.sock"

    create_user_if_missing "$user"
    mkdir -p "$base"
    chown -R "$user:$user" "/home/$user"
    chmod 700 "/home/$user" "/home/$user/www"
    setfacl -m u:www-data:--x "/home/$user"
    setfacl -R -m u:www-data:rwx "/home/$user/www"
    setfacl -R -d -m u:www-data:rwx "/home/$user/www"

    echo
    echo -e "${GREEN}[✓] Virtual host ${CYAN}$domain${GREEN} created for ${CYAN}$user${GREEN}.${NC}"
    echo -e "    ${GRAY}Base path:    ${CYAN}$base${NC}"
    echo -e "    ${GRAY}Public path:  ${CYAN}$site${NC}"
    echo -e "    ${GRAY}Socket path:  ${CYAN}$sock${NC}"
    echo -e "    ${GRAY}Lock file:    ${CYAN}${base}.lock${NC}"

    # Determine SSL certificate strategy
    local cert_to_use=""
    local is_pool_domain=false
    local needs_cert_extension=false

    if [[ "$domain" =~ \.$MASTER$ ]] && [[ "$IS_DEDICATED" == "false" ]]; then
        # Pool domain (subdomain of MASTER and not explicitly dedicated)
        is_pool_domain=true
        cert_to_use="$MASTER"
        echo -e "    ${GRAY}Type:         ${CYAN}Pool domain${NC}"
        echo -e "    ${GRAY}Certificate:  ${CYAN}$cert_to_use${GRAY} (shared)${NC}"
        echo -e "    ${GRAY}Pool URL:     ${BLUE_BOLD}https://$user.$MASTER/$domain/${NC}"
    else
        # Dedicated domain
        echo -e "    ${GRAY}Type:         ${CYAN}Dedicated domain${NC}"

        if [[ "$IS_DEDICATED" == "true" && -n "$MASTER" && "$MASTER" != "localhost" ]]; then
            # Dedicated domain with --master specified → certificate family
            cert_to_use="$MASTER"
            echo -e "    ${GRAY}Certificate:  ${CYAN}$cert_to_use${GRAY} (family via --master)${NC}"
            needs_cert_extension=true
        elif [[ -d "/etc/letsencrypt/live/$domain" ]]; then
            # Certificate exists for this exact domain
            cert_to_use="$domain"
            echo -e "    ${GRAY}Certificate:  ${CYAN}$cert_to_use${GRAY} (existing)${NC}"
        else
            # Try to auto-detect certificate family
            local family_cert
            family_cert=$(detect_cert_family "$domain")

            if [[ -n "$family_cert" ]]; then
                cert_to_use="$family_cert"
                echo -e "    ${GRAY}Certificate:  ${CYAN}$cert_to_use${GRAY} (auto-detected family)${NC}"
                needs_cert_extension=true
            else
                # No certificate yet - create standalone certificate for this domain
                cert_to_use="$domain"
                echo -e "    ${GRAY}Certificate:  ${CYAN}$cert_to_use${GRAY} (will be created)${NC}"
                needs_cert_extension=true
            fi
        fi

        echo -e "    ${GRAY}Direct URL:   ${BLUE_BOLD}https://$domain/${NC}"
    fi

    # Add to SSL map
    add_cert_to_ssl_map "$domain" "$cert_to_use"

    # Create or extend certificate only if --extend-cert flag is set
    if [[ "$EXTEND_CERT" == "true" && "$needs_cert_extension" == "true" ]]; then
        echo

        # Check if certificate exists
        if [[ ! -d "/etc/letsencrypt/live/$cert_to_use" ]]; then
            # Certificate doesn't exist - create it
            echo -e "${BLUE_BOLD}[*] Creating new certificate ${CYAN}$cert_to_use${BLUE_BOLD}...${NC}"
            create_ssl_cert "$domain" "$cert_to_use"
        else
            # Certificate exists - check if domain needs to be added
            echo -e "${BLUE_BOLD}[*] Checking if ${CYAN}$domain${BLUE_BOLD} needs to be added to certificate...${NC}"

            # Check if domain is in certificate
            local san_line
            san_line=$(certbot certificates --cert-name "$cert_to_use" 2>/dev/null \
                      | awk '/^[[:space:]]+Domains:/ {sub(/^[[:space:]]+Domains:[[:space:]]*/, "", $0); print; exit}')

            local domain_in_cert=0
            if [[ -n "$san_line" ]]; then
                for d in $san_line; do
                    [[ "$d" == "$domain" ]] && domain_in_cert=1
                done
            fi

            if [[ $domain_in_cert -eq 0 ]]; then
                # Extend certificate
                extend_domain_to_family_cert "$domain" "$cert_to_use"
            else
                echo -e "${GREEN}[✓] Domain already in certificate${NC}"
            fi
        fi
    fi

    lock_vhost "$user" "$domain" > /dev/null
    fix_acl "$user" "$domain" > /dev/null
    users > /dev/null
    update_symlinks > /dev/null
    update_logrotate > /dev/null

    echo
    echo -e "${BLUE_BOLD}[*] Next Steps:${NC}"

    if $is_pool_domain; then
        # Pool domain instructions
        echo -e "  ${GREEN}1.${NC} Configure DNS to point ${CYAN}$user.$MASTER${NC} to this server"
        echo -e "  ${GREEN}2.${NC} Unlock the vhost: ${CYAN}nginx-pool unlock $user $domain${NC}"
    else
        # Dedicated domain instructions
        echo -e "  ${GREEN}1.${NC} Configure DNS to point ${CYAN}$domain${NC} to this server"

        if [[ ! -d "/etc/letsencrypt/live/$cert_to_use" ]]; then
            echo -e "  ${GREEN}2.${NC} Certificate will be created automatically when you unlock"
        else
            echo -e "  ${GREEN}2.${NC} Using certificate: ${CYAN}$cert_to_use${NC}"
        fi

        echo -e "  ${GREEN}3.${NC} Unlock the vhost: ${CYAN}nginx-pool unlock $user $domain${NC}"
    fi

    echo -e "  ${GREEN}4.${NC} Reload NGINX: ${CYAN}nginx -s reload${NC}"
    echo
}

is_docker_mapped_before() {
    local domain="$1"

    # Match:
    #   domain 12345; #docker
    #   domain 0;     #docker
    #
    # in EITHER the http or https maps.

    if grep -qE "^${domain}[[:space:]]+[0-9]+;[[:space:]]*#docker" /etc/nginx/port_http.map 2>/dev/null; then
        return 0
    fi

    if grep -qE "^${domain}[[:space:]]+[0-9]+;[[:space:]]*#docker" /etc/nginx/port_https.map 2>/dev/null; then
        return 0
    fi

    return 1
}

# ======================================================
#  Docker upstreams (keepalive)
# ======================================================
# Until 2026-09-14 pool.conf reached every container with
# `proxy_pass https://127.0.0.1:$port` — a literal address held in a
# variable. nginx's keepalive connection cache only exists inside a named
# `upstream {}` block and cannot apply to an address like that, so every
# request re-ran a full TLS handshake to the container and each Docker vhost
# was capped at ~450 req/s (measured; a non-Docker static vhost on the same
# pool did 5144). Pointing the variable at an upstream NAME instead restores
# the cache — nginx resolves a variable proxy_pass against the declared
# server groups before it ever consults the resolver — and measured 5902
# req/s on the same request. The long version is in conf.d/pool.conf.template.
#
# These are derived from the FINAL port maps rather than from the docker scan
# on purpose. The scan has branches that write a port with no live container
# (last-known-port preservation) and branches that write one for a native
# vhost; an upstream set built from the scan would be missing entries the
# maps still carry, and pool.conf would then hold a non-zero port with an
# empty upstream name — `proxy_pass https://` — which is a 500. Deriving both
# from one source makes that desync unrepresentable.

# nginx upstream names share a namespace with hostnames, so the pool_ prefix
# and the underscoring guarantee a generated name can never be mistaken for a
# resolvable domain.
upstream_name_for() {
    local domain="$1" proto="$2"
    printf 'pool_%s_%s' "$(printf '%s' "$domain" | tr '.-' '__')" "$proto"
}

write_docker_upstreams() {
    local src_http="$1" src_https="$2"
    local out_conf="$3" out_map_http="$4" out_map_https="$5"

    {
        echo "# Auto-generated by nginx-pool - DO NOT EDIT."
        echo "# One keepalive-enabled upstream per port-mapped vhost."
        echo "# Regenerated atomically with port_http.map / port_https.map."
        echo
    } > "$out_conf"

    local f
    for f in "$out_map_http" "$out_map_https"; do
        {
            echo "# Auto-generated by nginx-pool"
            echo "# Format:"
            echo "#   <domain> <upstream name>;"
            echo
        } > "$f"
    done

    declare -A seen_upstreams=()
    local proto src out dom port name

    for proto in http https; do
        if [[ "$proto" == "http" ]]; then
            src="$src_http";  out="$out_map_http"
        else
            src="$src_https"; out="$out_map_https"
        fi

        while read -r dom port _rest; do
            [[ -z "$dom" || "$dom" =~ ^# ]] && continue
            port="${port%;}"
            # Mirror $has_port in pool.conf exactly: any entry with a non-zero
            # port is routed through the port fallback and therefore needs an
            # upstream, whether or not it carries the #docker marker.
            [[ "$port" =~ ^[0-9]+$ ]] || continue
            (( port > 0 )) || continue

            name=$(upstream_name_for "$dom" "$proto")

            # Two domains can only collide here if they differ solely by . vs -
            # . Refuse rather than emit a config nginx will reject wholesale.
            if [[ -n "${seen_upstreams[$name]:-}" ]]; then
                echo -e "${RED}[✗] Upstream name collision for ${name} (${dom}) - refusing to generate.${NC}"
                return 1
            fi
            seen_upstreams[$name]=1

            {
                echo "upstream ${name} {"
                echo "    server 127.0.0.1:${port};"
                echo "    keepalive ${POOL_UPSTREAM_KEEPALIVE:-64};"
                echo "    keepalive_timeout ${POOL_UPSTREAM_KEEPALIVE_TIMEOUT:-60s};"
                echo "    keepalive_requests ${POOL_UPSTREAM_KEEPALIVE_REQUESTS:-1000};"
                echo "}"
                echo
            } >> "$out_conf"

            printf "%s %s;\n" "$dom" "$name" >> "$out"
        done < "$src"
    done

    return 0
}

update_ports_map() {

    require_root

    local map_http="/etc/nginx/port_http.map"
    local map_https="/etc/nginx/port_https.map"

    # Keepalive upstreams, generated from the two maps above. The .conf lives
    # in a directory that pool.conf globs (`upstreams.d/*.conf`) so a pool that
    # has not run this command yet still starts: a glob with no match is not an
    # error, whereas a missing plain `include` is fatal. The .bak sits beside it
    # deliberately named *.conf.bak so the glob cannot pick it up and declare
    # every upstream twice.
    local ups_dir="/etc/nginx/upstreams.d"
    local ups_conf="${ups_dir}/docker.conf"
    local map_up_http="/etc/nginx/upstream_http.map"
    local map_up_https="/etc/nginx/upstream_https.map"
    mkdir -p "$ups_dir"

    # ======================================================
    #  Serialize runs.
    #  Cron fires 'ports' every 5 min, but a loaded box can stretch a single
    #  run to several minutes (docker ps / docker port block). Two overlapping
    #  runs used to share one fixed .tmp buffer and emit the same domain twice;
    #  nginx rejects that as "conflicting parameter" — silently, because a
    #  reload keeps the previous config, so the pool only dies at the next
    #  start. Skipping a run is harmless: the next one is 5 minutes away.
    # ======================================================
    exec 9>"/run/lock/nginx-pool-ports.lock"
    if ! flock -n 9; then
        echo -e "${YELLOW_BOLD}[i] Another 'ports' run is still in progress — skipping this one.${NC}"
        exec 9>&-
        return 0
    fi

    # Per-run temp files: a concurrent writer can never interleave into ours.
    local tmp_http tmp_https tmp_ups tmp_up_http tmp_up_https
    tmp_http=$(mktemp "${map_http}.XXXXXX")
    tmp_https=$(mktemp "${map_https}.XXXXXX")
    tmp_ups=$(mktemp "${ups_conf}.XXXXXX")
    tmp_up_http=$(mktemp "${map_up_http}.XXXXXX")
    tmp_up_https=$(mktemp "${map_up_https}.XXXXXX")

    echo -e "${BLUE_BOLD}[*] Rebuilding ${CYAN}port_http.map${BLUE_BOLD} and ${CYAN}port_https.map${BLUE_BOLD}…${NC}"
    # Load existing maps to know which domains were already present
    declare -A old_http_ports=()
    declare -A old_https_ports=()

    if [[ -f "$map_http" ]]; then
        while read -r dom port _rest; do
            # skip comments and empty lines
            [[ -z "$dom" || "$dom" =~ ^# ]] && continue
            port="${port%;}"
            old_http_ports["$dom"]="$port"
        done < "$map_http"
    fi

    if [[ -f "$map_https" ]]; then
        while read -r dom port _rest; do
            [[ -z "$dom" || "$dom" =~ ^# ]] && continue
            port="${port%;}"
            old_https_ports["$dom"]="$port"
        done < "$map_https"
    fi
    
    # Headers
    {
        echo "# Auto-generated by nginx-pool"
        echo "# Format:"
        echo "#   <domain> <port>;"
        echo
    } > "$tmp_http"

    {
        echo "# Auto-generated by nginx-pool"
        echo "# Format:"
        echo "#   <domain> <port>;"
        echo
    } > "$tmp_https"

    # Safe associative array
    declare -A seen_domains=()

    extract_port() {
        local ports="$1"
        local proto="$2"
        local cid="${3:-}"
        local port=""
        local port_num="${proto%%/*}"   # 80 or 443

        port=$(echo "$ports" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+:[0-9]+->'"$proto" \
                         | sed -E 's/.*:([0-9]+)->.*/\1/' | head -n1)

        [[ -n "$port" ]] || port=$(echo "$ports" | grep -oE '\[::\]:[0-9]+->'"$proto" \
                         | sed -E 's/.*:([0-9]+)->.*/\1/' | head -n1)

        [[ -n "$port" ]] || port=$(echo "$ports" | grep -oE "$proto"' -> [^,]+' \
                         | sed -E 's/.*:([0-9]+).*/\1/' | head -n1)

        # Fallback: use 'docker port' which is reliable regardless of network mode / format
        if [[ ( -z "$port" || "$port" == "0" ) && -n "$cid" ]]; then
            port=$(docker port "$cid" "$port_num" 2>/dev/null \
                   | grep -oE ':[0-9]+$' | sed 's/://' | head -n1)
        fi

        echo "${port:-0}"
    }

    while IFS=: read -r user _; do

        id -nG "$user" 2>/dev/null | grep -qw www-data || continue
        local root="/home/$user/www"
        [[ -d "$root" ]] || continue
        echo ""
        local header="Processing user: $user"
        local header_visible=$(echo -e "$header" | sed 's/\x1b\[[0-9;]*m//g')
        local line_length=$((${#header_visible} + 2))
        printf "+%s+\n" "$(printf '%0.s-' $(seq 1 $line_length))"
        echo -e "| ${GREEN_BOLD}Processing user:${NC} ${CYAN}$user${NC} |"
        printf "+%s+\n" "$(printf '%0.s-' $(seq 1 $line_length))"

        for dir in "$root"/*; do
            [[ -d "$dir" ]] || continue

            local domain fsname
            fsname=$(basename "$dir")
            domain=$(fs_domain "$fsname")

            [[ "$domain" =~ \.lock$ ]] && continue

            if [[ ${seen_domains[$domain]+_} ]]; then continue; fi
            seen_domains[$domain]=1

            local project="${fsname//./}"
            local proxy="${project}-proxy"

            local cid
            cid=$(docker ps --filter "name=^${proxy}$" --format '{{.ID}}')
            if [[ -z "$cid" ]]; then
                proxy="${project}-app"
                cid=$(docker ps --filter "name=^${proxy}$" --format '{{.ID}}')
            fi
            if [[ -z "$cid" ]]; then
                proxy="${project}"
                cid=$(docker ps --filter "name=^${proxy}$" --format '{{.ID}}')
            fi

            if [[ -z "$cid" ]]; then

                echo -e "| ${YELLOW_BOLD}[!] Missing proxy container for ${CYAN}$domain${YELLOW_BOLD} (app: ${CYAN}${proxy}${YELLOW_BOLD})${NC}"
                if is_docker_mapped_before "$domain"; then
                    if [[ "$CLEAR_PORTS" == true ]]; then
                        echo -e "| ${YELLOW_BOLD}[i] Clearing docker entry for ${domain}${NC}"
                    else
                        local preserved_http="${old_http_ports[$domain]:-0}"
                        local preserved_https="${old_https_ports[$domain]:-0}"
                        echo -e "| ${CYAN}    Preserving last known ports for ${domain}${NC} (docker not running?) HTTP=${GREEN}${preserved_http}${NC}, HTTPS=${GREEN}${preserved_https}${NC}"
                        printf "%s %s; #docker\n" "$domain" "$preserved_http" >> "$tmp_http"
                        printf "%s %s; #docker\n" "$domain" "$preserved_https" >> "$tmp_https"
                    fi
                else

                    echo -e "| ${CYAN}    ${domain}${BLUE_BOLD} runs natively from${NC} ${CYAN}$dir${NC}"

                    # preserve HTTP
                    if [[ -n "${old_http_ports[$domain]+x}" ]]; then
                        printf "%s %s;\n" "$domain" "${old_http_ports[$domain]}" >> "$tmp_http"
                    fi

                    # preserve HTTPS
                    if [[ -n "${old_https_ports[$domain]+x}" ]]; then
                        printf "%s %s;\n" "$domain" "${old_https_ports[$domain]}" >> "$tmp_https"
                    fi
                fi

                continue

            else
    
                local ports
                ports=$(docker ps --filter "id=$cid" --format '{{.Ports}}')

                http_port=$(extract_port "$ports" "80/tcp"  "$cid")
                https_port=$(extract_port "$ports" "443/tcp" "$cid")

                echo -e "| ${GREEN_BOLD}[✓] External port(s) for${NC} ${CYAN}$domain${NC}${GREEN_BOLD} detected:${NC} HTTP=${GREEN}${http_port}${NC}, HTTPS=${GREEN}${https_port}${NC} (in ${CYAN}$dir)${NC}"
                if [[ "$http_port" == "0" && "$https_port" == "0" ]]; then
                    echo -e "| ${YELLOW_BOLD}[!] Both ports are 0 for ${CYAN}$domain${YELLOW_BOLD} — container running but not exposing ports → will return 418${NC}"
                fi
            fi

            # Write docker port entries.
            # - Container running with real port  → write it
            # - Container running, port 0, but last known port > 0 → keep last known (port remapping gap)
            # - Container running, port 0, no prior port → write 0 → nginx extern_invalid=1 → 418 teapot
            #   (prevents silent fallback to system PHP for a docker-managed domain)
            # --clear-ports drops the entry entirely instead.
            emit_port() {
                local detected="$1" map_file="$2" old_port="$3"
                if [[ "$detected" =~ ^[0-9]+$ && "$detected" -gt 0 ]]; then
                    printf "%s %s; #docker\n" "$domain" "$detected" >> "$map_file"
                elif [[ "$CLEAR_PORTS" == true ]]; then
                    : # drop the entry
                elif [[ -n "$old_port" && "$old_port" -gt 0 ]]; then
                    echo -e "| ${CYAN}    Port not exposed for ${domain}${NC} — keeping last known port ${GREEN}${old_port}${NC}"
                    printf "%s %s; #docker\n" "$domain" "$old_port" >> "$map_file"
                else
                    echo -e "| ${YELLOW_BOLD}[!] Port not exposed for ${domain}${NC} — writing 0 → nginx will return 418"
                    printf "%s 0; #docker\n" "$domain" >> "$map_file"
                fi
            }
            emit_port "$http_port"  "$tmp_http"  "${old_http_ports[$domain]:-}"
            emit_port "$https_port" "$tmp_https" "${old_https_ports[$domain]:-}"

        done

        printf "+%s+\n" "$(printf '%0.s-' $(seq 1 $line_length))"

    done < <(getent passwd)

    # ======================================================
    #  Always write maps; only reload nginx when they changed
    #  (cron-safe: runs every few minutes without churning nginx)
    # ======================================================
    # A duplicate key makes nginx reject the whole config, so never install one.
    local dupes f
    for f in "$tmp_http" "$tmp_https"; do
        dupes=$(awk '!/^#/ && NF {print $1}' "$f" | sort | uniq -d)
        if [[ -n "$dupes" ]]; then
            echo -e "${RED}[✗] Refusing to install ${f%.*}: duplicate domain(s):${NC}"
            echo "$dupes" | sed 's/^/      /'
            rm -f "$tmp_http" "$tmp_https" "$tmp_ups" "$tmp_up_http" "$tmp_up_https"
            exec 9>&-
            return 1
        fi
    done

    # Derived from the maps just validated above, so the two can never disagree.
    if ! write_docker_upstreams "$tmp_http" "$tmp_https" \
                                "$tmp_ups" "$tmp_up_http" "$tmp_up_https"; then
        rm -f "$tmp_http" "$tmp_https" "$tmp_ups" "$tmp_up_http" "$tmp_up_https"
        exec 9>&-
        return 1
    fi

    local maps_changed=0
    cmp -s "$tmp_http"     "$map_http"     || maps_changed=1
    cmp -s "$tmp_https"    "$map_https"    || maps_changed=1
    cmp -s "$tmp_ups"      "$ups_conf"     || maps_changed=1
    cmp -s "$tmp_up_http"  "$map_up_http"  || maps_changed=1
    cmp -s "$tmp_up_https" "$map_up_https" || maps_changed=1

    echo ""
    if [[ "$maps_changed" == 0 ]]; then
        rm -f "$tmp_http" "$tmp_https" "$tmp_ups" "$tmp_up_http" "$tmp_up_https"
        echo -e "${GREEN}[✓] Maps unchanged — skipping nginx reload.${NC}"
        exec 9>&-
        return 0
    fi

    # Keep the outgoing maps so a bad generation can be rolled back.
    cp -a "$map_http"      "${map_http}.bak"      2>/dev/null || true
    cp -a "$map_https"     "${map_https}.bak"     2>/dev/null || true
    cp -a "$ups_conf"      "${ups_conf}.bak"      2>/dev/null || true
    cp -a "$map_up_http"   "${map_up_http}.bak"   2>/dev/null || true
    cp -a "$map_up_https"  "${map_up_https}.bak"  2>/dev/null || true

    chmod 644 "$tmp_http" "$tmp_https" "$tmp_ups" "$tmp_up_http" "$tmp_up_https"
    mv "$tmp_http"     "$map_http"
    mv "$tmp_https"    "$map_https"
    mv "$tmp_ups"      "$ups_conf"
    mv "$tmp_up_http"  "$map_up_http"
    mv "$tmp_up_https" "$map_up_https"

    # Validate before touching the daemon: a reload on a forking unit exits 0
    # even when the master refuses the new config, so an untested map would
    # look successful here and only surface as an [emerg] at the next start.
    if ! nginx -t >/dev/null 2>&1; then
        echo -e "${RED}[✗] Generated maps break the nginx config — rolling back:${NC}"
        nginx -t 2>&1 | sed 's/^/      /' || true
        cp -a "${map_http}.bak"     "$map_http"     2>/dev/null || true
        cp -a "${map_https}.bak"    "$map_https"    2>/dev/null || true
        cp -a "${ups_conf}.bak"     "$ups_conf"     2>/dev/null || true
        cp -a "${map_up_http}.bak"  "$map_up_http"  2>/dev/null || true
        cp -a "${map_up_https}.bak" "$map_up_https" 2>/dev/null || true
        exec 9>&-
        return 1
    fi

    echo -e "${GREEN}[✓] Maps updated.${NC}"
    nginx_reload_or_start
    exec 9>&-
}

users() {

    require_root

    local map_file="/etc/nginx/user.map"
    local tmp_file="${map_file}.tmp"

    echo -e "${BLUE_BOLD}[*] Rebuilding NGINX user → domain map...${NC}"

    # Header
    {
        echo "# Auto-generated by nginx-pool update-user-map"
        echo "# Format: domain   user;"
        echo
    } > "$tmp_file"

    local total_entries=0
    declare -A seen_domains=()

    # Scan only www-data users
    while IFS=: read -r name _; do

        if id -nG "$name" 2>/dev/null | grep -qw www-data; then

            local root="/home/$name/www"
            [[ -d "$root" ]] || continue

            for d in "$root"/*; do
                [[ -d "$d" ]] || continue

                local domain fsname
                fsname=$(basename "$d")
                domain=$(fs_domain "$fsname")
                
                # skip lock
                [[ "$domain" =~ \.lock$ ]] && continue

                # dedupe
                if [[ -n "${seen_domains[$domain]:-}" ]]; then
                    echo -e "${YELLOW_BOLD}[!] Duplicate domain skipped:${NC} ${CYAN}$domain${NC}"
                    continue
                fi
                seen_domains[$domain]="$name"

                printf "%s\t%s;\n" "$domain" "$name" >> "$tmp_file"
                echo -e "${CYAN}→ ${GREEN}$domain${NC} mapped to ${BLUE_BOLD}$name${NC}"

                total_entries=$((total_entries + 1))
            done
        fi

    done < <(getent passwd)

    # ---------------------------------------------------------
    #  ONLY RELOAD NGINX IF FILE CONTENT CHANGED
    # ---------------------------------------------------------

    if ! cmp -s "$tmp_file" "$map_file"; then
        # different → update file atomically + reload nginx
        mv "$tmp_file" "$map_file"

        echo
        echo -e "${GREEN}[✓] Updated: ${CYAN}$map_file${NC} (${total_entries} entries)."
        echo -e "${YELLOW_BOLD}Reloading nginx…${NC}"
        nginx_reload_or_start
    else
        # same → no update needed
        rm -f "$tmp_file"

        echo
        echo -e "${CYAN}[i] No changes detected - ${map_file} unchanged.${NC}"
        echo -e "${CYAN}[i] NGINX not reloaded.${NC}"
    fi
}

nginx_port_from_map() {
    local map="$1"
    local domain="$2"
    awk -v d="$domain" '
        $1 == d {
            gsub(/;/, "", $2);
            print $2;
            exit
        }
    ' "$map" 2>/dev/null
}

extern_backend_ports() {
    local domain="$1"
    local http_port https_port

    http_port=$(nginx_port_from_map "/etc/nginx/port_http.map" "$domain")
    https_port=$(nginx_port_from_map "/etc/nginx/port_https.map" "$domain")

    # ensure numeric
    [[ "$http_port" =~ ^[0-9]+$ ]] || http_port=0
    [[ "$https_port" =~ ^[0-9]+$ ]] || https_port=0

    echo "${http_port}:${https_port}"
}
is_extern_backend() {
    local domain="$1"
    local http_port https_port

    http_port=$(nginx_port_from_map "/etc/nginx/port_http.map" "$domain")
    https_port=$(nginx_port_from_map "/etc/nginx/port_https.map" "$domain")

    # Either port being non-zero means EXTERN
    if [[ "$http_port" =~ ^[0-9]+$ && "$http_port" -ne 0 ]]; then
        return 0
    fi
    if [[ "$https_port" =~ ^[0-9]+$ && "$https_port" -ne 0 ]]; then
        return 0
    fi

    return 1
}

detect_backend_type() {
    local user="$1"
    local domain="$2"
    local root="/home/$user/www/$domain"

    # 1) SOCK backend
    if [[ -S "${root}.sock" ]]; then
        echo "SOCK"
        return
    fi

    # 2) EXTERN backend → return formatted HTTP:xxx/yyy
    if is_extern_backend "$domain"; then
        local ports
        ports=$(extern_backend_ports "$domain")
        echo "MAP:${ports}"
        return
    fi

    # 3) LEGACY backend
    if [[ -f /etc/nginx/legacy.map ]] && grep -q "^${domain} " /etc/nginx/legacy.map; then
        echo "LEGACY"
        return
    fi

    # 4) Standard static / PHP
    if [[ -f "$root/public/index.php" || -f "$root/public/index.html" \
       || -f "$root/index.php"       || -f "$root/index.html" ]]; then
        echo "STANDARD"
        return
    fi

    # 5) Default nginx fallback
    echo "NGINX"
}

update_symlinks() {

    require_root

    local symlink_root="/var/www/pool"
    mkdir -p "$symlink_root"

    echo -e "${BLUE_BOLD}[*] Updating symlinks under ${CYAN}$symlink_root${BLUE_BOLD}...${NC}"

    declare -A valid_domains=()
    local total=0

    # -------- Scan all www-data users --------
    while IFS=: read -r name _; do
        if id -nG "$name" 2>/dev/null | grep -qw www-data; then
            
            local root="/home/$name/www"
            [[ -d "$root" ]] || continue

            for d in "$root"/*; do
                [[ -d "$d" ]] || continue

                local domain fsname
                fsname=$(basename "$d")
                domain=$(fs_domain "$fsname")

                [[ "$domain" =~ \.lock$ ]] && continue

                valid_domains["$domain"]="$d"
                local link="$symlink_root/$fsname"

                # Stale symlink
                if [[ -L "$link" && ! -e "$link" ]]; then
                    echo -e "${GRAY}[i] Removing stale symlink: $link${NC}"
                    rm -f "$link"
                fi

                # Create if missing
                if [[ ! -L "$link" ]]; then
                    ln -s "$d" "$link"
                    echo -e "${GREEN}[+] Created symlink${NC} ${CYAN}$link → $d${NC}"
                else
                    # Fix incorrect target
                    local actual
                    actual=$(readlink -f "$link")
                    if [[ "$actual" != "$d" ]]; then
                        echo -e "${YELLOW_BOLD}[i] Fixing symlink: ${CYAN}$link${NC}"
                        rm -f "$link"
                        ln -s "$d" "$link"
                    fi
                fi

                total=$((total + 1))
            done
        fi
    done < <(getent passwd)

    # -------- Remove orphans --------
    for s in "$symlink_root"/*; do
        [[ -L "$s" ]] || continue
        local domain fsname
        fsname=$(basename "$s")
        domain=$(fs_domain "$fsname")

        if [[ -z "${valid_domains[$domain]:-}" ]]; then
            echo -e "${YELLOW_BOLD}[i] Removing orphan symlink: $s${NC}"
            rm -f "$s"
        fi
    done

    echo
    echo -e "${GREEN}[✓] Symlink update complete.${NC}"
    echo -e "    ${CYAN}$total${NC} active symlinks."
}

update_logrotate() {

    require_root

    local conf_file="/etc/logrotate.d/pool-apps"
    local tmp_file="${conf_file}.tmp"

    echo -e "${BLUE_BOLD}[*] Rebuilding pool app-log rotation...${NC}"

    # Bucket patterns by the ACTUAL owner:group of their parent directory,
    # not by pool username. Docker-managed vhosts are frequently owned by
    # www-data or even root although they live under a pool user's home
    # (the container's own internal process owns the bind-mounted files,
    # not the host account) — a single per-pool-user 'su' value is wrong
    # for those and logrotate refuses to touch them ("insecure permissions").
    declare -A bucket=()

    add_pattern() {
        local dir="$1"
        [[ -d "$dir" ]] || return 0
        local owner group
        owner=$(stat -c '%U' "$dir") || return 0
        group=$(stat -c '%G' "$dir") || return 0
        bucket["$owner:$group"]+="$dir/*.log"$'\n'
    }

    while IFS=: read -r name _; do
        if id -nG "$name" 2>/dev/null | grep -qw www-data; then

            local root="/home/$name/www"
            [[ -d "$root" ]] || continue

            # Convention: <domain>/var/log/*.log — domain dirs are never symlinks
            # (only /var/www/pool/* mirrors them, not /home/*/www/* itself).
            for d in "$root"/*; do
                [[ -d "$d" ]] || continue
                add_pattern "$d/var/log"
            done

            # One level nested: <domain>/<subdir>/{var/log,logs}/*.log — real
            # subdirectories only. Some vhosts alias a subdirectory via a
            # symlink (e.g. dev.glitchr.mail/current -> 1.6.0); a '*' glob
            # follows it as a second, identical match in the same run, which
            # double-rotates the same physical file and clobbers the
            # just-rotated backup with an empty one. 'find' (no -L) reports
            # symlinks as type 'l', never 'd', so only the real directory is
            # ever matched. '! -name .*' skips dirs like .git the same way
            # the domain-level glob above skips dotfiles/.bak snapshots.
            while IFS= read -r sub; do
                add_pattern "$sub/var/log"
                add_pattern "$sub/logs"
            done < <(find "$root" -mindepth 2 -maxdepth 2 -type d ! -name '.*' 2>/dev/null)
        fi
    done < <(getent passwd)

    {
        echo "# Auto-generated by nginx-pool logs — do not edit manually"
        echo "#"
        echo "# One stanza per (owner, group) actually observed on a log directory"
        echo "# under /home/<pool-user>/www/*, covering the conventions in use:"
        echo "#   - Symfony-style:      <domain>/var/log/*.log"
        echo "#   - one level nested:   <domain>/<subdir>/var/log/*.log"
        echo "#   - app-native \"logs\":   <domain>/<subdir>/logs/*.log"
        echo "#"
        echo "# Grouped by real ownership rather than by pool username: logrotate"
        echo "# needs an explicit 'su' to touch files under a group-writable"
        echo "# directory (the pool's own ACL model), and ownership isn't uniform"
        echo "# per pool user — Docker-managed vhosts are commonly owned by"
        echo "# www-data or root even though they live under a pool user's home."
    } > "$tmp_file"

    local total=0

    for key in $(printf '%s\n' "${!bucket[@]}" | sort); do
        local owner="${key%%:*}" group="${key##*:}"

        {
            echo
            printf '%s' "${bucket[$key]}" | sort
            echo "{"
            echo "    daily"
            echo "    missingok"
            echo "    rotate 14"
            echo "    compress"
            echo "    delaycompress"
            echo "    notifempty"
            echo "    maxsize 100M"
            echo "    su $owner $group"
            echo "    create"
            echo "    sharedscripts"
            echo "}"
        } >> "$tmp_file"

        total=$((total + 1))
    done

    if ! cmp -s "$tmp_file" "$conf_file"; then
        mv "$tmp_file" "$conf_file"
        chown root:root "$conf_file"
        chmod 644 "$conf_file"

        echo -e "${GREEN}[✓] Updated: ${CYAN}$conf_file${NC} (${total} ownership groups)."
    else
        rm -f "$tmp_file"
        echo -e "${CYAN}[i] No changes detected - ${conf_file} unchanged.${NC}"
    fi
}

update_domains() {

    require_root

    local map_file="/etc/nginx/domain.map"
    local tmp_file="${map_file}.tmp"

    echo -e "${BLUE_BOLD}[*] Updating domain canonicalization map...${NC}"

    {
        echo "# Auto-generated by nginx-pool"
        echo "# Canonical domain aliases"
        echo "# Format:"
        echo "#   <domain> <canonical>;"
        echo
    } > "$tmp_file"

    declare -A valid_aliases=()
    local total=0

    # -------- Scan all www-data users --------
    while IFS=: read -r name _; do
        if id -nG "$name" 2>/dev/null | grep -qw www-data; then

            local root="/home/$name/www"
            [[ -d "$root" ]] || continue

            for d in "$root"/*; do
                [[ -d "$d" ]] || continue

                local fsname canonical
                fsname="$(basename "$d")"
                canonical="$(fs_domain "$fsname")"

                [[ "$canonical" =~ \.lock$ ]] && continue

                # --------------------------------------------------
                # Reverse ANY domain path: a.b.c → c.b.a
                # --------------------------------------------------
                IFS='.' read -ra parts <<< "$canonical"
                local alias
                alias="$(printf "%s\n" "${parts[@]}" | tac | paste -sd'.' -)"

                # Deduplicate aliases
                [[ -n "${valid_aliases[$alias]:-}" ]] && continue
                valid_aliases["$alias"]="$canonical"

                printf "%-40s %s;\n" "$canonical" "$alias" >> "$tmp_file"
                echo -e "${CYAN}→ ${alias}${NC} → ${GREEN}${canonical}${NC}"

                total=$((total + 1))
            done
        fi
    done < <(getent passwd)

    # -------- Atomic update + conditional reload --------
    if ! cmp -s "$tmp_file" "$map_file"; then
        mv "$tmp_file" "$map_file"
        echo
        echo -e "${GREEN}[✓] Updated ${CYAN}$map_file${GREEN} (${total} aliases).${NC}"
        echo -e "${YELLOW_BOLD}Reloading nginx…${NC}"
        nginx_reload_or_start
    else
        rm -f "$tmp_file"
        echo
        echo -e "${CYAN}[i] No changes detected - nginx not reloaded.${NC}"
    fi
}

list_vhosts() {
    local filter_user="${1:-*}"
    local show_local_urls="${2:-$SHOW_LOCALS}"

    echo -e "${BLUE_BOLD}[*] Listing pool virtual hosts (www-data members):${NC}"
    echo -e "----------------------------------------------------------------------------------------------------------------"
    if [[ "$show_local_urls" == "true" ]]; then
        local="LOCAL URL"
    else
        local="LOCAL DIRECTORY"
    fi
    
    if [[ "$SHOW_BACKEND" == true ]]; then
        printf "%-15s %-40s %-35b %-60s\n" "USER" "DOMAIN" "STATUS" "$local"
    else
        printf "%-15s %-40s %-20b %-60s\n" "USER" "DOMAIN" "STATUS" "$local"
    fi
    
    echo -e "----------------------------------------------------------------------------------------------------------------"

    local users=()
    while IFS=: read -r name _; do
        if id -nG "$name" 2>/dev/null | grep -qw www-data; then
            users+=("$name")
        fi
    done < <(getent passwd)

    local total_users=0 total_domains=0

    for user in "${users[@]}"; do
        total_users=$((total_users + 1))
        local www_dir="/home/$user/www"
        if [[ ! -d "$www_dir" ]]; then
            echo -e "${YELLOW_BOLD}[!] ${CYAN}$user${YELLOW_BOLD}: no www directory found.${NC}"
            continue
        fi
        if [[ ! -r "$www_dir" ]]; then
            echo -e "${RED}[!] ${CYAN}$user${RED}: insufficient permissions.${NC}"
            continue
        fi

        local found=0
        for domain_dir in "$www_dir"/*; do
            [[ -d "$domain_dir" ]] || continue
            found=1
            total_domains=$((total_domains + 1))
            
            local domain lock status output
            domain=$(fs_domain "$(basename "$domain_dir")")
            lock="$domain_dir.lock"

            if [[ "$SHOW_BACKEND" == true ]]; then
                backend=$(detect_backend_type "$user" "$domain")
                backend_label=" [${backend}]"
            else
                backend_label=""
            fi

            if [[ -f "$lock" ]]; then
                status="${RED}LOCKED${NC}${backend_label}"
            else
                status="${GREEN}ACTIVE${NC}${backend_label}"
            fi

            if [[ "$show_local_urls" == "true" ]]; then
                local EFFECTIVE_PORT=$([[ $PORT == 80 || $PORT == 443 ]] && echo "" || echo ":$PORT")
                output="https://$user.$MASTER${EFFECTIVE_PORT}/$domain/"
            else
                output="$domain_dir"
            fi

            if [[ "$SHOW_BACKEND" == true ]]; then
                printf "%-15s %-40s %-35b %-60s\n" "$user" "https://$domain" "$status" "$output"
            else
                printf "%-15s %-40s %-20b %-60s\n" "$user" "https://$domain" "$status" "$output"
            fi
        done

        [[ $found -eq 0 ]] && echo -e "${GRAY}[i] ${CYAN}$user${GRAY}: no active virtual hosts.${NC}"
    done
    echo -e "-----------------------------------------------------------------------------------------------"
    echo -e "${GRAY}Summary:${NC} ${total_users} users scanned, ${total_domains} vhosts found."
}

lock_vhost() {
    local user="$1" domain="$2"
    domain="${domain#https://}"; domain="${domain#http://}"; domain="${domain%/}"
    local lock
    lock=$(vhost_lock_path "$user" "$domain")
    [[ -d $(vhost_path "$user" "$domain") ]] || { echo -e "${RED}[!] No such vhost: $user/$domain${NC}"; exit 1; }

    touch "$lock"
    echo -e "${YELLOW_BOLD}[−] Locked ${CYAN}$user/$domain${YELLOW_BOLD}.${NC}"
}

unlock_vhost() {
    local user="$1" domain="$2"
    domain="${domain#https://}"; domain="${domain#http://}"; domain="${domain%/}"
    local lock
    lock=$(vhost_lock_path "$user" "$domain")
    if [[ -f "$lock" ]]; then
        rm -f "$lock"
        echo -e "${GREEN}[✓] Unlocked ${CYAN}$user/$domain${GREEN}.${NC}"
    else
        echo -e "${YELLOW_BOLD}[i] Already unlocked.${NC}"
    fi
}

remove_vhost() {
    require_root
    local user="$1" domain="${2:-}"
    if [[ -z "$domain" ]]; then
        if id "$user" &>/dev/null; then
            if confirm "Remove user '$user' (data preserved)?"; then
                userdel "$user" 2>/dev/null || true
                echo -e "${RED}[✗] User '$user' removed.${NC} Consider deleting its home directory manually. /home/$user/"
            fi
        fi
    else
        local path
        path=$(vhost_path "$user" "$domain")
        if [[ -d "$path" ]]; then
            if confirm "Remove domain '$domain' for user '$user'?"; then
                rm -rf "$path" "$path.lock" || true
                echo -e "${GREEN}[✓] Domain ${CYAN}$domain${GREEN} deleted.${NC}"
            fi
        else
            echo -e "${RED}[!] No such domain: $user/$domain${NC}"
        fi
    fi
}

list_certs_for_user() {
    require_root
    local target_user="$1"
    [[ -z "$target_user" ]] && { echo -e "${RED}[!] Usage: nginx-pool certs <user>${NC}"; exit 1; }

    local www_dir="/home/$target_user/www"
    if [[ ! -d "$www_dir" ]]; then
        echo -e "${RED}[!] No www directory found for user ${CYAN}$target_user${NC}"; return 1
    fi

    local user_domains=()
    for _d in "$www_dir"/*/; do
        [[ -d "$_d" ]] || continue
        local fsname dom
        fsname=$(basename "$_d"); dom=$(fs_domain "$fsname")
        [[ "$dom" =~ \.lock$ ]] && continue
        user_domains+=("$dom")
    done

    if [[ ${#user_domains[@]} -eq 0 ]]; then
        echo -e "${YELLOW_BOLD}[i] No domains found for user ${CYAN}$target_user${NC}"; return 0
    fi

    echo -e "${BLUE_BOLD}[*] Domains for ${CYAN}$target_user${BLUE_BOLD}:${NC}"

    declare -A domain_to_cert=()
    declare -A cert_seen=()

    for dom in "${user_domains[@]}"; do
        local cert=""
        [[ -f /etc/nginx/ssl_cert.map ]] && \
            cert=$(awk -v d="$dom" '$1==d{gsub(/;/,"",$2); print $2; exit}' /etc/nginx/ssl_cert.map 2>/dev/null)
        if [[ -z "$cert" && -d "/etc/letsencrypt/live/$dom" ]]; then cert="$dom"; fi
        if [[ -z "$cert" ]]; then
            local parts; IFS='.' read -ra parts <<< "$dom"
            [[ ${#parts[@]} -ge 2 ]] && \
                [[ -d "/etc/letsencrypt/live/${parts[-2]}.${parts[-1]}" ]] && cert="${parts[-2]}.${parts[-1]}"
        fi
        domain_to_cert["$dom"]="${cert:-}"
        echo -e "  ${GREEN}$dom${NC} → cert: ${CYAN}${cert:-<none>}${NC}"
        [[ -n "$cert" ]] && cert_seen["$cert"]=1
    done

    [[ ${#cert_seen[@]} -eq 0 ]] && { echo -e "\n${YELLOW_BOLD}[i] No certificates found.${NC}"; return 0; }

    echo -e "\n${BLUE_BOLD}[*] Certificate details:${NC}\n"

    for cert in "${!cert_seen[@]}"; do
        echo -e "${CYAN}────────────────────────────────────────────────────────${NC}"
        echo -e "${GREEN}Certificate:${NC} ${CYAN}$cert${NC}"
        local sans=()
        while IFS= read -r _s; do sans+=("$_s"); done < <(read_cert_sans "$cert") || true
        if [[ ${#sans[@]} -gt 0 ]]; then
            echo -e "${GRAY}Domains:${NC}"
            for _s in "${sans[@]}"; do
                if [[ -n "${domain_to_cert[$_s]+x}" ]]; then
                    echo -e "  ${YELLOW_BOLD}• $_s${NC} ${GRAY}← $target_user${NC}"
                else
                    echo -e "  ${GRAY}• $_s${NC}"
                fi
            done
        fi
        local cert_pem="/etc/letsencrypt/live/$cert/cert.pem"
        if [[ -f "$cert_pem" ]]; then
            local expiry
            expiry=$(openssl x509 -noout -enddate -in "$cert_pem" 2>/dev/null | sed 's/notAfter=//')
            [[ -n "$expiry" ]] && echo -e "${GRAY}Expires:${NC} $expiry"
        fi
        echo
    done
}

# ======================================================
# REVERSE PROXY MANAGEMENT
# ======================================================

_rev_file() { echo "$REVERSE_DIR/$(fs_domain "$1")"; }
_rev_get()  { grep "^${2}=" "$1" 2>/dev/null | head -1 | cut -d= -f2-; }

_rev_cert_autodetect() {
    local domain="$1"
    [[ -d "/etc/letsencrypt/live/$domain" ]] && echo "$domain" && return
    local parts; IFS='.' read -ra parts <<< "$domain"
    if [[ ${#parts[@]} -ge 2 ]]; then
        local base="${parts[-2]}.${parts[-1]}"
        [[ -d "/etc/letsencrypt/live/$base" ]] && echo "$base" && return
    fi
    echo "${MASTER_DOMAINS[0]:-pool.glitchr.dev}"
}

reverse_add() {
    require_root
    local domain="$1" upstream="$2"
    [[ -z "$domain" || -z "$upstream" ]] && {
        echo -e "${RED}[!] Usage: nginx-pool reverse add <domain> <upstream> [--cert <c>] [--no-ssl-verify] [--index] [--no-ws] [--no-apply]${NC}"
        exit 1
    }
    mkdir -p "$REVERSE_DIR"
    local file; file=$(_rev_file "$domain")
    local cert="${REVERSE_CERT:-}"
    [[ -z "$cert" ]] && cert=$(_rev_cert_autodetect "$domain")

    # Ask for consent if entry already exists
    if [[ -f "$file" ]]; then
        local old_upstream; old_upstream=$(_rev_get "$file" backend)
        local old_cert;     old_cert=$(_rev_get "$file" cert)
        echo -e "${YELLOW_BOLD}[!] Reverse proxy for ${CYAN}${domain}${YELLOW_BOLD} already exists:${NC}"
        echo -e "    ${GRAY}Backend:  ${CYAN}${old_upstream}${NC}"
        echo -e "    ${GRAY}Cert:     ${CYAN}${old_cert}${NC}"
        confirm "Override existing entry?" || { echo -e "${GRAY}[i] Aborted.${NC}"; exit 0; }
    fi

    cat > "$file" <<EOF
domain=${domain}
backend=${upstream}
cert=${cert}
ssl_noverify=${REVERSE_NO_SSL_VERIFY}
noindex=${REVERSE_NOINDEX}
ws=${REVERSE_WS}
EOF
    echo -e "${GREEN}[✓] Reverse saved:${NC}"
    echo -e "    ${GRAY}Domain:   ${CYAN}$domain${NC}"
    echo -e "    ${GRAY}Backend:  ${CYAN}$upstream${NC}"
    echo -e "    ${GRAY}Cert:     ${CYAN}$cert${NC}"
    [[ "$REVERSE_NO_SSL_VERIFY" == "1" ]] && echo -e "    ${YELLOW_BOLD}⚠ SSL verify disabled (self-signed / internal upstream)${NC}"
    [[ "$REVERSE_NOINDEX" == "1" ]]       && echo -e "    ${GRAY}noindex:  yes${NC}"
    [[ "$REVERSE_WS" == "1" ]]            && echo -e "    ${GRAY}ws:       yes${NC}"
    reverse_apply
}

reverse_remove() {
    require_root
    local domain="$1"
    [[ -z "$domain" ]] && { echo -e "${RED}[!] Usage: nginx-pool reverse remove <domain>${NC}"; exit 1; }
    local file; file=$(_rev_file "$domain")
    if [[ -f "$file" ]]; then
        rm -f "$file"
        echo -e "${GREEN}[✓] Removed reverse for ${CYAN}$domain${NC}"
        [[ "$REVERSE_NO_APPLY" != "true" ]] && reverse_apply
    else
        echo -e "${YELLOW_BOLD}[i] No reverse entry found for ${CYAN}$domain${NC}"
    fi
}

reverse_show() {
    local domain="$1"
    [[ -z "$domain" ]] && { echo -e "${RED}[!] Usage: nginx-pool reverse show <domain>${NC}"; exit 1; }
    local file; file=$(_rev_file "$domain")
    if [[ ! -f "$file" ]]; then
        echo -e "${RED}[!] No reverse entry for ${CYAN}$domain${NC}"; exit 1
    fi
    echo -e "${BLUE_BOLD}[*] Reverse: ${CYAN}$domain${NC}"
    echo -e "------------------------------------------------------------"
    while IFS='=' read -r k v; do
        [[ -z "$k" || "$k" =~ ^# ]] && continue
        printf "  ${GRAY}%-14s${NC} ${CYAN}%s${NC}\n" "$k" "$v"
    done < "$file"
    echo -e "------------------------------------------------------------"
    local cert; cert=$(_rev_get "$file" "cert")
    if [[ -d "/etc/letsencrypt/live/$cert" ]]; then
        local expiry
        expiry=$(openssl x509 -noout -enddate -in "/etc/letsencrypt/live/$cert/cert.pem" 2>/dev/null | sed 's/notAfter=//')
        echo -e "  ${GRAY}cert status:${NC}   ${GREEN}✓ found${NC}${expiry:+  (expires: $expiry)}"
    else
        echo -e "  ${GRAY}cert status:${NC}   ${RED}✗ NOT found${NC} (/etc/letsencrypt/live/${cert})"
    fi
}

reverse_list() {
    local filter="${1:-}"
    local count=0
    local line; line=$(printf '─%.0s' {1..115})

    echo -e "${BLUE_BOLD}[*] Reverse proxy entries${filter:+ — filter: ${CYAN}${filter}${BLUE_BOLD}}:${NC}"
    printf "%-36s %-44s %-26s %s\n" "DOMAIN" "BACKEND" "CERT" "FLAGS"
    echo "$line"

    if [[ ! -d "$REVERSE_DIR" ]]; then
        echo -e "${YELLOW_BOLD}[i] No reverses yet. Use: nginx-pool rev add <domain> <backend>${NC}"
        return
    fi

    shopt -s nullglob
    local files=("$REVERSE_DIR"/*)
    shopt -u nullglob

    if [[ ${#files[@]} -eq 0 ]]; then
        echo -e "${YELLOW_BOLD}[i] No reverse entries found.${NC}"; return
    fi

    for f in "${files[@]}"; do
        [[ -f "$f" ]] || continue
        local domain upstream cert noverify noindex ws flags=""
        domain=$(_rev_get "$f" "domain"); upstream=$(_rev_get "$f" "backend")
        cert=$(_rev_get "$f" "cert");     noverify=$(_rev_get "$f" "ssl_noverify")
        noindex=$(_rev_get "$f" "noindex"); ws=$(_rev_get "$f" "ws")
        [[ -n "$filter" && "$domain" != *"$filter"* && "$cert" != *"$filter"* ]] && continue
        [[ "$noverify" == "1" ]] && flags+="noverify "
        [[ "$noindex"  == "1" ]] && flags+="noindex "
        [[ "$ws"       == "1" ]] && flags+="ws"
        local cert_mark="${RED}✗${NC}"
        [[ -d "/etc/letsencrypt/live/$cert" ]] && cert_mark="${GREEN}✓${NC}"
        printf "%-36s %-44s " "$domain" "$upstream"
        printf "%-26s " "$cert"
        echo -e "$cert_mark  ${flags% }"
        count=$((count+1))
    done

    echo "$line"
    echo -e "${GRAY}$count entr$([ "$count" -eq 1 ] && echo y || echo ies)${NC}"
}

_rev_block() {
    local domain="$1" upstream="$2" cert="$3" noverify="$4" noindex="$5" ws="$6"
    local logsafe="${domain//[^a-zA-Z0-9._-]/_}"
    local pad; pad=$(printf '─%.0s' $(seq 1 $((70 - ${#domain} < 2 ? 2 : 70 - ${#domain}))))

    local ssl_extra=""
    [[ "$upstream" == https://* && "$noverify" == "1" ]] && \
        ssl_extra=$'\n        proxy_ssl_verify       off;\n        proxy_ssl_server_name  on;'

    local noindex_hdr=""
    [[ "$noindex" == "1" ]] && \
        noindex_hdr=$'\n    add_header X-Robots-Tag "noindex, noarchive, nosnippet" always;'

    local ws_headers
    if [[ "$ws" == "1" ]]; then
        ws_headers=$'        proxy_set_header Upgrade    $http_upgrade;\n        proxy_set_header Connection $connection_upgrade;'
    else
        ws_headers=$'        proxy_set_header Connection close;'
    fi

    cat <<NGINX
# ── ${domain} ${pad}
server {
    listen 443 ssl;
    http2  on;
    server_name ${domain};
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${cert}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${cert}/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff"    always;
    add_header X-Frame-Options           "SAMEORIGIN" always;${noindex_hdr}

    client_max_body_size 256M;
    access_log /var/log/nginx/rev_${logsafe}.access.log;
    error_log  /var/log/nginx/rev_${logsafe}.error.log;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location / {
        proxy_pass ${upstream};${ssl_extra}

        proxy_set_header Host              \$host;
        proxy_set_header X-Real-IP         \$remote_addr;
        proxy_set_header X-Forwarded-For   \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port  443;

        proxy_http_version 1.1;
${ws_headers}

        proxy_connect_timeout  10s;
        proxy_send_timeout     60s;
        proxy_read_timeout    120s;
    }
}

NGINX
}

reverse_apply() {
    require_root
    mkdir -p "$REVERSE_DIR"
    echo -e "${BLUE_BOLD}[*] Rebuilding reverse proxy configuration...${NC}"

    local tmp="${REVERSE_CONF_SRC}.tmp"
    {
        echo "# ======================================================================"
        echo "# Auto-generated by: nginx-pool reverse apply"
        echo "# Manage with:       nginx-pool reverse add / remove / list"
        echo "# Source dir:        $REVERSE_DIR"
        echo "# Generated:         $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
        echo "# ======================================================================"
        echo
    } > "$tmp"

    local count=0 warn=0
    shopt -s nullglob
    local files=("$REVERSE_DIR"/*)
    shopt -u nullglob

    # Sort by domain name (= filename)
    IFS=$'\n' read -r -d '' -a files < <(printf '%s\n' "${files[@]}" | sort; printf '\0') || true

    for f in "${files[@]}"; do
        [[ -f "$f" ]] || continue
        local domain upstream cert noverify noindex ws
        domain=$(_rev_get "$f" "domain"); upstream=$(_rev_get "$f" "backend")
        cert=$(_rev_get "$f" "cert");     noverify=$(_rev_get "$f" "ssl_noverify")
        noindex=$(_rev_get "$f" "noindex"); ws=$(_rev_get "$f" "ws")

        if [[ -z "$domain" || -z "$upstream" || -z "$cert" ]]; then
            echo -e "${YELLOW_BOLD}[!] Skipping malformed entry: $(basename "$f")${NC}"
            warn=$((warn+1)); continue
        fi
        if [[ ! -d "/etc/letsencrypt/live/$cert" ]]; then
            echo -e "${YELLOW_BOLD}[!] Cert '${cert}' not found for ${domain} — block will fail TLS${NC}"
            warn=$((warn+1))
        fi
        _rev_block "$domain" "$upstream" "$cert" "$noverify" "$noindex" "$ws" >> "$tmp"
        echo -e "  ${CYAN}→ ${GREEN}${domain}${NC} → ${CYAN}${upstream}${NC}"
        count=$((count+1))
    done

    mv "$tmp" "$REVERSE_CONF_SRC"
    cp "$REVERSE_CONF_SRC" "$REVERSE_CONF_DST"

    echo
    echo -e "${BLUE_BOLD}[*] ${count} block(s) generated${warn:+, ${YELLOW_BOLD}${warn} warning(s)${BLUE_BOLD}}.${NC}"
    if nginx -t 2>&1 | grep -q "successful"; then
        nginx_reload_or_start
        echo -e "${GREEN}[✓] nginx reloaded.${NC}"
    else
        echo -e "${RED}[✗] nginx config test FAILED:${NC}"
        nginx -t 2>&1 || true
        echo -e "${YELLOW_BOLD}[i] Reverting to empty reverses.conf ...${NC}"
        echo "# nginx-pool reverse apply failed — reverted" > "$REVERSE_CONF_DST"
        nginx_reload_or_start
        exit 1
    fi
}

# ======================================================
# Dynamic DNS (ddclient / Gandi LiveDNS)
# ======================================================
#
# This pool is reached over a residential line whose WAN address is not
# guaranteed to be stable, so the A records that point at it have to be kept
# in step with it. ddclient already did that job, badly and silently: it had
# never completed a single successful update in the whole retained log history
# (every cycle returned 403, `mtime=0`, `status-ipv4=bad`) and nothing ever
# said so. The records looked healthy only because the ISP happened not to
# move the address. `nginx-pool ddns status` exists so that failure is visible
# on demand, and `ddns check` so the watchdog can notice it unattended.

DDCLIENT_CONF="/etc/ddclient/ddclient.conf"
DDCLIENT_CACHE="/var/cache/ddclient/ddclient.cache"

# Registrable zone for a domain: the last two labels.
#
# Good enough for .com/.fr/.dev/.io, which is everything this pool serves. It
# is wrong for multi-part suffixes (foo.co.uk would yield "co.uk"), so both
# `ddns add` and `ddns remove` take an optional explicit zone as a second
# argument for that case rather than pretending to know the public suffix list.
ddns_zone_for() {
    local domain="$1"
    awk -F. '{ if (NF>=2) print $(NF-1)"."$NF; else print $0 }' <<< "$domain"
}

# How this domain must be spelled on a ddclient host line.
#
# ddclient's Gandi protocol derives the LiveDNS record name by stripping the
# zone off the host name:
#
#     (my $hostname = $h) =~ s/\.\Q$config{$h}{zone}\E$//;
#
# For a subdomain that yields the label ("georges.glitchr.dev" -> "georges").
# For an apex there is no leading dot to strip, so "chapaland.com" would come
# out as "chapaland.com" and ddclient would PUT to
# /livedns/domains/chapaland.com/records/chapaland.com/A - a record name Gandi
# does not serve. Spelling the apex "@.<zone>" makes the same substitution
# yield "@", which is the name LiveDNS actually uses for it.
ddns_host_for() {
    local domain="$1" zone="$2"
    if [[ "$domain" == "$zone" ]]; then
        echo "@.$zone"
    else
        echo "$domain"
    fi
}

ddns_require_conf() {
    if [[ ! -f "$DDCLIENT_CONF" ]]; then
        echo -e "${RED}[!] $DDCLIENT_CONF not found - is ddclient installed?${NC}"
        return 1
    fi
}

# Every host line in the config, with the zone in effect for it.
# Assignments accumulate as defaults for the lines that follow, and a line of
# the form "var=value host" overrides them for that host only, so the file has
# to be walked in order rather than grepped.
ddns_entries() {
    require_root
    ddns_require_conf || return 1

    awk '
        /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
        {
            line = $0
            local_zone = ""
            host = ""
            # Leading var=value pairs, then an optional host at the end.
            n = split(line, tok, /[[:space:]]+/)
            for (i = 1; i <= n; i++) {
                if (tok[i] ~ /^zone=/)        { sub(/^zone=/, "", tok[i]); local_zone = tok[i] }
                else if (tok[i] ~ /=/)        { continue }
                else if (tok[i] != "")        { host = tok[i] }
            }
            if (local_zone != "" && host == "") { gzone = local_zone; next }
            if (host != "") {
                z = (local_zone != "" ? local_zone : gzone)
                printf "%s\t%s\n", host, z
            }
        }
    ' "$DDCLIENT_CONF"
}

ddns_list() {
    require_root
    ddns_require_conf || return 1

    echo -e "${BLUE_BOLD}[*] Dynamic DNS entries in $DDCLIENT_CONF:${NC}"
    echo
    printf "  %-26s %-20s %s\n" "HOST" "ZONE" "LIVEDNS RECORD"
    echo "  ---------------------------------------------------------------------"

    local count=0
    while IFS=$'\t' read -r host zone; do
        [[ -n "$host" ]] || continue
        local record="${host%".$zone"}"
        [[ "$record" == "$host" ]] && record="$host"
        printf "  %-26s %-20s %s\n" "$host" "$zone" "/$zone/records/$record/A"
        count=$((count + 1))
    done < <(ddns_entries)

    echo
    echo -e "  ${GRAY}$count entr$([[ $count -eq 1 ]] && echo y || echo ies)${NC}"
}

# Health of each entry, read back from ddclient's own cache.
#
# The two fields that matter are status-ipv4 and mtime. A host that has never
# been written carries mtime=0, which is exactly the state this pool sat in
# for over a year while looking fine from the outside.
ddns_status() {
    require_root
    ddns_require_conf || return 1

    echo -e "${BLUE_BOLD}[*] Dynamic DNS status:${NC}"
    echo

    if [[ ! -s "$DDCLIENT_CACHE" ]]; then
        echo -e "${YELLOW_BOLD}[!] No ddclient cache at $DDCLIENT_CACHE${NC}"
        echo -e "    ${GRAY}ddclient has not completed a cycle since the cache was last cleared.${NC}"
        return 1
    fi

    printf "  %-26s %-8s %-16s %s\n" "HOST" "STATE" "IP" "LAST UPDATE"
    echo "  -----------------------------------------------------------------------"

    local bad=0
    while IFS=$'\t' read -r host _zone; do
        [[ -n "$host" ]] || continue

        local line status ip mtime when state colour
        line=$(grep -F "host=$host," "$DDCLIENT_CACHE" 2>/dev/null | tail -1)

        if [[ -z "$line" ]]; then
            printf "  ${YELLOW_BOLD}%-26s %-8s %-16s %s${NC}\n" "$host" "UNSEEN" "-" "not in cache"
            bad=$((bad + 1))
            continue
        fi

        status=$(sed -n 's/.*status-ipv4=\([^,]*\).*/\1/p' <<< "$line")
        ip=$(sed -n 's/.*[,[:space:]]ip=\([^,]*\).*/\1/p' <<< "$line")
        mtime=$(sed -n 's/.*mtime=\([0-9]*\).*/\1/p' <<< "$line")

        if [[ "${mtime:-0}" -gt 0 ]]; then
            when=$(date -d "@$mtime" '+%Y-%m-%d %H:%M' 2>/dev/null)
        else
            when="never"
        fi

        if [[ "$status" == "good" && "${mtime:-0}" -gt 0 ]]; then
            state="OK";  colour="$GREEN"
        else
            state="FAIL"; colour="$RED"; bad=$((bad + 1))
        fi

        printf "  ${colour}%-26s %-8s %-16s %s${NC}\n" "$host" "$state" "${ip:--}" "$when"
    done < <(ddns_entries)

    echo
    if [[ $bad -gt 0 ]]; then
        echo -e "  ${RED}[✗] $bad entr$([[ $bad -eq 1 ]] && echo y || echo ies) not updating.${NC}"
        echo -e "  ${GRAY}Check: journalctl -u ddclient -n 50${NC}"
        return 1
    fi
    echo -e "  ${GREEN}[✓] All entries updating.${NC}"
}

# Quiet form for cron/watchdog: prints only when something is wrong.
ddns_check() {
    require_root
    ddns_require_conf || return 0

    [[ -s "$DDCLIENT_CACHE" ]] || { echo "ddns: no ddclient cache - no successful cycle"; return 1; }

    local bad=0
    while IFS=$'\t' read -r host _zone; do
        [[ -n "$host" ]] || continue
        local line status mtime
        line=$(grep -F "host=$host," "$DDCLIENT_CACHE" 2>/dev/null | tail -1)
        status=$(sed -n 's/.*status-ipv4=\([^,]*\).*/\1/p' <<< "$line")
        mtime=$(sed -n 's/.*mtime=\([0-9]*\).*/\1/p' <<< "$line")
        if [[ "$status" != "good" || "${mtime:-0}" -eq 0 ]]; then
            echo "ddns: $host is not updating (status=${status:-missing} mtime=${mtime:-0})"
            bad=$((bad + 1))
        fi
    done < <(ddns_entries)

    [[ $bad -eq 0 ]]
}

ddns_add() {
    require_root
    ddns_require_conf || return 1

    local domain="$1"
    local zone="${2:-$(ddns_zone_for "$domain")}"
    local host; host=$(ddns_host_for "$domain" "$zone")

    if ddns_entries | cut -f1 | grep -qx "$host"; then
        echo -e "${YELLOW_BOLD}[i] ${CYAN}$host${YELLOW_BOLD} is already configured.${NC}"
        return 0
    fi

    cp -a "$DDCLIENT_CONF" "$DDCLIENT_CONF.bak-$(date +%Y%m%d%H%M%S)"

    {
        echo
        echo "# $domain -> this host's dynamic WAN address (added by nginx-pool ddns add)"
        if [[ "$host" != "$domain" ]]; then
            echo "# Spelled @.$zone so ddclient resolves it to the apex record; see"
            echo "# ddns_host_for() in nginx-pool for why the bare apex does not work."
        fi
        echo "zone=$zone $host"
    } >> "$DDCLIENT_CONF"

    echo -e "${GREEN}[✓] Added ${CYAN}$host${GREEN} (zone $zone).${NC}"
    echo -e "${YELLOW_BOLD}[*] Restarting ddclient...${NC}"
    systemctl restart ddclient 2>/dev/null &&
        echo -e "${GREEN}[✓] ddclient restarted. Check: nginx-pool ddns status${NC}" ||
        echo -e "${RED}[!] Could not restart ddclient.${NC}"
}

ddns_remove() {
    require_root
    ddns_require_conf || return 1

    local domain="$1"
    local zone="${2:-$(ddns_zone_for "$domain")}"
    local host; host=$(ddns_host_for "$domain" "$zone")

    if ! ddns_entries | cut -f1 | grep -qx "$host"; then
        echo -e "${YELLOW_BOLD}[i] ${CYAN}$host${YELLOW_BOLD} is not configured.${NC}"
        return 0
    fi

    cp -a "$DDCLIENT_CONF" "$DDCLIENT_CONF.bak-$(date +%Y%m%d%H%M%S)"

    # Only drop the host line itself. Bare host lines inherit the settings
    # above them, so removing anything else would silently re-home the
    # entries that follow.
    sed -i "/^[[:space:]]*\(zone=[^[:space:]]*[[:space:]]\+\)\?$(sed 's/[.[\*^$]/\\&/g' <<< "$host")[[:space:]]*$/d" "$DDCLIENT_CONF"

    echo -e "${GREEN}[✓] Removed ${CYAN}$host${GREEN}.${NC}"
    systemctl restart ddclient 2>/dev/null &&
        echo -e "${GREEN}[✓] ddclient restarted.${NC}"
}

# ---------- Main ----------
cmd="${1:-}"
u="${2:-}"
d="${3:-}"
e="${4:-}"

case "$cmd" in
  add)      [[ -z "$u" || -z "$d" ]] && usage; add_vhost "$u" "$d" ;;
  lock)     [[ -z "$u" || -z "$d" ]] && usage; lock_vhost "$u" "$d" ;;
  unlock)   [[ -z "$u" || -z "$d" ]] && usage; unlock_vhost "$u" "$d" ;;
  remove|rm)[[ -z "$u" ]] && usage; remove_vhost "$u" "$d" ;;
  acl)      [[ -z "$u" ]] && usage; fix_acl "$u" "$d" ;;
  list|"")  list_vhosts "*" "$SHOW_LOCALS" ;;
  cert)
    [[ -z "$u" ]] && usage
    manage_cert_for_existing_domain "$u" "$d"
    ;;
  ssl-map)  update_ssl_map ;;
  ssl-anon) ensure_anon_cert ;;
  ddns)
    case "$u" in
      add)        [[ -z "$d" ]] && { echo -e "${RED}[!] Usage: nginx-pool ddns add <domain> [zone]${NC}"; exit 1; }
                  ddns_add "$d" "$e" ;;
      remove|rm)  [[ -z "$d" ]] && { echo -e "${RED}[!] Usage: nginx-pool ddns remove <domain> [zone]${NC}"; exit 1; }
                  ddns_remove "$d" "$e" ;;
      status)     ddns_status ;;
      check)      ddns_check ;;
      list|"")    ddns_list ;;
      *)          echo -e "${RED}[!] Unknown ddns subcommand: $u${NC}"; exit 1 ;;
    esac
    ;;
  watchdog) nginx_watchdog ;;
  certs|list-certs|show-certs)
    if [[ "$u" == "--simple" ]]; then
      list_ssl_certs
    elif [[ -n "$u" && "$u" != "--"* ]]; then
      list_certs_for_user "$u"
    else
      show_certs
    fi
    ;;
  renew|cert-renew) cert_renew ;;
  reverses) reverse_list "${u:-}" ;;
  rev|reverse)
    case "$u" in
      add)         [[ -z "$d" ]] && { echo -e "${RED}[!] Usage: nginx-pool rev add <domain> <upstream>${NC}"; exit 1; }
                   reverse_add "$d" "$e" ;;
      remove|rm)   [[ -z "$d" ]] && { echo -e "${RED}[!] Usage: nginx-pool rev remove <domain>${NC}"; exit 1; }
                   reverse_remove "$d" ;;
      show)        [[ -z "$d" ]] && { echo -e "${RED}[!] Usage: nginx-pool rev show <domain>${NC}"; exit 1; }
                   reverse_show "$d" ;;
      list|"")     reverse_list "$d" ;;
      apply)       reverse_apply ;;
      *)           echo -e "${RED}[!] Unknown reverse subcommand: $u${NC}"; exit 1 ;;
    esac
    ;;
  users) users ;;
  symlinks) update_symlinks ;;
  logs) update_logrotate ;;
  domains) update_domains ;;
  ports) update_ports_map ;;
  help|--help|-h) usage ;;
  *) echo -e "${RED}[!] Unknown command: $cmd${NC}"; usage ;;
esac
