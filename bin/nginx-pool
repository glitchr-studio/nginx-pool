#!/bin/bash
# ==========================================================
# nginx-pool : Manage users and virtual hosts for ${MASTER}|localhost
# ----------------------------------------------------------
# Usage:
#   nginx-pool add <user> <domain> [--master <domain>]
#   nginx-pool list [--local] [--backend] [--master <domain>]
#   nginx-pool extend-cert <domain>
#   nginx-pool lock <user> <domain>
#   nginx-pool unlock <user> <domain>
#   nginx-pool remove <user> [domain]
#   nginx-pool acl <user> [domain]
#   nginx-pool users
#   nginx-pool domains
#   nginx-pool symlinks [domain]
#
# Notes:
# - Each virtual host maps to:
#       /home/<user>/www/<domain>/
# - A ".lock" file prevents distribution of that host.
# - Removing the lock file re-enables the VH.
#
# Smart fallback chain in NGINX (in order):
#   (1)  <user>/<domain>.sock     ← main dynamic backend
#   (2)  <user>/<domain>/(public/|current/)?index.php or index.html
#   (3)  /home/nginx/www/localhost.sock (global PHP pool)
#   (4)  /home/nginx/www/localhost/(public/|current/)?index.php|html
#   (5)  /usr/share/nginx/html/index.html (final fallback)
# ==========================================================

set -euo pipefail
export LC_ALL=C
export LANG=C

# USER may not exist in cron
if [ -z "${USER:-}" ]; then
    USER="$(id -un 2>/dev/null || echo root)"
    export USER
fi

# ---------- Sudo context ----------
if [[ -n "${SUDO_USER:-}" ]]; then
    RUN_AS="root (via sudo by $SUDO_USER)"
    IS_SUDO=1
else
    RUN_AS="$USER"
    IS_SUDO=0
fi

# ---------- Pool Domains & Port ----------
PORT=$(awk '/listen/ && /ssl/ {for(i=1;i<=NF;i++) if ($i ~ /^[0-9]+$/) print $i}' /etc/nginx/conf.d/pool.conf)

# Default pool domain
MASTER="localhost"
SHOW_LOCALS=false
SHOW_BACKEND=false
KEEP_MISSING_PORTS=false

# ---------- Parse flags ----------
ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --master)
            MASTER="${2:-localhost}"
            shift 2
            ;;
        --local)
            SHOW_LOCALS=true
            shift
            ;;
        --backend)
            SHOW_BACKEND=true
            shift
            ;;
        --preserve ) KEEP_MISSING_PORTS=true; shift ;;
        --no-delete) KEEP_MISSING_PORTS=true; shift ;;
        --keep-missing-ports)
            KEEP_MISSING_PORTS=true
            shift
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done
set -- "${ARGS[@]:-}"

# Regex-safe version (for internal use)
IFS=',' read -r -a MASTER_DOMAINS <<< "$MASTER"
MASTER_REGEX=$(printf '%s\n' "${MASTER_DOMAINS[@]}" | sed 's/\./\\./g' | paste -sd'|' -)

# ---------- Colors ----------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
CYAN='\033[0;36m'
GRAY='\033[0;37m'
NC='\033[0m' # No Color / Reset

# ---------- Helpers ----------
usage() {
    echo -e "${YELLOW}Usage:${NC}"
    echo -e "  $0 add <user> <domain> [--master <domain>]"
    echo -e "  $0 list [--local] [--master <domain>]"
    echo -e "  $0 extend-cert <domain>"
    echo -e "  $0 show-certs"
    echo -e "  $0 cert-renew"
    echo -e "  $0 lock <user> <domain>"
    echo -e "  $0 unlock <user> <domain>"
    echo -e "  $0 remove <user> [domain]"
    echo -e "  $0 acl <user> [domain]"
    echo -e "  $0 domains"
    echo -e "  $0 symlinks"
    echo -e "  $0 users"
    echo
    echo -e "${BLUE}Examples:${NC}"
    echo -e "  $0 list --local --master pool.domain.com"
    echo -e "  $0 add alice example.com --master pool.domain.com"
    echo
    exit 1
}

require_root() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}[!] Must be run as root.${NC}"
        exit 1
    fi
}

vhost_path() { echo "/home/$1/www/$2"; }
vhost_lock_path() { echo "/home/$1/www/$2.lock"; }

confirm() {
    local msg="$1"
    read -rp "$(echo -e ${YELLOW}$msg${NC}) [y/N]: " yn
    [[ "$yn" =~ ^[Yy]$ ]]
}

create_user_if_missing() {
    local user="$1"
    if ! id "$user" &>/dev/null; then
        echo -e "${BLUE}[+] Creating system user '${CYAN}$user${BLUE}'...${NC}"
        useradd -m -s /bin/bash -G www-data "$user"
        echo -e "${GREEN}[✓] Added to group www-data.${NC}"
    else
        if ! id -nG "$user" | grep -qw www-data; then
            usermod -aG www-data "$user"
            echo -e "${GREEN}[✓] Added existing user '${CYAN}$user${GREEN}' to group www-data.${NC}"
        fi
    fi
}

fix_acl() {
    local user="$1"
    local domain="${2:-}"

    # Handle global wildcard
    if [[ "$user" == "*" ]]; then
        echo -e "${BLUE}[i] Applying ACL fix for ALL www-data users...${NC}"
        while IFS=: read -r name _; do
            if id -nG "$name" 2>/dev/null | grep -qw www-data; then
                echo -e "${CYAN}→ $name${NC}"
                fix_acl "$name" "${domain:-}"
            fi
        done < <(getent passwd)
        return
    fi

    # Handle per-user wildcard
    if [[ "$domain" == "*" ]]; then
        echo -e "${BLUE}[i] Applying ACL fix for all vhosts of ${CYAN}$user${BLUE}...${NC}"
        local www="/home/$user/www"
        if [[ -d "$www" ]]; then
            find "$www" -mindepth 1 -maxdepth 1 -type d | while read -r dir; do
                fix_acl "$user" "$(basename "$dir")"
            done
        else
            echo -e "${RED}[!] No www directory for $user${NC}"
        fi
        return
    fi

    local base="/home/$user/www"
    [[ -n "$domain" ]] && base="$base/$domain"

    [[ -d "$base" ]] || { echo -e "${RED}[!] No such vhost path: $base${NC}"; return; }

    echo -e "${BLUE}[i] Fixing ACL for ${CYAN}$base${BLUE}...${NC}"
    chmod 700 "/home/$user"
    chmod 700 "$base" 2>/dev/null || true
    chown -R "$user:www-data" "/home/$user"
    setfacl -m u:www-data:--x "/home/$user"
    setfacl -R -m u:www-data:rwx "$base"
    setfacl -R -d -m u:www-data:rwx "$base"

    echo -e "${GREEN}[✓] ACL permissions updated for ${CYAN}$user${GREEN}${domain:+/$domain}.${NC}"
}

extend_cert() {
    require_root

    local cert_name="$MASTER"
    local webroot="/var/www/letsencrypt"

    mkdir -p "$webroot"
    chown www-data:www-data "$webroot"

    local filters=("$@")
    if [[ ${#filters[@]} -eq 0 ]]; then
        echo -e "${RED}[!] Missing filter (ex: '*.apfelschorlette.fr')${NC}"
        exit 1
    fi

    # ============================================================
    # 1. Load existing SAN list for this certificate
    # ============================================================
    local san_line
    san_line=$(certbot certificates --cert-name "$cert_name" 2>/dev/null \
              | awk '/^[[:space:]]+Domains:/ {sub(/^[[:space:]]+Domains:[[:space:]]*/, "", $0); print; exit}')

    # if [[ -z "$san_line" ]]; then
    #     echo -e "${RED}[!] No existing certificate found for ${CYAN}$cert_name${RED}.${NC}"
    #     echo -e "${YELLOW}Create it first with certbot before using extend-cert.${NC}"
    #     exit 1
    # fi

    IFS=' ' read -r -a current_san <<< "$san_line"
    declare -A present=()
    for d in "${current_san[@]}"; do
        present["$d"]=1
    done

    # ============================================================
    # 2. Discover candidate domains from /home/<user>/www/<domain>
    # ============================================================
    echo -e "${BLUE}[*] Discovering candidate domains...${NC}"
    declare -A seen=()
    local candidates=()

    while IFS=: read -r user _; do
        if id -nG "$user" 2>/dev/null | grep -qw www-data; then
            local root="/home/$user/www"
            [[ -d "$root" ]] || continue

            for d in "$root"/*; do
                [[ -d "$d" ]] || continue
                local dom
                dom=$(basename "$d")

                [[ "$dom" =~ \.lock$ ]] && continue

                if [[ -z "${seen[$dom]:-}" ]]; then
                    seen["$dom"]=1
                    candidates+=("$dom")
                fi
            done
        fi
    done < <(getent passwd)

    echo -e "${CYAN}→ Found ${#candidates[@]} candidate domains.${NC}"

    # ============================================================
    # 3. Apply wildcard / literal filters
    #    "*.apfelschorlette.fr" → match any domain ending in ".apfelschorlette.fr"
    # ============================================================
    local selected=()
    local flat_filters=()

    # flatten comma-separated filters
    for f in "${filters[@]}"; do
        IFS=',' read -ra parts <<< "$f"
        for p in "${parts[@]}"; do
            [[ -n "$p" ]] && flat_filters+=("$p")
        done
    done

    for dom in "${candidates[@]}"; do
        local match=0
        for f in "${flat_filters[@]}"; do
            if [[ "$f" == \*.* ]]; then
                local base="${f#*.}"    # "*.apfelschorlette.fr" → "apfelschorlette.fr"
                [[ "$dom" == *".$base" ]] && match=1 && break
            else
                [[ "$dom" == "$f" ]] && match=1 && break
            fi
        done
        (( match == 1 )) && selected+=("$dom")
    done

    if [[ ${#selected[@]} -eq 0 ]]; then
        echo -e "${RED}[!] No domains matched the filters.${NC}"
        exit 1
    fi

    echo -e "${BLUE}[*] Selected domains (after filtering):${NC}"
    for d in "${selected[@]}"; do
        echo -e "  • ${GREEN}$d${NC}"
    done
    echo

    # ============================================================
    # 4. Merge existing SAN + selected → final SAN list
    #    (keep everything that already exists, add new)
    # ============================================================
    declare -A merged=()
    local final_san=()

    # keep existing SANs
    for d in "${current_san[@]}"; do
        if [[ -z "${merged[$d]:-}" ]]; then
            merged["$d"]=1
            final_san+=("$d")
        fi
    done

    # add selected domains (only if not already present)
    local new_domains=()
    for d in "${selected[@]}"; do
        if [[ -z "${merged[$d]:-}" ]]; then
            merged["$d"]=1
            final_san+=("$d")
            new_domains+=("$d")
        fi
    done

    if [[ ${#new_domains[@]} -eq 0 ]]; then
        echo -e "${GREEN}[✓] All matching domains are already present in certificate ${CYAN}$cert_name${GREEN}.${NC}"
        return 0
    fi

    echo -e "${BLUE}[*] New domains to be added to ${CYAN}$cert_name${BLUE}:${NC}"
    for d in "${new_domains[@]}"; do
        echo -e "  + ${GREEN}$d${NC}"
    done
    echo

    # ============================================================
    # 5. Call certbot with FULL SAN LIST (to avoid removals)
    # ============================================================
    echo -e "${BLUE}[*] Calling Certbot (--expand) with merged SAN list...${NC}"

    certbot certonly \
        --webroot -w "$webroot" \
        --expand \
        --cert-name "$cert_name" \
        $(printf ' -d %s' "${final_san[@]}")

    if [[ $? -ne 0 ]]; then
        echo -e "${RED}[✗] Certbot failed.${NC}"
        exit 1
    fi

    echo -e "${GREEN}[✓] Certificate ${CYAN}$cert_name${GREEN} extended successfully.${NC}"
    systemctl reload nginx
}

show_certs() {
    require_root

    echo -e "${BLUE}[*] Listing all certificates managed by Certbot...${NC}"
    echo

    local current_name=""
    local in_block=0

    certbot certificates 2>/dev/null | while IFS= read -r line; do

        # Detect start of a certificate block
        if [[ "$line" =~ ^Certificate\ Name:\ (.*)$ ]]; then
            current_name="${BASH_REMATCH[1]}"
            in_block=1
            echo -e "${CYAN}Certificate Name:${NC}  ${GREEN}$current_name${NC}"
            continue
        fi

        # Parse inside block
        if [[ $in_block -eq 1 ]]; then
            # Domains
            if [[ "$line" =~ ^\ \ Domains:\ (.*)$ ]]; then
                echo -e "${GRAY}Domains:${NC}        ${YELLOW}${BASH_REMATCH[1]}${NC}"
            fi

            # Expiry
            if [[ "$line" =~ ^\ \ Expiry\ Date:\ (.*)$ ]]; then
                local expiry="${BASH_REMATCH[1]}"
                echo -e "${GRAY}Expiry Date:${NC}    ${expiry}"

                # Warn about soon-expiring certs
                if [[ "$expiry" =~ "VALID" ]]; then
                    : # OK
                else
                    echo -e "               ${RED}[!] Certificate may be expired${NC}"
                fi
            fi

            # Certificate path
            if [[ "$line" =~ ^\ \ Certificate\ Path:\ (.*)$ ]]; then
                echo -e "${GRAY}Certificate:${NC}    ${BASH_REMATCH[1]}"
            fi

            # Private key path
            if [[ "$line" =~ ^\ \ Private\ Key\ Path:\ (.*)$ ]]; then
                echo -e "${GRAY}Private Key:${NC}    ${BASH_REMATCH[1]}"
                echo -e "------------------------------------------------------------"
                in_block=0
            fi
        fi

    done

    echo
    echo -e "${GREEN}[✓] Done.${NC}"
}

cert_renew() {
    require_root

    echo -e "${BLUE}[*] Forcing certificate renewal using Certbot...${NC}"
    echo

    # Run certbot renew
    local output
    output=$(certbot renew 2>&1)
    local status=$?

    echo "$output"

    # Check result
    if [[ $status -ne 0 ]]; then
        echo
        echo -e "${RED}[✗] Certbot renewal failed!${NC}"
        echo -e "${YELLOW}Check logs:${NC} /var/log/letsencrypt/letsencrypt.log"
        exit 1
    fi

    # Determine if any certificates were actually renewed
    if echo "$output" | grep -q "No renewals were attempted"; then
        echo
        echo -e "${CYAN}[i] No certificates required renewal.${NC}"
    else
        echo
        echo -e "${GREEN}[✓] Certificates successfully renewed.${NC}"
    fi

    echo -e "${BLUE}[*] Reloading nginx...${NC}"
    systemctl reload nginx

    if [[ $? -eq 0 ]]; then
        echo -e "${GREEN}[✓] NGINX reloaded successfully.${NC}"
    else
        echo -e "${RED}[✗] Failed to reload NGINX — please check configuration!${NC}"
        exit 1
    fi

    echo
    echo -e "${GREEN}[✓] Renewal process completed.${NC}"
}

add_vhost() {
    require_root
    local user="$1" domain="$2"
    local base site sock
    base=$(vhost_path "$user" "$domain")
    site="$base/public"
    sock="$base.sock"

    create_user_if_missing "$user"
    mkdir -p "$base"
    chown -R "$user:$user" "/home/$user"
    chmod 700 "/home/$user" "/home/$user/www"
    setfacl -m u:www-data:--x "/home/$user"
    setfacl -R -m u:www-data:rwx "/home/$user/www"
    setfacl -R -d -m u:www-data:rwx "/home/$user/www"

#     [[ -f "$base/index.html" ]] || cat > "$base/index.html" <<EOF
# <!DOCTYPE html>
# <html>
# <head><title>$domain</title></head>
# <body style="font-family:sans-serif;">
# <h1>Welcome to $domain</h1>
# <p>Served from <code>$site</code>.</p>
# </body>
# </html>
# EOF

    echo
    echo -e "${GREEN}[✓] Virtual host ${CYAN}$domain${GREEN} created for ${CYAN}$user${GREEN}.${NC}"
    echo -e "    ${GRAY}Base path:    ${CYAN}$base${NC}"
    echo -e "    ${GRAY}Public path:  ${CYAN}$site${NC}"
    echo -e "    ${GRAY}Socket path:  ${CYAN}$sock${NC}"
    echo -e "    ${GRAY}Lock file:    ${CYAN}${base}.lock${NC}"
    echo -e "    ${GRAY}URLs:${NC}"
    local EFFECTIVE_PORT=$([[ $PORT == 80 || $PORT == 443 ]] && echo "" || echo ":$PORT")
    echo -e "      ${BLUE}https://$user.$MASTER${EFFECTIVE_PORT}/$domain/${NC}"

    lock_vhost "$user" "$domain" > /dev/null
    fix_acl "$user" "$domain" > /dev/null
    users > /dev/null
    update_symlinks > /dev/null

    echo -e "[+] ACL permissions have been set."
    echo -e "[-] Remember to configure your DNS to point ${CYAN}$user.$MASTER${NC} to $MASTER."
    echo -e "[-] Then, obtain a certificate using certbot and/or extend-cert: \"nginx-pool extend-cert $domain\""
    echo -e "[-] Finally, unlock the vhost using: \"nginx-pool unlock $user $domain\""
    echo -e "[-] NGINX reload may be required to apply full changes: \"nginx -s reload\""
}

is_docker_mapped_before() {
    local domain="$1"

    # Match:
    #   domain 12345; #docker
    #   domain 0;     #docker
    #
    # in EITHER the http or https maps.

    if grep -qE "^${domain}[[:space:]]+[0-9]+;[[:space:]]*#docker" /etc/nginx/port_http.map 2>/dev/null; then
        return 0
    fi

    if grep -qE "^${domain}[[:space:]]+[0-9]+;[[:space:]]*#docker" /etc/nginx/port_https.map 2>/dev/null; then
        return 0
    fi

    return 1
}

update_ports_map() {

    require_root

    local map_http="/etc/nginx/port_http.map"
    local map_https="/etc/nginx/port_https.map"

    local tmp_http="${map_http}.tmp"
    local tmp_https="${map_https}.tmp"

    echo -e "${BLUE}[*] Rebuilding ${CYAN}port_http.map${BLUE} and ${CYAN}port_https.map${BLUE}…${NC}"
    # Load existing maps to know which domains were already present
    declare -A old_http_ports=()
    declare -A old_https_ports=()

    if [[ -f "$map_http" ]]; then
        while read -r dom port; do
            # skip comments and empty lines
            [[ -z "$dom" || "$dom" =~ ^# ]] && continue
            port="${port%;}"
            old_http_ports["$dom"]="$port"
        done < "$map_http"
    fi

    if [[ -f "$map_https" ]]; then
        while read -r dom port; do
            [[ -z "$dom" || "$dom" =~ ^# ]] && continue
            port="${port%;}"
            old_https_ports["$dom"]="$port"
        done < "$map_https"
    fi
    
    # Headers
    {
        echo "# Auto-generated by nginx-pool"
        echo "# Format:"
        echo "#   <domain> <port>;"
        echo
    } > "$tmp_http"

    {
        echo "# Auto-generated by nginx-pool"
        echo "# Format:"
        echo "#   <domain> <port>;"
        echo
    } > "$tmp_https"

    # Safe associative array
    declare -A seen_domains=()

    extract_port() {
        local ports="$1"
        local proto="$2"
        local port=""

        port=$(echo "$ports" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+:[0-9]+->'"$proto" \
                         | sed -E 's/.*:([0-9]+)->.*/\1/' | head -n1)

        [[ -n "$port" ]] || port=$(echo "$ports" | grep -oE '\[::\]:[0-9]+->'"$proto" \
                         | sed -E 's/.*:([0-9]+)->.*/\1/' | head -n1)

        [[ -n "$port" ]] || port=$(echo "$ports" | grep -oE "$proto"' -> [^,]+' \
                         | sed -E 's/.*:([0-9]+).*/\1/' | head -n1)

        echo "${port:-0}"
    }

    while IFS=: read -r user _; do

        id -nG "$user" 2>/dev/null | grep -qw www-data || continue
        local root="/home/$user/www"
        [[ -d "$root" ]] || continue

        for dir in "$root"/*; do
            [[ -d "$dir" ]] || continue

            local domain
            domain=$(basename "$dir")

            [[ "$domain" =~ \.lock$ ]] && continue

            if [[ ${seen_domains[$domain]+_} ]]; then continue; fi
            seen_domains[$domain]=1

            local project="${domain//./}"
            local proxy="${project}-proxy"

            local cid
            cid=$(docker ps --filter "name=^${proxy}$" --format '{{.ID}}')
            if [[ -z "$cid" ]]; then
                proxy="${project}-app"
                cid=$(docker ps --filter "name=^${proxy}$" --format '{{.ID}}')
            fi
            if [[ -z "$cid" ]]; then
                proxy="${project}"
                cid=$(docker ps --filter "name=^${proxy}$" --format '{{.ID}}')
            fi

            if [[ -z "$cid" ]]; then
                echo -e "${YELLOW}[!] Missing proxy container for ${CYAN}$domain${YELLOW} (expected: ${CYAN}${proxy}${YELLOW})${NC}"

                if is_docker_mapped_before "$domain"; then
                    if [[ "$KEEP_MISSING_PORTS" == true ]]; then
                        echo -e "${CYAN}    Preserving docker entry for ${domain} with ports=0${NC}"
                        printf "%s 0; #docker\n" "$domain" >> "$tmp_http"
                        printf "%s 0; #docker\n" "$domain" >> "$tmp_https"
                    else
                        echo -e "${YELLOW}[i] Removing docker entry for ${domain}${NC}"
                    fi
                else

                    echo -e "${BLUE}[i] ${domain} is manual — preserving existing ports${NC}"

                    # preserve HTTP
                    if [[ -n "${old_http_ports[$domain]+x}" ]]; then
                        printf "%s %s;\n" "$domain" "${old_http_ports[$domain]}" >> "$tmp_http"
                    fi

                    # preserve HTTPS
                    if [[ -n "${old_https_ports[$domain]+x}" ]]; then
                        printf "%s %s;\n" "$domain" "${old_https_ports[$domain]}" >> "$tmp_https"
                    fi
                fi

                continue

            else
    
                local ports
                ports=$(docker ps --filter "id=$cid" --format '{{.Ports}}')

                http_port=$(extract_port "$ports" "80/tcp")
                https_port=$(extract_port "$ports" "443/tcp")

                echo -e "Port mapping for ${CYAN}$domain${NC} detected: HTTP=${GREEN}${http_port}${NC}, HTTPS=${GREEN}${https_port}${NC}"
            fi

            # If docker container exists (EXTERN backend), ALWAYS write both entries.
            # Missing ports become 0.
            if [[ -n "$cid" ]]; then
                if [[ "$http_port" =~ ^[0-9]+$ && "$http_port" -gt 0 ]]; then
                    printf "%s %s; #docker\n" "$domain" "$http_port" >> "$tmp_http"
                fi
                if [[ "$https_port" =~ ^[0-9]+$ && "$https_port" -gt 0 ]]; then
                    printf "%s %s; #docker\n" "$domain" "$https_port" >> "$tmp_https"
                fi
            else
                #
                # CASE B: container does NOT exist anymore
                #
                if [[ "$KEEP_MISSING_PORTS" == true ]]; then
                    # keep placeholder zero-ports
                    printf "%s 0;\n" "$domain" >> "$tmp_http"
                    printf "%s 0;\n" "$domain" >> "$tmp_https"
                fi
            fi

        done

    done < <(getent passwd)

    # ======================================================
    #  DIFF + conditional reload (NO reload if unchanged!)
    # ======================================================
    changed=0

    if ! cmp -s "$tmp_http" "$map_http"; then
        mv "$tmp_http" "$map_http"
        changed=1
    else
        rm -f "$tmp_http"
    fi

    if ! cmp -s "$tmp_https" "$map_https"; then
        mv "$tmp_https" "$map_https"
        changed=1
    else
        rm -f "$tmp_https"
    fi

    if [[ $changed -eq 1 ]]; then
        echo -e "${GREEN}[✓] Maps updated.${NC}"
        echo -e "${YELLOW}Reloading nginx (changes detected)…${NC}"
        systemctl reload nginx
    else
        echo -e "${CYAN}[i] No changes detected — NGINX not reloaded.${NC}"
    fi
}

users() {

    require_root

    local map_file="/etc/nginx/users.map"
    local tmp_file="${map_file}.tmp"

    echo -e "${BLUE}[*] Rebuilding NGINX user → domain map...${NC}"

    # Header
    {
        echo "# Auto-generated by nginx-pool update-user-map"
        echo "# Format: domain   user;"
        echo
    } > "$tmp_file"

    local total_entries=0
    declare -A seen_domains=()

    # Scan only www-data users
    while IFS=: read -r name _; do

        if id -nG "$name" 2>/dev/null | grep -qw www-data; then

            local root="/home/$name/www"
            [[ -d "$root" ]] || continue

            for d in "$root"/*; do
                [[ -d "$d" ]] || continue

                local domain
                domain=$(basename "$d")

                # skip lock
                [[ "$domain" =~ \.lock$ ]] && continue

                # dedupe
                if [[ -n "${seen_domains[$domain]:-}" ]]; then
                    echo -e "${YELLOW}[!] Duplicate domain skipped:${NC} ${CYAN}$domain${NC}"
                    continue
                fi
                seen_domains[$domain]="$name"

                printf "%s\t%s;\n" "$domain" "$name" >> "$tmp_file"
                echo -e "${CYAN}→ ${GREEN}$domain${NC} mapped to ${BLUE}$name${NC}"

                total_entries=$((total_entries + 1))
            done
        fi

    done < <(getent passwd)

    # ---------------------------------------------------------
    #  ONLY RELOAD NGINX IF FILE CONTENT CHANGED
    # ---------------------------------------------------------

    if ! cmp -s "$tmp_file" "$map_file"; then
        # different → update file atomically + reload nginx
        mv "$tmp_file" "$map_file"

        echo
        echo -e "${GREEN}[✓] Updated: ${CYAN}$map_file${NC} (${total_entries} entries)."
        echo -e "${YELLOW}Reloading nginx…${NC}"
        systemctl reload nginx
    else
        # same → no update needed
        rm -f "$tmp_file"

        echo
        echo -e "${CYAN}[i] No changes detected — ${map_file} unchanged.${NC}"
        echo -e "${CYAN}[i] NGINX not reloaded.${NC}"
    fi
}

nginx_port_from_map() {
    local map="$1"
    local domain="$2"
    awk -v d="$domain" '
        $1 == d {
            gsub(/;/, "", $2);
            print $2;
            exit
        }
    ' "$map" 2>/dev/null
}

extern_backend_ports() {
    local domain="$1"
    local http_port https_port

    http_port=$(nginx_port_from_map "/etc/nginx/port_http.map" "$domain")
    https_port=$(nginx_port_from_map "/etc/nginx/port_https.map" "$domain")

    # ensure numeric
    [[ "$http_port" =~ ^[0-9]+$ ]] || http_port=0
    [[ "$https_port" =~ ^[0-9]+$ ]] || https_port=0

    echo "${http_port}:${https_port}"
}
is_extern_backend() {
    local domain="$1"
    local http_port https_port

    http_port=$(nginx_port_from_map "/etc/nginx/port_http.map" "$domain")
    https_port=$(nginx_port_from_map "/etc/nginx/port_https.map" "$domain")

    # Either port being non-zero means EXTERN
    if [[ "$http_port" =~ ^[0-9]+$ && "$http_port" -ne 0 ]]; then
        return 0
    fi
    if [[ "$https_port" =~ ^[0-9]+$ && "$https_port" -ne 0 ]]; then
        return 0
    fi

    return 1
}

detect_backend_type() {
    local user="$1"
    local domain="$2"
    local root="/home/$user/www/$domain"

    # 1) SOCK backend
    if [[ -S "${root}.sock" ]]; then
        echo "SOCK"
        return
    fi

    # 2) EXTERN backend → return formatted HTTP:xxx/yyy
    if is_extern_backend "$domain"; then
        local ports
        ports=$(extern_backend_ports "$domain")
        echo "MAP:${ports}"
        return
    fi

    # 3) LEGACY backend
    if [[ -f /etc/nginx/legacy.map ]] && grep -q "^${domain} " /etc/nginx/legacy.map; then
        echo "LEGACY"
        return
    fi

    # 4) Standard static / PHP
    if [[ -f "$root/public/index.php" || -f "$root/public/index.html" \
       || -f "$root/index.php"       || -f "$root/index.html" ]]; then
        echo "STANDARD"
        return
    fi

    # 5) Default nginx fallback
    echo "NGINX"
}

update_symlinks() {

    require_root

    local symlink_root="/var/www/pool"
    mkdir -p "$symlink_root"

    echo -e "${BLUE}[*] Updating symlinks under ${CYAN}$symlink_root${BLUE}...${NC}"

    declare -A valid_domains=()
    local total=0

    # -------- Scan all www-data users --------
    while IFS=: read -r name _; do
        if id -nG "$name" 2>/dev/null | grep -qw www-data; then
            
            local root="/home/$name/www"
            [[ -d "$root" ]] || continue

            for d in "$root"/*; do
                [[ -d "$d" ]] || continue

                local domain
                domain=$(basename "$d")

                [[ "$domain" =~ \.lock$ ]] && continue

                valid_domains["$domain"]="$d"

                local link="$symlink_root/$domain"

                # Stale symlink
                if [[ -L "$link" && ! -e "$link" ]]; then
                    echo -e "${GRAY}[i] Removing stale symlink: $link${NC}"
                    rm -f "$link"
                fi

                # Create if missing
                if [[ ! -L "$link" ]]; then
                    ln -s "$d" "$link"
                    echo -e "${GREEN}[+] Created symlink${NC} ${CYAN}$link → $d${NC}"
                else
                    # Fix incorrect target
                    local actual
                    actual=$(readlink -f "$link")
                    if [[ "$actual" != "$d" ]]; then
                        echo -e "${YELLOW}[i] Fixing symlink: ${CYAN}$link${NC}"
                        rm -f "$link"
                        ln -s "$d" "$link"
                    fi
                fi

                total=$((total + 1))
            done
        fi
    done < <(getent passwd)

    # -------- Remove orphans --------
    for s in "$symlink_root"/*; do
        [[ -L "$s" ]] || continue
        local domain
        domain=$(basename "$s")

        if [[ -z "${valid_domains[$domain]:-}" ]]; then
            echo -e "${YELLOW}[i] Removing orphan symlink: $s${NC}"
            rm -f "$s"
        fi
    done

    echo
    echo -e "${GREEN}[✓] Symlink update complete.${NC}"
    echo -e "    ${CYAN}$total${NC} active symlinks."
}

update_domains() {

    require_root

    local map_file="/etc/nginx/domains.conf"
    local tmp_file="${map_file}.tmp"

    echo -e "${BLUE}[*] Updating domain canonicalization map...${NC}"

    {
        echo "# Auto-generated by nginx-pool"
        echo "# Canonical domain aliases"
        echo "# Format:"
        echo "#   <alias> <canonical>;"
        echo
    } > "$tmp_file"

    declare -A valid_aliases=()
    local total=0

    # -------- Scan all www-data users --------
    while IFS=: read -r name _; do
        if id -nG "$name" 2>/dev/null | grep -qw www-data; then

            local root="/home/$name/www"
            [[ -d "$root" ]] || continue

            for d in "$root"/*; do
                [[ -d "$d" ]] || continue

                local canonical
                canonical="$(basename "$d")"

                [[ "$canonical" =~ \.lock$ ]] && continue

                # --------------------------------------------------
                # Reverse ANY domain path: a.b.c → c.b.a
                # --------------------------------------------------
                IFS='.' read -ra parts <<< "$canonical"
                local alias
                alias="$(printf "%s\n" "${parts[@]}" | tac | paste -sd'.' -)"

                # Deduplicate aliases
                [[ -n "${valid_aliases[$alias]:-}" ]] && continue
                valid_aliases["$alias"]="$canonical"

                printf "%-40s %s;\n" "$alias" "$canonical" >> "$tmp_file"
                echo -e "${CYAN}→ ${alias}${NC} → ${GREEN}${canonical}${NC}"

                total=$((total + 1))
            done
        fi
    done < <(getent passwd)

    # -------- Atomic update + conditional reload --------
    if ! cmp -s "$tmp_file" "$map_file"; then
        mv "$tmp_file" "$map_file"
        echo
        echo -e "${GREEN}[✓] Updated ${CYAN}$map_file${GREEN} (${total} aliases).${NC}"
        echo -e "${YELLOW}Reloading nginx…${NC}"
        systemctl reload nginx
    else
        rm -f "$tmp_file"
        echo
        echo -e "${CYAN}[i] No changes detected — nginx not reloaded.${NC}"
    fi
}

list_vhosts() {
    local filter_user="${1:-*}"
    local show_local_urls="${2:-$SHOW_LOCALS}"

    echo -e "${BLUE}[*] Listing pool virtual hosts (www-data members):${NC}"
    echo -e "----------------------------------------------------------------------------------------------------------------"
    if [[ "$show_local_urls" == "true" ]]; then
        local="LOCAL URL"
    else
        local="LOCAL DIRECTORY"
    fi
    
    if [[ "$SHOW_BACKEND" == true ]]; then
        printf "%-15s %-40s %-35b %-60s\n" "USER" "DOMAIN" "STATUS" "$local"
    else
        printf "%-15s %-40s %-20b %-60s\n" "USER" "DOMAIN" "STATUS" "$local"
    fi
    
    echo -e "----------------------------------------------------------------------------------------------------------------"

    local users=()
    while IFS=: read -r name _; do
        if id -nG "$name" 2>/dev/null | grep -qw www-data; then
            users+=("$name")
        fi
    done < <(getent passwd)

    local total_users=0 total_domains=0

    for user in "${users[@]}"; do
        total_users=$((total_users + 1))
        local www_dir="/home/$user/www"
        if [[ ! -d "$www_dir" ]]; then
            echo -e "${YELLOW}[!] ${CYAN}$user${YELLOW}: no www directory found.${NC}"
            continue
        fi
        if [[ ! -r "$www_dir" ]]; then
            echo -e "${RED}[!] ${CYAN}$user${RED}: insufficient permissions.${NC}"
            continue
        fi

        local found=0
        for domain_dir in "$www_dir"/*; do
            [[ -d "$domain_dir" ]] || continue
            found=1
            total_domains=$((total_domains + 1))
            local domain lock status output
            domain=$(basename "$domain_dir")
            lock="$domain_dir.lock"

            if [[ "$SHOW_BACKEND" == true ]]; then
                backend=$(detect_backend_type "$user" "$domain")
                backend_label=" [${backend}]"
            else
                backend_label=""
            fi

            if [[ -f "$lock" ]]; then
                status="${RED}LOCKED${NC}${backend_label}"
            else
                status="${GREEN}ACTIVE${NC}${backend_label}"
            fi

            if [[ "$show_local_urls" == "true" ]]; then
                local EFFECTIVE_PORT=$([[ $PORT == 80 || $PORT == 443 ]] && echo "" || echo ":$PORT")
                output="https://$user.$MASTER${EFFECTIVE_PORT}/$domain/"
            else
                output="$domain_dir"
            fi

            if [[ "$SHOW_BACKEND" == true ]]; then
                printf "%-15s %-40s %-35b %-60s\n" "$user" "https://$domain" "$status" "$output"
            else
                printf "%-15s %-40s %-20b %-60s\n" "$user" "https://$domain" "$status" "$output"
            fi
        done

        [[ $found -eq 0 ]] && echo -e "${GRAY}[i] ${CYAN}$user${GRAY}: no active virtual hosts.${NC}"
    done
    echo -e "-----------------------------------------------------------------------------------------------"
    echo -e "${GRAY}Summary:${NC} ${total_users} users scanned, ${total_domains} vhosts found."
}

lock_vhost() {
    local user="$1" domain="$2"
    local lock
    lock=$(vhost_lock_path "$user" "$domain")
    [[ -d $(vhost_path "$user" "$domain") ]] || { echo -e "${RED}[!] No such vhost: $user/$domain${NC}"; exit 1; }

    touch "$lock"
    echo -e "${YELLOW}[−] Locked ${CYAN}$user/$domain${YELLOW}.${NC}"
}

unlock_vhost() {
    local user="$1" domain="$2"
    local lock
    lock=$(vhost_lock_path "$user" "$domain")
    if [[ -f "$lock" ]]; then
        rm -f "$lock"
        echo -e "${GREEN}[✓] Unlocked ${CYAN}$user/$domain${GREEN}.${NC}"
    else
        echo -e "${YELLOW}[i] Already unlocked.${NC}"
    fi
}

remove_vhost() {
    require_root
    local user="$1" domain="${2:-}"
    if [[ -z "$domain" ]]; then
        if id "$user" &>/dev/null; then
            if confirm "Remove user '$user' (data preserved)?"; then
                userdel "$user" 2>/dev/null || true
                echo -e "${RED}[✗] User '$user' removed.${NC} Consider deleting its home directory manually. /home/$user/"
            fi
        fi
    else
        local path
        path=$(vhost_path "$user" "$domain")
        if [[ -d "$path" ]]; then
            if confirm "Remove domain '$domain' for user '$user'?"; then
                rm -rf "$path" "$path.lock" || true
                echo -e "${GREEN}[✓] Domain ${CYAN}$domain${GREEN} deleted.${NC}"
            fi
        else
            echo -e "${RED}[!] No such domain: $user/$domain${NC}"
        fi
    fi
}

# ---------- Main ----------
cmd="${1:-}"
u="${2:-}"
d="${3:-}"

case "$cmd" in
  add)      [[ -z "$u" || -z "$d" ]] && usage; add_vhost "$u" "$d" ;;
  lock)     [[ -z "$u" || -z "$d" ]] && usage; lock_vhost "$u" "$d" ;;
  unlock)   [[ -z "$u" || -z "$d" ]] && usage; unlock_vhost "$u" "$d" ;;
  remove|rm)[[ -z "$u" ]] && usage; remove_vhost "$u" "$d" ;;
  acl)      [[ -z "$u" ]] && usage; fix_acl "$u" "$d" ;;
  list|"")  list_vhosts "*" "$SHOW_LOCALS" ;;
  show-certs) show_certs ;;
  cert-renew) cert_renew ;;
  extend-cert)
    [[ -z "$u" ]] && usage
    extend_cert "$u"
    ;;
  users) users ;;
  symlinks) update_symlinks ;;
  domains) update_domains ;;
  ports) update_ports_map ;;
  help|--help|-h) usage ;;
  *) echo -e "${RED}[!] Unknown command: $cmd${NC}"; usage ;;
esac
