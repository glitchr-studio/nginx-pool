# ======================================================
# Secure Multi-User Pool Router (Smart Fallback Chain)
# ------------------------------------------------------
# Primary backend:  /home/<user>/www/<domain>.sock
# Dynamic fallback: /home/nginx/www/localhost/
# Static fallback:  /usr/share/nginx/html
# ======================================================

gzip_disable "msie6";
gzip_vary on;

# ------------------------------------------------------
# Versioned asset caching
# ------------------------------------------------------
# Webpack Encore production builds emit content-hashed filenames
# (e.g. app-async.1a2b3c4d.js). Those are immutable, so serve them with a
# far-future cache. The dot-delimited hash segment is what distinguishes a
# versioned file from an unversioned dev build (vendors-…-798fb5.js uses a
# hyphen and is intentionally NOT matched). Empty value => add_header is a no-op.
map $uri $asset_cache_control {
    default                                                            "";
    "~\.[0-9a-f]{6,}\.(?:js|css|woff2?|svg|png|webp|jpe?g|gif|ico)$"   "public, immutable, max-age=31536000";
}

# ------------------------------------------------------
# SSL Certificate mapping
# ------------------------------------------------------
# The default is the certificate presented to anyone who completes a TLS
# handshake for a name this pool does not serve: the bare IP (no SNI at all),
# a stale DNS record, a domain parked here before it was added, a scanner.
#
# It must NOT be a real tenant certificate. A Let's Encrypt cert carries every
# name in its SAN list, so serving one as the fallback hands that list to
# anyone who connects - which is how probing an unrelated domain used to
# return five glitchr.dev hostnames and link the two together. The handshake
# happens before any request, so the 418 below cannot hide it.
#
# _anon is a self-signed certificate with no real name in it, created by
# `nginx-pool ssl-anon`. An unknown host now gets a certificate warning
# carrying nothing, instead of a valid certificate carrying everything.
map $ssl_server_name $cert_name {
    include /etc/nginx/ssl_cert.map;
    default _anon;
}

# ------------------------------------------------------
# User mapping
# ------------------------------------------------------
map $host $canonical_path {
    include /etc/nginx/domain.map;
    default 0;
}
map $host $pool_user {
    include /etc/nginx/user.map;
    default "";
}
map $host $legacy_map {
    include /etc/nginx/legacy.map;
    default 0;
}

# ------------------------------------------------------
# Streaming options
# ------------------------------------------------------
map $http_range $is_range_request {
    default 0;
    "~bytes=" 1;
}

map $is_range_request $proxy_buffering_mode {
    1 off;
    0 on;
}

map "$is_range_request $has_port" $has_streaming_port {
    "1 1" 1;
    default 0;
}

# --------------------------------------------------
# Pool / localhost first-path canonicalization
# --------------------------------------------------
map $host $is_pool_host {
    default 0;
    ~*\.pool\.glitchr\.dev$ 1;
    ~*\.localhost$         1;
    localhost              1;
}

# Domains that must never be indexed, whatever they serve themselves.
map $host $is_noindex {
    include /etc/nginx/noindex.map;
    default 0;
}

map "$is_pool_host:$host" $host_user {
    default "";

    ~^1:([^.]+)\..+$ $1;
}

map "$pool_user:$host_user" $user {
    ~^([^:]+):   $1;
    ~^:([^:]+)$  $1;
    default      nginx;
}

map "$is_pool_host:$request_uri" $needs_trailing_slash {
    default 0;
    ~^1:/[^/?]+$ 1;
}

map "$is_pool_host:$request_uri" $rewritten_uri {
    default $request_uri;
    ~^1:/[^/]+(/.*)$ $1;
    ~^1:/[^/]+$      /;
}

# ------------------------------------------------------
# Port mapping (raw + numeric) + existence flags
# ------------------------------------------------------
# raw maps: distinguish "no entry" from "entry with 0"
map $host $port_http_raw  { include /etc/nginx/port_http.map;  default "__none__"; }
map $host $port_https_raw { include /etc/nginx/port_https.map; default "__none__"; }

# ------------------------------------------------------
# Keepalive upstreams for Docker-backed vhosts
# ------------------------------------------------------
# Until 2026-09-14 the Docker fallbacks below reached the container with
# `proxy_pass https://127.0.0.1:$port` — a LITERAL address in a variable.
# nginx's keepalive connection cache lives inside a named `upstream {}`
# block and cannot apply to an address like that, and the fallbacks also
# sent `Connection: close`. So every single request re-ran a full TLS
# handshake to the container. Measured on georges with ab -n 2000 -c 20 on
# a 204 that never reaches PHP:
#
#     proxy container, client keep-alive .................. 7245 req/s
#     proxy container, new connection per request ..........  448 req/s
#     THROUGH THIS POOL, client keep-alive .................  451 req/s
#     this pool -> a non-Docker static vhost ............... 5144 req/s
#
# i.e. the pool was handing every Docker site the throughput of a client
# with keep-alive switched off, and capping it at ~450 req/s no matter what
# ran behind it. The last row is the control: the pool itself is not slow.
#
# The fix keeps this file's $host-driven design intact. nginx resolves a
# variable proxy_pass target against the declared server groups FIRST and
# only falls back to the resolver when no group matches — so pointing the
# variable at an upstream NAME instead of an address gets the keepalive
# cache back with no change to the dispatch logic. Verified, same 204:
#
#     variable address (before) ............................  329 req/s
#     variable -> named upstream + keepalive 64 (after) .... 5902 req/s
#
# The blocks themselves are generated by `nginx-pool ports` from the very
# same port maps included above, in the same atomic swap, so an upstream
# cannot exist without its port entry or vice versa.
include /etc/nginx/upstreams.d/*.conf;

map $host $upstream_http  { include /etc/nginx/upstream_http.map;  default ""; }
map $host $upstream_https { include /etc/nginx/upstream_https.map; default ""; }

# numeric ports: "__none__" -> 0, others copied as-is
map $port_http_raw $port_http {
    "__none__" 0;
    default    $port_http_raw;
}
map $port_https_raw $port_https {
    "__none__" 0;
    default    $port_https_raw;
}

# does this host have an explicit entry in at least one map?
map "$port_http_raw $port_https_raw" $entry_found {
    "__none__ __none__" 0;   # no entry in either map
    default            1;    # at least one entry exists
}

# at least one non-zero port?
map "$port_http$port_https" $has_port {
    default 0;
    ~*[1-9] 1;
}

# entry is invalid extern if it exists but all ports = 0
map "$entry_found $has_port" $extern_invalid {
    "1 0" 1;       # entry present, but 0/0 → misconfigured extern
    default 0;     # everything else
}

# Is this Host: entirely unknown to the pool?
#
# This server block is the `default_server`, so it answers for every name that
# resolves here and matches no other vhost - including the bare IP, a stale DNS
# record, a domain parked here before it was added, and whatever a scanner
# invents. Those used to fall through to the dispatcher's `!-d $webroot` guard
# and come back 404, which is a lie: 404 means "this site exists, that page
# does not", so it confirms the host is served here and invites the next probe.
# 418 says only "nothing of yours is here" and is what the pool answers for a
# misconfigured extern already, so unknown hosts now join that path.
#
# A host is known if ANY of the three registries claims it, and each is checked
# against the registry itself rather than against the filesystem, because a
# vhost may legitimately have no webroot (Docker backends serve from a port):
#
#   $is_pool_host  short-path hosts (*.pool.glitchr.dev, *.localhost) - these
#                  are matched by pattern and never appear in a map file
#   $pool_user     user.map        - every vhost `nginx-pool add` provisions
#   $entry_found   port_*.map      - Docker backends such as `citest`, which
#                  are in NEITHER user.map NOR domain.map; keying this guard on
#                  user.map alone would have turned citest into a teapot
#
# domain.map is deliberately not consulted: it is a subset of user.map for
# filesystem vhosts and would add nothing but a fourth way to be wrong.
map "$is_pool_host:$pool_user:$entry_found" $is_unknown_host {
    default 0;
    "0::0"  1;     # no pattern match, no user, no port entry → not ours
}

map $host $port_http {
    default 0;
    include /etc/nginx/port_http.map;
}

map $host $port_https {
    default 0;
    include /etc/nginx/port_https.map;
}

# HTTPS flag
map $http_x_forwarded_proto $fe_https { default off; https on; }
map $http_x_forwarded_proto $fe_proto {
    default $scheme;
    http    http;
    https   https;
}

map "$fe_https $port_https" $prefer_https_port {
    ~^on\ [1-9]   $port_https;
    default       0;
}

# Same decision as $prefer_https_port, carrying the upstream name instead of
# the port. Kept as its own map rather than derived from the port so the two
# can never disagree about which leg was chosen.
map "$fe_https $port_https" $prefer_https_upstream {
    ~^on\ [1-9]   $upstream_https;
    default       "";
}

# Debug flag
map $http_x_pool_debug $pool_debug_allowed {
    "1" 1; "true" 1; "yes" 1; "on" 1;
    default 0;
}

map $pool_debug_allowed $pool_debug_user   { 1 "$user";   default ""; }
map $pool_debug_allowed $pool_debug_domain { 1 "$domain"; default ""; }
map $pool_debug_allowed $pool_debug_script { 1 "$php_script"; default ""; }
map $pool_debug_allowed $pool_debug_uri    { 1 "$rewritten_uri"; default ""; }
map $pool_debug_allowed $pool_debug_code   { 1 "$code"; default ""; }
map $pool_debug_allowed $pool_debug_socket { 1 "$socket"; default ""; }
map $pool_debug_allowed $pool_debug_legacy { 1 "$is_legacy"; default ""; }
map $pool_debug_allowed $pool_debug_http   { 1 "$port_http"; default ""; }
map $pool_debug_allowed $pool_debug_https  { 1 "$port_https"; default ""; }

# ======================================================
# Unified Dynamic Error System (418 + 402 + 40x + 50x)
# ======================================================
map $uri $forced_test_code {
    default "";
    "~^/@([1-5][1-9]{2})$" $1;
}

map $forced_test_code $effective_status {
    default $status;
    ~^[0-9]+$ $forced_test_code;
}

map $effective_status $error_emoji_final {
    # 1xx
    100 "⏳"; 101 "🔄"; 102 "⚙️"; 103 "📬";

    # 2xx
    200 "✔️"; 201 "🆕"; 202 "⌛"; 203 "ℹ️"; 204 "🚫"; 205 "🔄"; 206 "📦"; 226 "⚡";

    # 3xx
    300 "➡️"; 301 "🏠"; 302 "🔁"; 303 "🧭"; 304 "📦"; 307 "↪️"; 308 "↩️";

    # 4xx
    400 "⚠️"; 401 "🔐"; 402 "💳"; 403 "⛔"; 404 "🔍"; 405 "🚫"; 406 "⚙️"; 407 "🧱";
    408 "⌛"; 409 "⚔️"; 410 "🗑️"; 411 "📏"; 412 "❗"; 413 "📦"; 414 "🔗";
    415 "🎞️"; 416 "📏"; 417 "🤷"; 418 "🫖"; 421 "🎯"; 422 "✍️"; 423 "🔒";
    424 "🚫"; 425 "⏱️"; 426 "⬆️"; 428 "📜"; 429 "🐌"; 431 "📄"; 451 "⚖️";

    # 5xx
    500 "💥"; 501 "🛠️"; 502 "🔌"; 503 "🚧"; 504 "⏱️"; 505 "📼";
    506 "🔄"; 507 "💾"; 508 "🔁"; 510 "➕"; 511 "🌐";

    default "❓";
}

map $effective_status $error_class_final {
    ~^1 "Informational Response";
    ~^2 "Success";
    ~^3 "Redirection";
    ~^4 "Client Error";
    ~^5 "Server Error";
    default "HTTP";
}

