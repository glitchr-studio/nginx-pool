# ======================================================
# Secure Multi-User Pool Router (Smart Fallback Chain)
# ------------------------------------------------------
# Primary backend:  /home/<user>/www/<domain>.sock
# Dynamic fallback: /home/nginx/www/localhost/
# Static fallback:  /usr/share/nginx/html
# ======================================================

# ------------------------------------------------------
# User mapping
# ------------------------------------------------------
map $host $pool_user {
    include /etc/nginx/user.map;
    default "";
}

# HTTPS flag
map $http_x_forwarded_proto $fe_https { default off; https on; }

# Debug flag
map $http_x_pool_debug $pool_debug_allowed {
    "1" 1; "true" 1; "yes" 1; "on" 1;
    default 0;
}

map $pool_debug_allowed $pool_debug_user   { 1 "$user";   default ""; }
map $pool_debug_allowed $pool_debug_domain { 1 "$domain"; default ""; }
map $pool_debug_allowed $pool_debug_script { 1 "$php_script"; default ""; }
map $pool_debug_allowed $pool_debug_uri    { 1 "$uri"; default ""; }
map $pool_debug_allowed $pool_debug_code   { 1 "$code"; default ""; }

# ------------------------------------------------------
# Lock / localhost
# ------------------------------------------------------
map $host $is_localhost {
    ~*\.localhost$ 1;
    default 0;
}

map "$is_localhost$is_locked" $should_lock {
    "01" 1;          # external + locked
    default 0;
}

# ------------------------------------------------------
# Legacy/public PHP logic (LAZY)
# ------------------------------------------------------
map $uri $uri_is_php {
    default 0;
    "~*\.php$" 1;
}

map $is_legacy $legacy_flag {
    default 0;
    1       1;
}

map "$legacy_flag$uri_is_php" $php_script_override {
    "11"     "USE_URI";
    default  "";
}

map $php_script_override $php_script {
    default   /index.php;
    "USE_URI" $uri;
}

# ------------------------------------------------------
# Static file detection
# ------------------------------------------------------
map $uri $is_static {
    "~*\.php$"      0;
    "~*\.[^/]+$"    1;
    default         0;
}

# ------------------------------------------------------
# CDN Proxy Cache
# ------------------------------------------------------
proxy_cache_path /var/cache/nginx/edge levels=1:2 keys_zone=EDGE:50m inactive=1h use_temp_path=off;
proxy_cache_key "$scheme$host$request_uri";

map $request_method $skip_proxy_method { default 0; POST 1; }
map "$skip_proxy_method$http_authorization" $skip_proxy_cache { default 0; ~1 1; }

map $pool_debug_allowed $edge_cache_enable { 1 ""; default "EDGE"; }
map $pool_debug_allowed $edge_cache_bypass { 1 1; default 0; }

# ------------------------------------------------------
# FastCGI micro-cache
# ------------------------------------------------------
map $request_method $skip_cache_method { default 0; POST 1; }
map $http_authorization $skip_cache_auth { default 0; ~.+ 1; }
map $http_cookie $skip_cache_cookie { default 0; ~*(PHPSESSID|XDEBUG_SESSION|_SESSION) 1; }
map $arg_nocache $skip_cache_arg { default 0; 1 1; }

map "$skip_cache_method$skip_cache_auth$skip_cache_cookie$skip_cache_arg" $skip_fcgi_cache {
    default 0;
    ~1 1;
}

fastcgi_cache_path /var/cache/nginx/fastcgi levels=1:2 keys_zone=FCGI:64m inactive=2m max_size=2g;
fastcgi_cache_key "$scheme$request_method$host$request_uri";

map $pool_debug_allowed $fcgi_cache_enable { 1 ""; default "FCGI"; }
map $pool_debug_allowed $fcgi_cache_bypass { 1 1; default 0; }

# ------------------------------------------------------
# WebSocket helper
# ------------------------------------------------------
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

# ======================================================
# HTTP → HTTPS
# ======================================================
server {
    listen 80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}

# ======================================================
# Main HTTPS / HTTP3 server
# ======================================================
server {

    listen 443 ssl default_server;
    listen 443 quic reuseport;
    http2 on;

    server_name _;
    server_tokens off;

    # Normalize forwarded proto
    if ($http_x_forwarded_proto = "http") {
        set $http_x_forwarded_proto "https";
    }

    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;

    ssl_certificate     /etc/letsencrypt/live/pool.glitchr.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pool.glitchr.dev/privkey.pem;

    client_max_body_size 128M;
    client_header_buffer_size 32k;
    large_client_header_buffers 8 128k;

    # Security + HTTP3
    add_header Alt-Svc 'h3=":443"; ma=86400' always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Permitted-Cross-Domain-Policies "none" always;
    add_header Content-Security-Policy "upgrade-insecure-requests";

    proxy_http_version 1.1;
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    access_log /var/log/nginx/pool_access.log;
    error_log  /var/log/nginx/pool_error.log;

    # ACME
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    # robots.txt
    location = /robots.txt {
        default_type text/plain;
        if ($host ~* pool\.glitchr\.dev$) {
            return 200 "User-agent: *\nDisallow: /\n";
        }
    }

    # -------------------------------------------------
    # Resolve user/domain and filesystem roots
    # -------------------------------------------------
    set $user "";
    if ($host ~* ^([^.]+)\.pool\.glitchr\.dev$) { set $user $1; }
    if ($host ~* ^([^.]+)\.localhost$)          { set $user $1; }
    if ($pool_user != "")                       { set $user $pool_user; }
    if ($user = "")                             { set $user nginx; }

    if ($uri ~* ^/([^/]+)/?) { set $domain $1; }
    if ($user = "$pool_user") { set $domain $host; }

    set $userland /home/$user/www/$domain;
    set $lock_path $userland.lock;
    set $sock_path $userland.sock;

    set $webroot $userland;

    add_header X-Pool-User   $pool_debug_user   always;
    add_header X-Pool-Domain $pool_debug_domain always;
    add_header X-Pool-Script $pool_debug_script always;
    add_header X-Pool-Uri    $pool_debug_uri    always;
    add_header X-Pool-Code   $pool_debug_code   always;

    # ======================================================
    # NGINX DEFAULT
    # ======================================================
    error_page 589 = @nginx_default;
    location @nginx_default {

        set $code 589;
        root /usr/share/nginx/html;
        try_files $uri /index.html =404;
    }
    
    # ======================================================
    # DISPATCHER
    # ======================================================
    location ^~ / {

        set $code 0;
        if (!-d $webroot) { return 594; }

        # Lock
        set $is_locked 0;
        if (-f $lock_path) { set $is_locked 1; }
        if ($should_lock = 1) { return 403; }

        # Socket takes priority
        if (-e $sock_path) { return 590; }

        # Recompute legacy mode (runtime) — lazy maps will re-evaluate
        set $is_legacy 1;
        if (-d $webroot/current) { set $webroot $webroot/current; }
        if (-d $webroot/public)  {
            set $webroot $webroot/public;
            set $is_legacy 0;
        }

        proxy_cache        $edge_cache_enable;
        proxy_cache_bypass $edge_cache_bypass;
        proxy_no_cache     $edge_cache_bypass;

        if ($is_static = 1) { return 591; }
        if (-f $webroot$php_script) { return 592; }
        if (-f $webroot/index.html) { return 593; }

        return 404;
    }

    # ======================================================
    # SOCKET FALLBACK
    # ======================================================
    error_page 590 = @sock_fallback;
    location @sock_fallback {
        set $code 590;
        proxy_pass http://unix:$sock_path:;
    }

    # ======================================================
    # STATIC FALLBACK
    # ======================================================
    error_page 591 = @asset_resolver;
    location @asset_resolver {

        set $code 591;
        root $webroot;
        try_files $uri =404;
    }

    # ======================================================
    # PHP FALLBACK
    # ======================================================
    error_page 592 = @php_fallback;
    location @php_fallback {

        set $code 592;
        include fastcgi_params;

        fastcgi_cache         $fcgi_cache_enable;
        fastcgi_cache_bypass  $fcgi_cache_bypass;
        fastcgi_no_cache      $fcgi_cache_bypass;
        fastcgi_cache_valid   200 1s;
        fastcgi_cache_valid   301 302 10s;
        fastcgi_cache_valid   any 5s;

        fastcgi_param SCRIPT_FILENAME $webroot$php_script;
        fastcgi_param SCRIPT_NAME     $php_script;
        fastcgi_param DOCUMENT_ROOT   $webroot;

        fastcgi_pass unix:/run/php/php-fpm.sock;
    }

    # ======================================================
    # HTML FALLBACK
    # ======================================================
    error_page 593 = @html_fallback;
    location @html_fallback {
        set $code 593;
        root $webroot;
        try_files $uri /index.html @nginx_default;
    }

    # ======================================================
    # NGINX FALLBACK
    # ======================================================
    error_page 594 = @nginx_fallback;
    location @nginx_fallback {

        set $code 594;
        root /home/nginx/www/localhost;
        try_files $uri /index.html @nginx_default;
    }
}