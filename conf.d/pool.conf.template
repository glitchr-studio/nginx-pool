map $effective_status $error_message_final {

    # --- 1xx ---
    100 "The server has received your request and is currently dusting off its processing gears. Please hold while it prepares for the next exciting step of this HTTP journey.";
    101 "The server agrees to switch protocols. It is now putting on a different hat and adjusting its tie to speak the protocol you requested.";
    102 "Processing has begun — the server is juggling tasks, flipping bits, and consulting its internal librarians. Progress is happening, even if the results aren't quite ready to show off.";
    103 "Early hints are being sent. The server would like you to know it's working very hard and hopes this preview sparks joy.";

    # --- 2xx ---
    200 "Success! Everything worked perfectly. The server smiled, handed over your requested resource, and hopes you appreciate its impeccable service.";
    201 "Your resource has been created. It now exists proudly in the digital landscape, freshly constructed and ready for further adventures.";
    202 "Your request has been accepted for processing, but the results are still brewing somewhere in the background. The server promises it’s on the case.";
    203 "Non-authoritative information returned. The server retrieved the data, but it came from an outside source whose reliability may or may not involve optimism.";
    204 "Success — with absolutely nothing to return. The server completed your request silently and respectfully, like a ninja delivering results without leaving evidence.";
    205 "The server successfully processed your request and politely suggests that your user agent reset its view. A gentle tap on the refresh button of life.";
    206 "Partial content delivered. The server sent the portion you asked for and assumes you know what you're doing, even if it's downloading a file piece by piece like it's 1999.";
    207 "Multi-status response. The server is handing you a small report card summarizing a variety of outcomes — some good, some questionable, all accounted for.";
    208 "Already reported. The server already mentioned this resource, so it's not repeating itself. Efficiency is key.";
    226 "IM Used. The server applied a cool transformation and is pleased to present data that may now be slightly more optimized or magical.";

    # --- 3xx ---
    300 "Multiple choices available. The server presents you with a small buffet of possibilities and encourages you to follow your heart.";
    301 "This resource has permanently moved. The server advises updating your bookmarks, forwarding addresses, and maybe notifying relatives.";
    302 "This resource has temporarily moved. The server promises it will be back at its old place soon — probably — but for now, it’s over *there*.";
    303 "See Other. The server wants you to look at a different resource instead, like a polite librarian redirecting you to the correct bookshelf.";
    304 "Not modified. The server checked thoroughly and concluded nothing has changed since last time. Why send it again? Efficiency is beauty.";
    305 "Use Proxy. The server kindly instructs you to go through a proxy, as if it's pointing you toward a friend who ‘knows a guy’.";
    306 "Unused. This code once had purpose, ambition, and dreams — but now it has retired into legend. The server salutes it.";
    307 "Temporary redirect. The server insists you repeat the exact same method at the new location. Consistency matters.";
    308 "Permanent redirect. The server announces the move is final and encourages you to update everything accordingly, including old bookmarks buried deep in forgotten browser settings.";

    # --- 4xx ---
    400 "Your request was malformed or incomplete. It arrived like a jigsaw puzzle with half the pieces missing, the instructions written in a forgotten language, and a note saying 'good luck'. The server tried to make sense of it but eventually gave up for the sake of its own sanity.";
    401 "Authentication is required. To proceed, you must provide credentials, tokens, passwords, keycards, or possibly a magic incantation. Without proper identification, the server is reluctant to let strangers wander its corridors.";
    402 "Payment is required to access this resource. Unfortunately, the server currently accepts only rare digital artifacts such as cookies, session tokens, and possibly the tears of developers debugging production systems. Monetary payments are temporarily unavailable.";
    403 "Access to this resource is forbidden. The server has checked its rulebook, its firewall, the sacred scrolls of access control, and even consulted a wise old daemon. All agree that you shall not pass — at least not without proper authorization.";
    404 "The page you're looking for could not be found. It may have been moved, deleted, kidnapped by gremlins, replaced by a decoy, or simply never existed in this timeline. The server conducted a search party but found only tumbleweeds blowing quietly in the digital wind.";
    405 "This HTTP method is not allowed. The server stared at your request like a barista receiving an order for 'boiled ice'. It is technically possible, perhaps, but absolutely not happening here. Try a method that the server actually understands.";
    406 "The server cannot provide a response in any format you claim to accept. It attempted JSON, XML, YAML, Morse code, interpretive dance, and an offering to the machine spirits — nothing met your standards.";
    407 "Proxy authentication required. Somewhere between you and the destination stands a gatekeeper proxy who demands tribute. Until you satisfy its request, the server is unable to escort you any further.";
    408 "Your request took too long. The server waited patiently, hummed a tune, made a cup of tea, checked its logs, and eventually decided the connection was abandoned. If you return, the server promises it will try again with renewed optimism.";
    409 "A conflict occurred. Two competing realities tried to exist at once — your request and the server's current state — and the universe politely declined to merge them.";
    410 "This resource used to exist, but has now journeyed to the great digital beyond. It is gone with intention, purpose, and finality. Not archived, not hidden, not under maintenance — simply gone, like an old web page retiring to a server farm in the countryside.";
    411 "Length required. The server needs to know precisely how long your message is. Guessing is improper, impolite, and strictly against the ancient rites of HTTP.";
    412 "A precondition for this request was not met. The server checked the conditions you provided, shook its head solemnly, and decided the stars were not aligned.";
    413 "Your payload is too large. It arrived so massive that the server briefly considered starting a fitness program to handle it.";
    414 "The requested URI is too long. It trailed across the server logs like a dragon's tail, sprawling far beyond what any reasonable URL should.";
    415 "Unsupported media type. The server examined the format you sent and concluded it lacks the training, codecs, or existential fortitude to process it.";
    416 "The range you requested makes no mathematical sense. The server double-checked the numbers and confirmed that reality itself rejects them.";    417 "Expectation failed. The server received your 'Expect' header, weighed its hopes and dreams, and decided it simply could not live up to such expectations.";
    418 "This server cannot brew coffee because it is, without a shadow of a doubt, an actual teapot. RFC 2324 clearly states that any attempt to request coffee from a teapot is doomed to fail. Please respect the ancient and sacred tradition of tea-based protocols.";
    421 "This request was sent to the wrong server. It politely informs you that it is not the chosen one you seek.";
    422 "The server understood your request perfectly, but the content itself was too confusing, contradictory, or existentially disturbing to process.";
    423 "This resource is locked. The server jiggled the handle, knocked politely, and even whispered “hello?” — but the door remains firmly shut. The key may be lying beside your project’s web root. Removing it may let the server open the door again.";
    424 "A required dependency failed, and so the server cannot proceed. Like a domino missing from the chain, everything stops here.";
    425 "The server refuses to process this request early due to replay concerns. It adopts a 'better safe than sorry' policy — especially with time-traveling requests.";
    426 "Upgrade required. The server would love to help, but it demands a better, shinier, more modern protocol before it even considers cooperating.";
    428 "A required precondition was missing. The server insists you state your terms clearly before it participates in anything serious.";
    429 "Too many requests. The server noticed an enthusiastic flood of traffic coming your way. While flattered by the attention, it kindly requests you to slow down, breathe deeply, and remember that even machines enjoy a moment of peace now and then.";
    431 "Your request headers were so large and numerous that the server briefly felt overwhelmed and asked them to take a step back and reorganize.";
    451 "This resource is unavailable for legal reasons. The server is following official decrees, regulations, or ominous letters signed with unreadable government acronyms.";

    # --- 5xx ---
    500 "The server encountered an unexpected internal error. Something somewhere misbehaved, tripped, exploded, vanished, or returned a value so strange that NGINX paused to question the nature of reality. Rest assured, a tiny digital gnome has been dispatched to investigate.";
    501 "This functionality is not implemented. It might be planned for the future, or it might exist only in the dreams of ambitious developers who swear they'll finish it 'after this sprint'. For now, the server politely declines to attempt the impossible.";
    502 "Bad gateway. The upstream server returned a response that made so little sense that NGINX briefly wondered if it had contacted the right machine or accidentally reached an alternate universe. The communication has been retried and diplomatic channels are now open.";
    503 "Service temporarily unavailable. The server might be overloaded, undergoing maintenance, or has simply taken a brief nap to recover from the existential dread of handling production workloads. Please try again later once the electrons have finished reorganizing themselves.";
    504 "The gateway timed out while waiting for a response. The upstream service took longer than acceptable, possibly due to heavy processing, deep contemplation, or an unexpected coffee break. NGINX waited respectfully but eventually had to move on with its life.";
    505 "HTTP Version Not Supported. The server tried to communicate but realized the protocol you're speaking belongs either to a distant past or a speculative sci-fi future.";
    506 "Variant Also Negotiates. The server became confused while negotiating content with itself, which resulted in an infinite philosophical loop.";
    507 "Insufficient Storage. The server has run out of room for your request. It suggests decluttering old logs, memes, or temporary files.";
    508 "Loop Detected. The server found itself stuck in a recursive loop and refused to continue before losing its sanity entirely.";
    510 "Not Extended. The request requires additional extensions that the server has not yet mastered. More training modules are needed.";
    511 "Network Authentication Required. Before continuing, the server needs you to authenticate on the network itself — a cosmic handoff between layers.";

    default "An unexpected response was returned. This status does not have a dedicated message, but the server handled it with dignity and hopes everything is still functioning correctly on your side of the internet.";
}

# ------------------------------------------------------
# Lock / localhost
# ------------------------------------------------------
map $host $is_localhost {
    ~*\.localhost$ 1;
    default 0;
}

map "$is_localhost$is_locked" $should_lock {
    "01" 1;          # external + locked
    default 0;
}

# ------------------------------------------------------
# Legacy/public PHP logic (LAZY)
# ------------------------------------------------------
map $uri $uri_is_php {
    default 0;
    "~*\.php$" 1;
}

map $is_legacy $legacy_flag {
    default 0;
    1       1;
}

map "$legacy_flag$uri_is_php" $php_script_override {
    "11"     "USE_URI";
    default  "";
}

map $php_script_override $php_script {
    default   /index.php;
    "USE_URI" $uri;
}

# ------------------------------------------------------
# Static file detection
# ------------------------------------------------------
map $uri $is_static {
    # html? is in the list because a request for an existing .html file must be
    # served as a FILE. Without it $is_static was 0, the request fell through to
    # `if (-f $webroot$php_script) { return 593; }` and the app's front controller
    # answered instead - Roundcube's skins/elastic/watermark.html came back as a
    # 5382-byte index.php page rather than the 853-byte file on disk. That page
    # carries RELATIVE asset paths ("skins/elastic/ui.min.js"), which the browser
    # then resolved against /skins/elastic/, giving /skins/elastic/skins/elastic/...
    # Those 404-ish paths hit the front controller too, so every asset arrived as
    # text/html and X-Content-Type-Options: nosniff refused to execute them.
    # @asset_resolver still does `try_files $uri @php_fallback`, so a .html path
    # with no file behind it keeps falling through to PHP exactly as before.
    "~*\.(css|js|map|html?|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|eot|mp4|webm|ogg|json|txt|xml)$" 1;

    # Downloadable binaries: disk images, installers, archives, documents and the
    # media types the list above misses. Without them a request for e.g.
    # /share/<token>/app.dmg is NOT flagged static, so it skips @asset_resolver
    # entirely and only reaches the file by accident, through @html_fallback's
    # `try_files $uri` - which means it 404s outright on any pool site whose root
    # carries no index.html. @asset_resolver still ends in `try_files $uri
    # @php_fallback`, so an app-generated URL ending in one of these extensions
    # with no file behind it keeps falling through to the front controller
    # exactly as before.
    "~*\.(dmg|pkg|iso|img|exe|msi|apk|deb|rpm|zip|7z|rar|tar|gz|tgz|bz2|tbz|xz|txz|zst|pdf|epub|mp3|m4a|wav|flac|aac|mov|m4v|avi|mkv|avif|otf)$" 1;
    "~*\.php$"      0;
    default         0;
}

# ------------------------------------------------------
# CDN Proxy Cache
# ------------------------------------------------------
proxy_cache_path /var/cache/nginx/edge levels=1:2 keys_zone=EDGE:50m inactive=1h use_temp_path=off;
proxy_cache_key "$scheme$host$request_uri";

map $request_method $skip_proxy_method { default 0; POST 1; }
map "$skip_proxy_method$http_authorization" $skip_proxy_cache { default 0; ~1 1; }

map $pool_debug_allowed $edge_cache_enable { 1 ""; default "EDGE"; }
map $pool_debug_allowed $edge_cache_bypass { 1 1; default 0; }

# ------------------------------------------------------
# FastCGI micro-cache
# ------------------------------------------------------
map $request_method $skip_cache_method { default 0; POST 1; }
map $http_authorization $skip_cache_auth { default 0; ~.+ 1; }
map $http_cookie $skip_cache_cookie { default 0; ~*(PHPSESSID|XDEBUG_SESSION|_SESSION) 1; }
map $arg_nocache $skip_cache_arg { default 0; 1 1; }

map "$skip_cache_method$skip_cache_auth$skip_cache_cookie$skip_cache_arg" $skip_fcgi_cache {
    default 0;
    ~1 1;
}

fastcgi_cache_path /var/cache/nginx/fastcgi levels=1:2 keys_zone=FCGI:64m inactive=2m max_size=2g;
fastcgi_cache_key "$scheme$request_method$host$request_uri";

map $pool_debug_allowed $fcgi_cache_enable { 1 ""; default "FCGI"; }
map $pool_debug_allowed $fcgi_cache_bypass { 1 1; default 0; }

# ------------------------------------------------------
# WebSocket helper
# ------------------------------------------------------
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

# Same thing for upstreams we hold keep-alive connections to. `close` would
# defeat the connection cache on every request, and an EMPTY value makes
# nginx omit the header entirely, which is what an upstream keepalive pool
# requires. Deliberately a second variable: $connection_upgrade above is
# also used by the reverse-proxy vhosts, which have no upstream block and
# must keep their existing behaviour.
map $http_upgrade $connection_keepalive { default upgrade; '' ''; }

# ======================================================
# HTTP → HTTPS
# ======================================================
server {
    listen 80 default_server;
    server_name _;

    # Allow Let's Encrypt ACME challenges (HTTP-01)
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    # Redirect everything else to HTTPS
    location / {
        return 308 https://$http_host$request_uri;
    }
}

# ======================================================
# Main HTTPS
# ======================================================
server {

    listen 443 ssl default_server;
    http2 on;

    # Optional HTTP3, only if 443/UDP is opened and nginx compiled with http3 options.
    #listen 443 quic reuseport;
    #add_header Alt-Svc 'h3=":443"; ma=86400' always;

    server_name _;
    server_tokens off;

    # Normalize forwarded proto
    if ($http_x_forwarded_proto = "http") {
        set $http_x_forwarded_proto "https";
    }

    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;

    proxy_max_temp_file_size 0;
    # proxy_buffering off;
    # proxy_request_buffering off;

    ssl_certificate     /etc/letsencrypt/live/$cert_name/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$cert_name/privkey.pem;

    client_max_body_size 128M;
    client_header_buffer_size 32k;
    large_client_header_buffers 8 128k;

    # Security + HTTP3
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Permitted-Cross-Domain-Policies "none" always;
    add_header Content-Security-Policy "upgrade-insecure-requests";

    proxy_http_version 1.1;
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    access_log /var/log/nginx/pool_access.log;
    error_log  /var/log/nginx/pool_error.log;

    # ACME
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    # ---------------------------------------------
    # Pool canonicalization (MUST BE FIRST)
    # ---------------------------------------------
    merge_slashes on;

    if ($needs_trailing_slash) {
        return 301 $scheme://$host$request_uri/;
    }

    # robots.txt
    #
    # This is a single catch-all server block, so this exact-match location
    # answers /robots.txt for EVERY vhost on the pool. It used to carry no
    # `root`, so try_files resolved against nginx's compiled-in default and
    # handed out /etc/nginx/html/robots.txt - a blanket "Disallow: / +
    # Noindex: /" - to every site alike. Live sites were telling search
    # engines to stay away and nobody could see why, since each app ships a
    # perfectly good file of its own.
    location = /robots.txt {

        default_type text/plain;

        # Pool hosts are throwaway preview URLs; never index those.
        if ($is_pool_host = 1) {
            return 200 "User-agent: *\nDisallow: /\n";
        }

        # Explicit per-domain opt out (see /etc/nginx/noindex.map).
        if ($is_noindex = 1) {
            return 200 "User-agent: *\nDisallow: /\n";
        }

        # A site backed by a running application answers for itself, exactly
        # as it does for every other URL. Serving the host checkout instead
        # would be wrong for the Docker vhosts: their public/ is a volume, so
        # the copy on disk is whatever the last `git pull` left behind, while
        # the container serves the file the app actually generates.
        if (-e $socket)    { return 596; }
        if ($has_port = 1) { return 596; }

        # Plain-filesystem sites: Symfony-style docroots keep it under
        # public/, flat ones at the site root, capistrano-style under
        # current/. A site with none of those keeps the restrictive default
        # it has been getting all along, so nothing currently hidden becomes
        # crawlable by surprise.
        root $webroot;
        try_files /current/public/robots.txt /public/robots.txt /robots.txt @robots_default;
    }

    location @robots_default {

        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    # Its own proxy rather than @port_fallback, for one directive:
    # proxy_intercept_errors. An application that ships no robots.txt answers
    # 404, and a 404 on robots.txt means "no rules at all" - so dispatching
    # blindly would flip a site from blocked to fully crawlable the day this
    # file changed, which is exactly what the paragraph above promises not to
    # do. No tenant is in that position today - every vhost this host actually
    # serves ships a robots.txt or is covered by noindex.map - so this is a
    # guard for the next one, not a repair. proxy_intercept_errors takes no
    # variable, so it cannot be switched on inside the shared fallback for
    # this one URI; the twenty lines are duplicated deliberately.
    #
    # Only 404/403 are caught. A 5xx or a timeout must NOT quietly become
    # "Disallow: /": a crawler caches robots.txt, and an outage that answers
    # 200-and-stay-away outlives the outage by days. Those keep erroring, and
    # a crawler that cannot fetch robots.txt at all backs off on its own.
    error_page 596 = @robots_proxy;
    location @robots_proxy {

        internal;
        set $code 596;

        proxy_intercept_errors on;
        error_page 404 403 = @robots_default;

        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Ssl   on;
        proxy_set_header X-Forwarded-Port  443;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;

        proxy_http_version 1.1;
        proxy_set_header Connection $connection_keepalive;
        proxy_ssl_session_reuse on;
        proxy_redirect off;

        if (-e $socket) {
            proxy_pass http://unix:$socket:;
            break;
        }

        if ($prefer_https_port != 0) {
            proxy_pass https://$prefer_https_upstream$rewritten_uri;
            break;
        }

        if ($port_https != 0) {
            proxy_pass https://$upstream_https$rewritten_uri;
            break;
        }

        if ($port_http != 0) {
            proxy_pass http://$upstream_http$rewritten_uri;
            break;
        }

        return 404;
    }

    # direct error access
    location ^~ /@ {

        if ($uri ~ "^/@([1-5][0-9]{2})$") {
            set $forced_test_code $1;
            return 418;
        }

        return 404;
    }

    # -------------------------------------------------
    # Resolve user/domain and filesystem roots
    # -------------------------------------------------
    set $domain $canonical_path;
    if ($uri ~* ^/([^/]+)/?) { set $domain $1; }
    if ($user = "$pool_user") { set $domain $canonical_path; }
    
    set $userland /home/$user/www;

    set $webroot $userland/$domain;
    set $locker $webroot.lock;
    if ( -e $webroot.sock ) {
        set $socket $webroot.sock;
    }

    add_header X-Pool-User   $pool_debug_user   always;
    add_header X-Pool-Domain $pool_debug_domain always;
    add_header X-Pool-Script $pool_debug_script always;
    add_header X-Pool-Uri    $pool_debug_uri    always;
    add_header X-Request-Uri "$request_uri" always;

    add_header X-Pool-Code   $pool_debug_code   always;
    add_header X-Pool-Socket $pool_debug_socket always;
    add_header X-Pool-Http   $pool_debug_http always;
    add_header X-Pool-Https  $pool_debug_https always;
    add_header X-Pool-Legacy $pool_debug_legacy always;

    # ======================================================
    # DISPATCHER
    # ======================================================
    location ^~ / {

        set $code 0;

        # Unknown Host: → teapot, before the webroot guards below can turn it
        # into a 404 that confirms this machine serves the name. Must stay
        # ahead of them: an unknown host has no $webroot either, so whichever
        # test runs first decides the status.
        if ($is_unknown_host = 1) { return 418; }

        if (!-d $userland) { return 404; }
        if (!-d $webroot)  { return 404; }
        if ($domain = "")  { return 404; }
       
        # Lock
        set $is_locked 0;
        if (-f $locker) { set $is_locked 1; }
        if ($should_lock = 1) { return 423; }

        # Socket takes priority
        if (-e $socket) { return 590; }

        # Invalid extern: entry exists but both ports are zero → 418
        if ($extern_invalid = 1) { return 418; }
        if ($has_streaming_port = 1) { return 597; }
        if ($has_port = 1) { return 591; }
        
        # Recompute legacy mode (runtime) — lazy maps will re-evaluate
        set $auto_legacy 1;
        if (-d $webroot/current) { set $webroot $webroot/current; }
        if (-d $webroot/public)  {
            set $webroot $webroot/public;
            set $auto_legacy 0;
        }

        set $is_legacy $legacy_map; # Final legacy = override if legacy.map contains this domain
        if ($legacy_map = 0) { # If not overridden, fallback to auto detection
            set $is_legacy $auto_legacy;
        }

        proxy_cache        $edge_cache_enable;
        proxy_cache_bypass $edge_cache_bypass;
        proxy_no_cache     $edge_cache_bypass;

        if ($is_static = 1) { return 592; }
        if (-f $webroot$php_script) { return 593; }
        if (-f $webroot/index.html) { return 594; }

        return 595;
    }

    # ======================================================
    # SOCKET FALLBACK
    # ======================================================
    error_page 590 = @sock_fallback;
    location @sock_fallback {
        set $code 590;
        proxy_pass http://unix:$socket:;
    }

    # ======================================================
    # PORT FALLBACK
    # ======================================================
    error_page 591 = @port_fallback;
    location @port_fallback {

        internal;
        set $code 591;

        #
        # CRITICAL: FORCE Docker to think connection is HTTPS
        #
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Ssl   on;
        proxy_set_header X-Forwarded-Port  443;
        proxy_set_header Host $host;

        # Same all-or-nothing inheritance rule as the Upgrade/Connection
        # note below, and it bit the client IP too: because this location
        # declares headers of its own, the server block's X-Real-IP and
        # X-Forwarded-For were silently dropped for every Docker-backed
        # vhost. The container then saw only the docker bridge gateway, so
        # every application behind this fallback recorded ALL its visitors
        # as one address (found 2026-09-10: every userConnection row on
        # m.apfelschorlette.fr said 172.19.0.1). Anything keyed on client
        # IP - rate limits, captcha failure counters, abuse tracking,
        # per-IP analytics - was inert pool-wide until these two lines.
        proxy_set_header X-Real-IP       $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # nginx only inherits proxy_set_header directives from the parent
        # context when the current context defines none of its own - since
        # this location already sets the headers above, the server block's
        # Upgrade/Connection headers (needed for WebSocket proxying) are
        # silently dropped unless redeclared here too.
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        # $connection_keepalive, not $connection_upgrade: the targets below
        # are named upstreams with a keepalive cache, which `close` defeats.
        proxy_set_header Connection $connection_keepalive;

        # Reuse the TLS session on the rare occasion a new connection to the
        # container is needed anyway (cache cold, or the pool grew).
        proxy_ssl_session_reuse on;

        # Prevent backend loops
        proxy_redirect off;

        # Prefer HTTPS backend
        #
        # The guards still test the PORT, not the upstream name: the ports
        # are what decide 418/404 everywhere else in this file, and
        # `nginx-pool ports` emits an upstream for exactly the entries it
        # writes a non-zero port for. Testing the port therefore also proves
        # the upstream exists, and keeps one source of truth for the choice.
        if ($prefer_https_port != 0) {
            proxy_pass https://$prefer_https_upstream$rewritten_uri;
            break;
        }

        if ($port_https != 0) {
            proxy_pass https://$upstream_https$rewritten_uri;
            break;
        }

        if ($port_http != 0) {
            proxy_pass http://$upstream_http$rewritten_uri;
            break;
        }

        return 404;
    }

    error_page 598 = @php_fallback_streaming;
    location @php_fallback_streaming {

        internal;
        set $code 598;

        include fastcgi_params;

        gzip off;
        fastcgi_buffering off;
        fastcgi_request_buffering off;
        fastcgi_cache off;

        fastcgi_param SCRIPT_FILENAME $webroot$php_script;
        fastcgi_param SCRIPT_NAME     $php_script;
        fastcgi_param DOCUMENT_ROOT   $webroot;

        fastcgi_pass unix:/run/php/php-fpm.sock;
    }

    error_page 597 = @port_fallback_streaming;
    location @port_fallback_streaming {

        internal;
        set $code 597;

        proxy_http_version 1.1;

        gzip off;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;

        proxy_set_header Range    $http_range;
        proxy_set_header If-Range $http_if_range;

        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Ssl   on;
        proxy_set_header X-Forwarded-Port  443;

        # Same all-or-nothing proxy_set_header inheritance gotcha as
        # @port_fallback above - this location already redeclares its own
        # headers, so Upgrade/Connection and the client-IP pair both need to
        # be explicit here too.
        proxy_set_header X-Real-IP       $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_set_header Upgrade    $http_upgrade;
        # See @port_fallback: keepalive-safe Connection for named upstreams.
        proxy_set_header Connection $connection_keepalive;
        proxy_ssl_session_reuse on;

        proxy_redirect off;

        # Prefer HTTPS backend
        if ($prefer_https_port != 0) {
            proxy_pass https://$prefer_https_upstream;
            break;
        }

        if ($port_https != 0) {
            proxy_pass https://$upstream_https;
            break;
        }

        if ($port_http != 0) {
            proxy_pass http://$upstream_http;
            break;
        }

        return 404;
    }

    # ======================================================
    # STATIC FALLBACK
    # ======================================================
    error_page 592 = @asset_resolver;
    location @asset_resolver {

        set $code 592;
        root $webroot;

        # Far-future cache for content-hashed (versioned) assets only; the map
        # yields an empty string for unversioned files, so add_header is a no-op.
        add_header Cache-Control $asset_cache_control always;

        try_files $uri @php_fallback;
    }

    # ======================================================
    # PHP FALLBACK
    # ======================================================
    error_page 593 = @php_fallback;
    location @php_fallback {

        set $code 593;
        include fastcgi_params;

        fastcgi_cache         $fcgi_cache_enable;
        fastcgi_cache_bypass  $fcgi_cache_bypass;
        fastcgi_no_cache      $fcgi_cache_bypass;
        fastcgi_cache_valid   200 1s;
        fastcgi_cache_valid   301 302 10s;
        fastcgi_cache_valid   any 5s;

        fastcgi_param SCRIPT_FILENAME $webroot$php_script;
        fastcgi_param SCRIPT_NAME     $php_script;
        fastcgi_param DOCUMENT_ROOT   $webroot;

        fastcgi_pass unix:/run/php/php-fpm.sock;
    }

    # ======================================================
    # HTML FALLBACK
    # ======================================================
    error_page 594 = @html_fallback;
    location @html_fallback {

        set $code 594;
        root $webroot;

        # $uri/index.html must be tried BEFORE the site-root /index.html. Without
        # it a directory URL such as /share/<token>/ never matches `try_files
        # $uri` (that tests a file, and a trailing-slash path is a directory), so
        # it fell straight through to the root index.html - every subdirectory of
        # a static pool site answered with the HOME page instead of its own.
        try_files $uri $uri/index.html /index.html @nginx_default;
    }

    # ======================================================
    # NGINX FALLBACK
    # ======================================================
    error_page 595 = @nginx_fallback;
    location @nginx_fallback {

        set $code 595;
        root /home/nginx/www/localhost;

        sub_filter_once off;
        sub_filter '%%WEBROOT%%' '$webroot';
        sub_filter '%%DOMAIN%%' '$host';

        try_files $uri /index.html @nginx_default;
    }

    # ======================================================
    # NGINX DEFAULT
    # ======================================================
    location @nginx_default {

        set $code 595;
        root /usr/share/nginx/html;
        
        try_files $uri /index.html =404;
    }
    
    # ======================================================
    # Unified Dynamic Error Template Loader
    # ======================================================

    # All 30x (preserve status)
    error_page 300 =300 @error;
    error_page 301 =301 @error;
    error_page 302 =302 @error;
    error_page 303 =303 @error;
    error_page 304 =304 @error;
    error_page 307 =307 @error;
    error_page 308 =308 @error;
    
    # All 40x (preserve status)
    error_page 400 =400 @error;
    error_page 401 =401 @error;
    error_page 402 =402 @error;
    error_page 403 =403 @error;
    error_page 404 =404 @error;
    error_page 405 =405 @error;
    error_page 406 =406 @error;
    error_page 407 =407 @error;
    error_page 408 =408 @error;
    error_page 409 =409 @error;
    error_page 410 =410 @error;
    error_page 411 =411 @error;
    error_page 412 =412 @error;
    error_page 413 =413 @error;
    error_page 414 =414 @error;
    error_page 415 =415 @error;
    error_page 416 =416 @error;
    error_page 417 =417 @error;
    error_page 418 =418 @error;
    error_page 421 =421 @error;
    error_page 422 =422 @error;
    error_page 423 =423 @error;
    error_page 424 =424 @error;
    error_page 425 =425 @error;
    error_page 426 =426 @error;
    error_page 428 =428 @error;
    error_page 429 =429 @error;
    error_page 431 =431 @error;
    error_page 451 =451 @error;

    # All 50x (preserve status)
    error_page 500 =500 @error;
    error_page 501 =501 @error;
    error_page 502 =502 @error;
    error_page 503 =503 @error;
    error_page 504 =504 @error;
    error_page 505 =505 @error;
    error_page 506 =506 @error;
    error_page 507 =507 @error;
    error_page 508 =508 @error;
    error_page 510 =510 @error;
    error_page 511 =511 @error;

    location @error {

        internal;
        root /home/nginx/www/localhost;

        try_files /error.html =500;

        sub_filter_once off;
        sub_filter '%%STATUS%%'  '$effective_status';
        sub_filter '%%CLASS%%'   '$error_class_final';
        sub_filter '%%TITLE%%'   '$error_title_final';
        sub_filter '%%EMOJI%%'   '$error_emoji_final';
        sub_filter '%%MESSAGE%%' '$error_message_final';

        default_type text/html;
        add_header X-Content-Type-Options "nosniff";
        add_header Cache-Control "no-cache";
    }
}
