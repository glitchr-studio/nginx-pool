    error_page 415 =415 @error;
    error_page 416 =416 @error;
    error_page 417 =417 @error;
    error_page 418 =418 @error;
    error_page 421 =421 @error;
    error_page 422 =422 @error;
    error_page 423 =423 @error;
    error_page 424 =424 @error;
    error_page 425 =425 @error;
    error_page 426 =426 @error;
    error_page 428 =428 @error;
    error_page 429 =429 @error;
    error_page 431 =431 @error;
    error_page 451 =451 @error;

    # All 50x (preserve status)
    error_page 500 =500 @error;
    error_page 501 =501 @error;
    error_page 502 =502 @error;
    error_page 503 =503 @error;
    error_page 504 =504 @error;
    error_page 505 =505 @error;
    error_page 506 =506 @error;
    error_page 507 =507 @error;
    error_page 508 =508 @error;
    error_page 510 =510 @error;
    error_page 511 =511 @error;

    location @error {

        internal;
        root /home/nginx/www/localhost;

        try_files /error.html =500;

        sub_filter_once off;
        sub_filter '%%STATUS%%'  '$effective_status';
        sub_filter '%%CLASS%%'   '$error_class_final';
        sub_filter '%%TITLE%%'   '$error_title_final';
        sub_filter '%%EMOJI%%'   '$error_emoji_final';
        sub_filter '%%MESSAGE%%' '$error_message_final';

        default_type text/html;
        add_header X-Content-Type-Options "nosniff";
        add_header Cache-Control "no-cache";
    }
