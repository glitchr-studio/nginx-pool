# ======================================================
# Main Nginx configuration (for pool.glitchr.dev host)
# Compatible with nginx ≥1.29 (HTTP/3)
# ======================================================

user  www-data;
worker_processes auto;
pid /run/nginx.pid;
include /etc/nginx/modules-enabled/*.conf;

events {
    worker_connections 4096;
    multi_accept on;
}

http {
    ##
    # Core settings
    ##
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 4096;
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    ##
    # Logging
    ##
    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log;

    ##
    # SSL & modern protocols
    ##
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:50m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    # HTTP/3 support
    http3 on;
    quic_retry on;
    
    # ------------------------------
    # GZIP (fallback for old browsers)
    # ------------------------------
    gzip on;
    gzip_disable "msie6";
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_buffers 16 8k;
    gzip_http_version 1.1;

    gzip_types
        application/atom+xml
        application/javascript
        application/json
        application/rss+xml
        application/vnd.ms-fontobject
        application/x-font-ttf
        application/x-javascript
        application/xml
        application/xml+rss
        image/svg+xml
        text/css
        text/javascript
        text/plain
        text/xml;

    # ------------------------------
    # Brotli (superior to gzip)
    # ------------------------------
    brotli on;
    brotli_comp_level 6;
    brotli_static on;   # serve precompressed .br files if present
    brotli_window 512k; # safe for performance, large dictionary
    brotli_min_length 256;

    brotli_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/json
        application/xml
        application/rss+xml
        application/font-woff2
        image/svg+xml;
        
    ##
    # Include pool + sites
    ##
    include /etc/nginx/conf.d/*.conf;
}
